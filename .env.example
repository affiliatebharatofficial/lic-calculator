# Public Environment Variables
SITE_URL=https://lic-calculators.com
ENVIRONMENT=development

# Cloudflare D1
D1_DATABASE_ID=local-d1-id

# Security & Rate Limiting (Phase 2+)
# TURNSTILE_SECRET_KEY=
# PUBLIC_TURNSTILE_SITE_KEY=

# Server-Side AI (Phase 2+ — NEVER expose to browser)
# LLM_API_KEY=
# LLM_MODEL_NAME=gemini-1.5-pro

# Admin Authentication (set as Worker secrets — never commit real values)
# ADMIN_SESSION_SECRET=<long random string used to sign admin session cookies>
# ADMIN_EMAIL=admin@lic-calculators.com
# ADMIN_PASSWORD_HASH=<output of: node scripts/hash-password.mjs>
