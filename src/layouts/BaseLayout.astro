---
import '@/styles/global.css';
import BaseHead from '@/components/seo/BaseHead.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import AIChatDrawer from '@/components/ai/AIChatDrawer.astro';
import type { SeoMetaProps } from '@/types/seo';
import type { Locale } from '@/types/i18n';
import { DEFAULT_LOCALE, detectLocaleFromPath } from '@/lib/i18n';

interface Props extends SeoMetaProps {
  locale?: Locale;
  jsonLdType?: 'WebSite' | 'WebPage' | 'FinancialProduct' | 'SoftwareApplication' | 'FAQPage';
  faqs?: Array<{ question: string; answer: string }>;
}

const {
  title,
  description,
  canonicalUrl,
  ogType = 'website',
  ogImage,
  twitterCard,
  noIndex = false,
  publishedTime,
  modifiedTime,
  breadcrumbs,
  jsonLdType = 'WebPage',
  faqs,
  locale: explicitLocale
} = Astro.props;

const currentPath = Astro.url.pathname;
const locale = explicitLocale || detectLocaleFromPath(currentPath) || DEFAULT_LOCALE;
---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <BaseHead
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      ogType={ogType}
      ogImage={ogImage}
      twitterCard={twitterCard}
      noIndex={noIndex}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      locale={locale}
    />
    <JsonLd
      type={jsonLdType}
      title={title}
      description={description}
      url={canonicalUrl || Astro.url.toString()}
      breadcrumbs={breadcrumbs}
      faqs={faqs}
    />
  </head>
  <body class="bg-slate-50 text-slate-900 flex flex-col min-h-screen">
    <!-- Navigation Header -->
    <Header locale={locale} />

    <!-- Main Content Area -->
    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <!-- Global Footer -->
    <Footer locale={locale} />

    <!-- Global AI Policy Assistant Drawer -->
    <AIChatDrawer />
  </body>
</html>
