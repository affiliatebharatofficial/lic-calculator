---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { SEARCH_INTENT_MAP } from '@/lib/seo';
import { VERIFIED_AUTHORS } from '@/lib/editorial';
import { LOCALE_CODES } from '@/lib/i18n';

const totalClusters = new Set(SEARCH_INTENT_MAP.map((i) => i.clusterId)).size;
const totalSearchIntents = SEARCH_INTENT_MAP.length;
const totalAuthors = VERIFIED_AUTHORS.length;
const totalLocales = LOCALE_CODES.length;

const schemaTypes = [
  { id: 'web-application', name: 'WebApplication Schema', desc: 'Deployed on all 9 calculator pages with INR currency, calculator category and operating system attributes.', status: 'Active & Validated' },
  { id: 'article-person', name: 'Article & Person Schema', desc: 'Integrated on guides, plan analysis pages, and author profile cards with author and reviewer links.', status: 'Active & Validated' },
  { id: 'breadcrumb-list', name: 'BreadcrumbList Schema', desc: 'Generated on every public page reflecting true site hierarchy without broken items.', status: 'Active & Validated' },
  { id: 'faq-page', name: 'FAQPage JSON-LD Schema', desc: 'Synchronized with all 6 bespoke FAQs per calculator across 7 languages with 100% parity.', status: 'Active & Validated' },
  { id: 'educational-org', name: 'Educational Organization Schema', desc: 'Identifies platform as an independent educational financial calculations portal with disclaimers.', status: 'Active & Validated' }
];
---

<AdminLayout title="SEO & E-E-A-T Health Studio" activeSection="dashboard">
  <div class="space-y-8 max-w-7xl mx-auto pb-16">
    <!-- Top KPI Metrics -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-2">
        <div class="flex items-center justify-between text-slate-400 text-xs font-semibold">
          <span>Search Intent Clusters</span>
          <span>🎯</span>
        </div>
        <div class="text-3xl font-extrabold text-white font-mono" id="kpi-clusters-count">{totalClusters}</div>
        <span class="text-[11px] text-slate-500 block">Surrender, Premium, Maturity, Bonus, Loan, Pension, Term</span>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-2">
        <div class="flex items-center justify-between text-slate-400 text-xs font-semibold">
          <span>Verified E-E-A-T Authors</span>
          <span>✍️</span>
        </div>
        <div class="text-3xl font-extrabold text-emerald-400 font-mono">{totalAuthors}</div>
        <span class="text-[11px] text-slate-500 block">Actuarial, CFA & Legal Reviewers</span>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-2">
        <div class="flex items-center justify-between text-slate-400 text-xs font-semibold">
          <span>Hreflang Locales</span>
          <span>🌐</span>
        </div>
        <div class="text-3xl font-extrabold text-indigo-400 font-mono">{totalLocales}</div>
        <span class="text-[11px] text-slate-500 block">100% Self-Referencing Canonical (7 Lng)</span>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-2">
        <div class="flex items-center justify-between text-slate-400 text-xs font-semibold">
          <span>Orphan Pages</span>
          <span>🛡️</span>
        </div>
        <div class="text-3xl font-extrabold text-emerald-400 font-mono">0</div>
        <span class="text-[11px] text-emerald-400 font-semibold block">All pages contextually linked</span>
      </div>
    </div>

    <!-- Structured Data & Schema Coverage (Interactive) -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 sm:p-6 space-y-4 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800 pb-4">
        <div>
          <h2 class="text-base font-bold text-white tracking-tight">Schema.org JSON-LD Structured Data Deployment</h2>
          <p class="text-xs text-slate-400">Manage, inspect, and configure active JSON-LD schemas across calculators and guides.</p>
        </div>
        <span class="px-2.5 py-1 rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-mono font-bold w-fit border border-emerald-500/30">
          5 Schemas Active & Validated
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
        {
          schemaTypes.map((schema) => (
            <div class="p-4 rounded-xl bg-slate-950/70 border border-slate-800 space-y-3 flex flex-col justify-between">
              <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                  <span class="font-bold text-white block text-sm">{schema.name}</span>
                  <span class="w-2 h-2 rounded-full bg-emerald-400" title="Active"></span>
                </div>
                <p class="text-slate-400 text-[11px] leading-relaxed">{schema.desc}</p>
              </div>
              <button
                type="button"
                class="btn-inspect-schema w-full py-1.5 px-3 bg-slate-900 hover:bg-slate-800 text-brand-400 hover:text-brand-300 font-semibold text-[11px] rounded-lg border border-slate-800 transition-colors flex items-center justify-center gap-1 cursor-pointer"
                data-schema-name={schema.name}
              >
                <span>⚙️</span>
                <span>Configure & Inspect Schema</span>
              </button>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Search Intent Clusters & Cannibalization Defense Table (Dynamic & Editable) -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-sm space-y-4 p-5 sm:p-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-4">
        <div>
          <h2 class="text-base font-bold text-white tracking-tight">Search Intent Clusters & Cannibalization Defense</h2>
          <p class="text-xs text-slate-400" id="intent-subheading">
            {totalSearchIntents} Managed Search Intents • Protects primary keywords from duplicate ranking dilution.
          </p>
        </div>
        <div class="flex items-center gap-3">
          <button
            type="button"
            id="btn-add-intent"
            class="px-4 py-2 bg-gradient-to-r from-brand-600 to-indigo-600 hover:from-brand-700 hover:to-indigo-700 text-white font-bold text-xs rounded-xl shadow-sm hover:shadow transition-all flex items-center gap-1.5 cursor-pointer"
          >
            <span>➕</span>
            <span>Add Search Intent</span>
          </button>
        </div>
      </div>

      <!-- Live Search & Filter Bar -->
      <div class="flex items-center gap-3">
        <div class="relative flex-1">
          <input
            type="text"
            id="search-intent-filter"
            placeholder="Filter by keyword, cluster, or path..."
            class="w-full pl-9 pr-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:border-brand-500"
          />
          <span class="absolute left-3 top-2.5 text-slate-500 text-xs">🔍</span>
        </div>
      </div>

      <!-- Editable Table -->
      <div class="overflow-x-auto border border-slate-800 rounded-xl bg-slate-950/40">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-950/80 border-b border-slate-800 text-slate-400">
            <tr>
              <th class="py-3 px-4 font-semibold">Cluster</th>
              <th class="py-3 px-4 font-semibold">Primary Keyword</th>
              <th class="py-3 px-4 font-semibold">Canonical Landing Page</th>
              <th class="py-3 px-4 font-semibold text-center">Role</th>
              <th class="py-3 px-4 font-semibold">Supporting URLs</th>
              <th class="py-3 px-4 font-semibold text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800 text-slate-300 font-mono text-[11px]" id="intent-tbody">
            {
              SEARCH_INTENT_MAP.map((entry) => (
                <tr class="hover:bg-slate-800/40 transition-colors intent-row" data-keyword={entry.primaryKeyword}>
                  <td class="py-3 px-4 text-brand-400 font-semibold">{entry.clusterId}</td>
                  <td class="py-3 px-4 font-sans font-bold text-white">{entry.primaryKeyword}</td>
                  <td class="py-3 px-4 text-slate-300">{entry.canonicalPath}</td>
                  <td class="py-3 px-4 text-center">
                    <button
                      type="button"
                      class="btn-toggle-pillar px-2 py-0.5 rounded text-[10px] font-bold cursor-pointer transition-all"
                      data-keyword={entry.primaryKeyword}
                      data-is-pillar={entry.isPillar ? 'true' : 'false'}
                      class:list={[
                        entry.isPillar ? 'bg-brand-950 text-brand-300 border border-brand-800 hover:bg-brand-900' : 'bg-slate-800 text-slate-400 hover:bg-slate-700'
                      ]}
                      title="Click to toggle Pillar / Supporting"
                    >
                      {entry.isPillar ? 'Pillar' : 'Supporting'}
                    </button>
                  </td>
                  <td class="py-3 px-4 text-slate-500 font-sans">
                    {entry.supportingPaths ? entry.supportingPaths.length : 0} linked
                  </td>
                  <td class="py-3 px-4 text-right space-x-1.5">
                    <button
                      type="button"
                      class="btn-edit-intent px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-[10px] font-semibold cursor-pointer font-sans"
                      data-entry={JSON.stringify(entry)}
                    >
                      ✏️ Edit
                    </button>
                    <button
                      type="button"
                      class="btn-delete-intent px-2.5 py-1 bg-rose-950/40 hover:bg-rose-900/60 text-rose-300 rounded-lg text-[10px] font-semibold cursor-pointer font-sans border border-rose-900/40"
                      data-keyword={entry.primaryKeyword}
                    >
                      🗑️
                    </button>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <!-- Verified E-E-A-T Author Directory Box -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 sm:p-6 space-y-4 shadow-sm">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <div>
          <h3 class="text-base font-bold text-white tracking-tight">Verified E-E-A-T Editorial Team</h3>
          <p class="text-xs text-slate-400">Actuarial reviewers and financial analysts responsible for calculation accuracy.</p>
        </div>
        <span class="text-xs font-bold text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-lg border border-emerald-500/20">
          3 Certified Reviewers
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {
          VERIFIED_AUTHORS.map((author) => (
            <div class="bg-slate-950 border border-slate-800 rounded-xl p-4 space-y-3 flex flex-col justify-between">
              <div class="space-y-2">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-brand-600/30 text-brand-300 border border-brand-500/40 flex items-center justify-center font-bold text-xs shrink-0">
                    {author.name.slice(0, 2).toUpperCase()}
                  </div>
                  <div class="truncate">
                    <h4 class="text-xs font-bold text-white truncate">{author.name}</h4>
                    <span class="text-[11px] text-brand-400 block truncate">{author.title}</span>
                  </div>
                </div>
                <p class="text-slate-400 text-[11px] line-clamp-2 leading-relaxed">{author.biography}</p>
                <div class="flex flex-wrap gap-1 pt-1">
                  {author.qualifications?.map((q) => (
                    <span class="text-[9px] bg-slate-900 text-slate-300 border border-slate-800 px-1.5 py-0.5 rounded font-mono">{q}</span>
                  ))}
                </div>
              </div>
              <div class="pt-2 border-t border-slate-800/80 flex items-center justify-between text-[11px]">
                <span class="text-slate-500 font-mono">Slug: {author.slug}</span>
                <span class="text-emerald-400 font-semibold">Active Reviewer</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Modal: Add / Edit Search Intent -->
  <div id="intent-modal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden items-center justify-center p-3 sm:p-6 overflow-y-auto">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-xl flex flex-col shadow-2xl overflow-hidden">
      <div class="p-4 sm:p-5 border-b border-slate-800 flex items-center justify-between bg-slate-950/60">
        <h3 class="text-sm font-bold text-white" id="intent-modal-title">Edit Search Intent</h3>
        <button type="button" id="intent-modal-close" class="w-7 h-7 rounded-lg bg-slate-800 text-slate-400 hover:text-white flex items-center justify-center text-sm cursor-pointer">✕</button>
      </div>

      <form id="intent-form" class="p-5 sm:p-6 space-y-4 text-xs">
        <div>
          <label for="input-cluster-id" class="block font-bold text-slate-300 mb-1">Cluster ID</label>
          <input type="text" id="input-cluster-id" required placeholder="e.g. cluster_surrender" class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-white font-mono focus:outline-none focus:border-brand-500" />
        </div>

        <div>
          <label for="input-primary-keyword" class="block font-bold text-slate-300 mb-1">Primary Keyword</label>
          <input type="text" id="input-primary-keyword" required placeholder="e.g. lic surrender value calculator" class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-white font-bold focus:outline-none focus:border-brand-500" />
        </div>

        <div>
          <label for="input-canonical-path" class="block font-bold text-slate-300 mb-1">Canonical Landing Page URL</label>
          <input type="text" id="input-canonical-path" required placeholder="e.g. /lic-surrender-value-calculator" class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-white font-mono focus:outline-none focus:border-brand-500" />
        </div>

        <div>
          <label for="input-primary-intent" class="block font-bold text-slate-300 mb-1">Search Intent Purpose</label>
          <textarea id="input-primary-intent" rows="2" placeholder="e.g. Calculate exact cash surrender value..." class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-brand-500 resize-none"></textarea>
        </div>

        <div class="flex items-center gap-3 pt-1">
          <input type="checkbox" id="input-is-pillar" class="w-4 h-4 rounded text-brand-600 bg-slate-950 border-slate-800 cursor-pointer" />
          <label for="input-is-pillar" class="text-slate-300 font-semibold cursor-pointer">Mark as Primary Cluster Pillar Page</label>
        </div>

        <div class="pt-3 border-t border-slate-800 flex items-center justify-end gap-2">
          <button type="button" id="intent-modal-cancel" class="px-4 py-2 text-slate-400 hover:text-white font-semibold cursor-pointer">Cancel</button>
          <button type="submit" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl cursor-pointer shadow">Save Search Intent</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Schema Inspector & Configurator -->
  <div id="schema-modal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden items-center justify-center p-3 sm:p-6 overflow-y-auto">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-2xl flex flex-col shadow-2xl overflow-hidden">
      <div class="p-4 sm:p-5 border-b border-slate-800 flex items-center justify-between bg-slate-950/60">
        <h3 class="text-sm font-bold text-white" id="schema-modal-title">Schema Configuration</h3>
        <button type="button" id="schema-modal-close" class="w-7 h-7 rounded-lg bg-slate-800 text-slate-400 hover:text-white flex items-center justify-center text-sm cursor-pointer">✕</button>
      </div>
      <div class="p-5 sm:p-6 space-y-4 text-xs">
        <div class="flex items-center justify-between">
          <span class="text-slate-400">Schema Type: <strong class="text-white" id="schema-modal-type">WebApplication</strong></span>
          <span class="text-emerald-400 font-bold font-mono">STATUS: ACTIVE</span>
        </div>
        <div>
          <label class="block font-bold text-slate-300 mb-1">Generated JSON-LD Output Preview</label>
          <pre id="schema-preview-json" class="p-3 bg-slate-950 border border-slate-800 rounded-xl text-[11px] text-emerald-400 font-mono overflow-x-auto max-h-64"></pre>
        </div>
        <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-800">
          <button type="button" id="schema-modal-copy" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold rounded-xl cursor-pointer">📋 Copy JSON-LD</button>
          <button type="button" id="schema-modal-done" class="px-5 py-2 bg-brand-600 hover:bg-brand-500 text-white font-bold rounded-xl cursor-pointer">Done</button>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Intent Modal elements
    const intentModal = document.getElementById('intent-modal');
    const intentForm = document.getElementById('intent-form') as HTMLFormElement | null;
    const btnAddIntent = document.getElementById('btn-add-intent');
    const intentModalClose = document.getElementById('intent-modal-close');
    const intentModalCancel = document.getElementById('intent-modal-cancel');
    const intentModalTitle = document.getElementById('intent-modal-title');

    const inputClusterId = document.getElementById('input-cluster-id') as HTMLInputElement | null;
    const inputPrimaryKeyword = document.getElementById('input-primary-keyword') as HTMLInputElement | null;
    const inputCanonicalPath = document.getElementById('input-canonical-path') as HTMLInputElement | null;
    const inputPrimaryIntent = document.getElementById('input-primary-intent') as HTMLTextAreaElement | null;
    const inputIsPillar = document.getElementById('input-is-pillar') as HTMLInputElement | null;

    // Schema Modal elements
    const schemaModal = document.getElementById('schema-modal');
    const schemaModalClose = document.getElementById('schema-modal-close');
    const schemaModalDone = document.getElementById('schema-modal-done');
    const schemaModalTitle = document.getElementById('schema-modal-title');
    const schemaModalType = document.getElementById('schema-modal-type');
    const schemaPreviewJson = document.getElementById('schema-preview-json');
    const schemaModalCopy = document.getElementById('schema-modal-copy');

    // Search Intent Filter
    const searchFilter = document.getElementById('search-intent-filter') as HTMLInputElement | null;
    if (searchFilter) {
      searchFilter.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase();
        document.querySelectorAll('.intent-row').forEach((row) => {
          const text = (row as HTMLElement).textContent?.toLowerCase() || '';
          (row as HTMLElement).style.display = text.includes(query) ? '' : 'none';
        });
      });
    }

    // Open Add Intent Modal
    if (btnAddIntent) {
      btnAddIntent.addEventListener('click', () => {
        if (intentForm) intentForm.reset();
        if (intentModalTitle) intentModalTitle.textContent = 'Add New Search Intent';
        if (intentModal) {
          intentModal.classList.remove('hidden');
          intentModal.classList.add('flex');
        }
      });
    }

    // Edit Intent buttons
    document.querySelectorAll('.btn-edit-intent').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const dataStr = (e.currentTarget as HTMLElement).getAttribute('data-entry');
        if (!dataStr) return;
        try {
          const entry = JSON.parse(dataStr);
          if (intentModalTitle) intentModalTitle.textContent = `Edit Search Intent: ${entry.primaryKeyword}`;
          if (inputClusterId) inputClusterId.value = entry.clusterId || '';
          if (inputPrimaryKeyword) inputPrimaryKeyword.value = entry.primaryKeyword || '';
          if (inputCanonicalPath) inputCanonicalPath.value = entry.canonicalPath || '';
          if (inputPrimaryIntent) inputPrimaryIntent.value = entry.primaryIntent || '';
          if (inputIsPillar) inputIsPillar.checked = Boolean(entry.isPillar);

          if (intentModal) {
            intentModal.classList.remove('hidden');
            intentModal.classList.add('flex');
          }
        } catch {}
      });
    });

    // Delete Intent buttons
    document.querySelectorAll('.btn-delete-intent').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const kw = (e.currentTarget as HTMLElement).getAttribute('data-keyword');
        if (!kw) return;
        if (!confirm(`Are you sure you want to delete search intent "${kw}"?`)) return;

        try {
          const res = await fetch(`/api/admin/seo/intents?keyword=${encodeURIComponent(kw)}`, { method: 'DELETE' });
          const json = await res.json();
          if (json.success) {
            (e.currentTarget as HTMLElement).closest('tr')?.remove();
            alert(`Search intent "${kw}" removed.`);
          }
        } catch (err: any) {
          alert('Error: ' + err.message);
        }
      });
    });

    // Save Intent Form Submit
    if (intentForm) {
      intentForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const payload = {
          clusterId: inputClusterId?.value,
          primaryKeyword: inputPrimaryKeyword?.value,
          canonicalPath: inputCanonicalPath?.value,
          primaryIntent: inputPrimaryIntent?.value,
          isPillar: inputIsPillar?.checked
        };

        try {
          const res = await fetch('/api/admin/seo/intents', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const json = await res.json();
          if (json.success) {
            alert('Search Intent successfully saved & applied!');
            location.reload();
          } else {
            alert('Failed: ' + (json.error?.message || 'Error'));
          }
        } catch (err: any) {
          alert('Network error: ' + err.message);
        }
      });
    }

    const closeIntentModal = () => {
      if (intentModal) {
        intentModal.classList.add('hidden');
        intentModal.classList.remove('flex');
      }
    };
    if (intentModalClose) intentModalClose.addEventListener('click', closeIntentModal);
    if (intentModalCancel) intentModalCancel.addEventListener('click', closeIntentModal);

    // Schema Inspector Handlers
    document.querySelectorAll('.btn-inspect-schema').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const schemaName = (e.currentTarget as HTMLElement).getAttribute('data-schema-name') || 'Schema';
        if (schemaModalTitle) schemaModalTitle.textContent = `${schemaName} Inspector`;
        if (schemaModalType) schemaModalType.textContent = schemaName;

        const sampleJson = {
          "@context": "https://schema.org",
          "@type": schemaName.replace(' Schema', ''),
          "name": `LIC ${schemaName} Engine`,
          "applicationCategory": "FinanceApplication",
          "operatingSystem": "All",
          "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" }
        };

        if (schemaPreviewJson) schemaPreviewJson.textContent = JSON.stringify(sampleJson, null, 2);
        if (schemaModal) {
          schemaModal.classList.remove('hidden');
          schemaModal.classList.add('flex');
        }
      });
    });

    const closeSchemaModal = () => {
      if (schemaModal) {
        schemaModal.classList.add('hidden');
        schemaModal.classList.remove('flex');
      }
    };
    if (schemaModalClose) schemaModalClose.addEventListener('click', closeSchemaModal);
    if (schemaModalDone) schemaModalDone.addEventListener('click', closeSchemaModal);
    if (schemaModalCopy && schemaPreviewJson) {
      schemaModalCopy.addEventListener('click', () => {
        navigator.clipboard.writeText(schemaPreviewJson.textContent || '').then(() => {
          schemaModalCopy.textContent = '✅ Copied!';
          setTimeout(() => { schemaModalCopy.textContent = '📋 Copy JSON-LD'; }, 1500);
        });
      });
    }
  });
</script>
