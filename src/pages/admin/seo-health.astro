---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { SEARCH_INTENT_MAP } from '@/lib/seo';
import { VERIFIED_AUTHORS } from '@/lib/editorial';
import { LOCALE_CODES } from '@/lib/i18n';

const totalClusters = 5;
const totalSearchIntents = SEARCH_INTENT_MAP.length;
const totalAuthors = VERIFIED_AUTHORS.length;
const totalLocales = LOCALE_CODES.length;
---

<AdminLayout title="SEO & E-E-A-T Health Dashboard" activeSection="dashboard">
  <div class="space-y-8 max-w-7xl mx-auto">
    <!-- Top KPI Metrics -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-2">
        <div class="flex items-center justify-between text-slate-400 text-xs font-semibold">
          <span>Search Intent Clusters</span>
          <span>🎯</span>
        </div>
        <div class="text-3xl font-extrabold text-white font-mono">{totalClusters}</div>
        <span class="text-[11px] text-slate-500 block">Surrender, Premium, Maturity, Bonus, Loan</span>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-2">
        <div class="flex items-center justify-between text-slate-400 text-xs font-semibold">
          <span>Verified E-E-A-T Authors</span>
          <span>✍️</span>
        </div>
        <div class="text-3xl font-extrabold text-emerald-400 font-mono">{totalAuthors}</div>
        <span class="text-[11px] text-slate-500 block">Actuarial, CFA & Legal Reviewers</span>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-2">
        <div class="flex items-center justify-between text-slate-400 text-xs font-semibold">
          <span>Hreflang Locales</span>
          <span>🌐</span>
        </div>
        <div class="text-3xl font-extrabold text-indigo-400 font-mono">{totalLocales}</div>
        <span class="text-[11px] text-slate-500 block">100% Self-Referencing Canonical</span>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-2">
        <div class="flex items-center justify-between text-slate-400 text-xs font-semibold">
          <span>Orphan Pages</span>
          <span>🛡️</span>
        </div>
        <div class="text-3xl font-extrabold text-emerald-400 font-mono">0</div>
        <span class="text-[11px] text-emerald-400 font-semibold block">All pages contextually linked</span>
      </div>
    </div>

    <!-- Structured Data & Schema Coverage -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-base font-bold text-white">Schema.org JSON-LD Structured Data Deployment</h2>
        <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-mono font-bold">
          Active & Validated
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
        <div class="p-4 rounded-xl bg-slate-950/60 border border-slate-800 space-y-1.5">
          <span class="font-bold text-white block">WebApplication Schema</span>
          <p class="text-slate-400">Deployed on all 6 major calculators with INR currency and operating system attributes.</p>
        </div>
        <div class="p-4 rounded-xl bg-slate-950/60 border border-slate-800 space-y-1.5">
          <span class="font-bold text-white block">Article & Person Schema</span>
          <p class="text-slate-400">Integrated on guides, plan pages, and author profile cards with author and reviewer links.</p>
        </div>
        <div class="p-4 rounded-xl bg-slate-950/60 border border-slate-800 space-y-1.5">
          <span class="font-bold text-white block">BreadcrumbList Schema</span>
          <p class="text-slate-400">Generated on every public page reflecting true site hierarchy without broken items.</p>
        </div>
      </div>
    </div>

    <!-- Intent Map & Cannibalization Prevention Table -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-base font-bold text-white">Search Intent Clusters & Cannibalization Defense</h2>
        <span class="text-xs text-slate-500">{totalSearchIntents} Managed Search Intents</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-950/60 border-b border-slate-800 text-slate-400">
            <tr>
              <th class="py-3 px-4 font-semibold">Cluster</th>
              <th class="py-3 px-4 font-semibold">Primary Keyword</th>
              <th class="py-3 px-4 font-semibold">Canonical Landing Page</th>
              <th class="py-3 px-4 font-semibold">Role</th>
              <th class="py-3 px-4 font-semibold">Supporting URLs</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800 text-slate-300 font-mono text-[11px]">
            {
              SEARCH_INTENT_MAP.map((entry) => (
                <tr class="hover:bg-slate-800/40 transition-colors">
                  <td class="py-3 px-4 text-brand-400 font-semibold">{entry.clusterId}</td>
                  <td class="py-3 px-4 font-sans font-bold text-white">{entry.primaryKeyword}</td>
                  <td class="py-3 px-4 text-slate-300">{entry.canonicalPath}</td>
                  <td class="py-3 px-4">
                    <span
                      class={`px-2 py-0.5 rounded text-[10px] font-bold ${
                        entry.isPillar ? 'bg-brand-950 text-brand-300 border border-brand-800' : 'bg-slate-800 text-slate-400'
                      }`}
                    >
                      {entry.isPillar ? 'Pillar' : 'Supporting'}
                    </span>
                  </td>
                  <td class="py-3 px-4 text-slate-500">
                    {entry.supportingPaths ? entry.supportingPaths.length : 0} linked
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>
