---
import '@/styles/global.css';
---

<!doctype html>
<html lang="en" class="h-full bg-slate-950 font-sans antialiased text-slate-100">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Administrator Login | LIC Calculator</title>
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="h-full flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-2xl p-8 shadow-2xl space-y-6">
      <div class="text-center space-y-2">
        <div class="inline-flex w-12 h-12 rounded-2xl bg-brand-600 text-white items-center justify-center font-bold text-lg mb-2">
          LC
        </div>
        <h1 class="text-2xl font-extrabold text-white tracking-tight">Admin & CMS Portal</h1>
        <p class="text-xs text-slate-400">
          Authorized personnel only. All access attempts are recorded in immutable audit logs.
        </p>
      </div>

      <!-- Error Message Banner -->
      <div id="login-error-banner" class="hidden p-3.5 rounded-xl bg-rose-950/40 border border-rose-800/60 text-rose-300 text-xs font-semibold"></div>

      <form id="admin-login-form" class="space-y-4" novalidate>
        <div class="space-y-1">
          <label for="admin-email" class="block text-xs font-bold text-slate-300">Admin Email</label>
          <input
            type="email"
            id="admin-email"
            name="email"
            value="admin@lic-calculators.com"
            required
            class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-white text-sm focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500"
          />
        </div>

        <div class="space-y-1">
          <label for="admin-password" class="block text-xs font-bold text-slate-300">Password</label>
          <input
            type="password"
            id="admin-password"
            name="password"
            value="AdminPass@123"
            required
            class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-white text-sm focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500"
          />
        </div>

        <button
          type="submit"
          id="login-submit-btn"
          class="w-full py-3 px-4 rounded-xl bg-brand-600 hover:bg-brand-500 active:bg-brand-700 text-white font-bold text-xs tracking-wide transition-all shadow-md cursor-pointer mt-2"
        >
          Sign In to Admin Environment
        </button>
      </form>

      <div class="text-center pt-2 border-t border-slate-800/80">
        <span class="text-[11px] text-slate-500">
          Independent Platform • lic-calculators.com
        </span>
      </div>
    </div>

    <script>
      const form = document.getElementById('admin-login-form') as HTMLFormElement;
      const errorBanner = document.getElementById('login-error-banner');
      const submitBtn = document.getElementById('login-submit-btn') as HTMLButtonElement;

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (errorBanner) errorBanner.classList.add('hidden');
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Authenticating...';
        }

        const formData = new FormData(form);
        const email = formData.get('email');
        const password = formData.get('password');

        try {
          const res = await fetch('/api/admin/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password })
          });

          const data = await res.json();
          if (res.ok && data.success) {
            window.location.href = '/admin/dashboard';
          } else {
            if (errorBanner) {
              errorBanner.textContent = data?.error?.message || 'Authentication failed.';
              errorBanner.classList.remove('hidden');
            }
          }
        } catch (err: any) {
          if (errorBanner) {
            errorBanner.textContent = 'Network or server error during sign in.';
            errorBanner.classList.remove('hidden');
          }
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Sign In to Admin Environment';
          }
        }
      });
    </script>
  </body>
</html>
