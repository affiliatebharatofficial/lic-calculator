---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { AdminStore } from '@/lib/admin';

const sources = AdminStore.listSources();
---

<AdminLayout title="Actuarial Sources & References" activeSection="sources">
  <div class="space-y-6 max-w-7xl mx-auto">
    <!-- Header with Action -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-white tracking-tight">Official Actuarial Sources & Verification</h2>
        <p class="text-xs text-slate-400">Every production financial rule must link directly to an officially verified source reference.</p>
      </div>

      <button
        type="button"
        class="px-4 py-2.5 bg-brand-600 hover:bg-brand-500 text-white font-bold text-xs rounded-xl shadow-sm transition-colors cursor-pointer"
      >
        + Add Source Reference
      </button>
    </div>

    <!-- Sources Table -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-950/60 border-b border-slate-800 text-slate-400">
            <tr>
              <th class="py-3.5 px-4 font-semibold">Source Title</th>
              <th class="py-3.5 px-4 font-semibold">Type</th>
              <th class="py-3.5 px-4 font-semibold">Publisher</th>
              <th class="py-3.5 px-4 font-semibold">Reference</th>
              <th class="py-3.5 px-4 font-semibold">Status</th>
              <th class="py-3.5 px-4 font-semibold">Verified By</th>
              <th class="py-3.5 px-4 font-semibold text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800 text-slate-300">
            {
              sources.map((src) => (
                <tr class="hover:bg-slate-800/40 transition-colors">
                  <td class="py-3.5 px-4 font-bold text-white max-w-xs truncate">{src.sourceTitle}</td>
                  <td class="py-3.5 px-4 font-mono text-[11px] text-slate-400">{src.sourceType}</td>
                  <td class="py-3.5 px-4 text-slate-300">{src.publisher}</td>
                  <td class="py-3.5 px-4 font-mono text-amber-400 font-semibold">{src.sourceReference}</td>
                  <td class="py-3.5 px-4">
                    <span
                      class={`px-2 py-0.5 rounded-full text-[10px] font-bold uppercase ${
                        src.verificationStatus === 'verified'
                          ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30'
                          : 'bg-amber-500/20 text-amber-400 border border-amber-500/30'
                      }`}
                    >
                      {src.verificationStatus}
                    </span>
                  </td>
                  <td class="py-3.5 px-4 text-slate-400">{src.verifiedBy || '—'}</td>
                  <td class="py-3.5 px-4 text-right">
                    {src.verificationStatus === 'pending' && (
                      <button
                        type="button"
                        class="px-2.5 py-1 bg-blue-900/60 hover:bg-blue-800 text-blue-200 border border-blue-700 rounded-lg text-[11px] font-semibold cursor-pointer"
                        data-id={src.id}
                      >
                        Verify Source
                      </button>
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>
