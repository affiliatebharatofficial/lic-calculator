---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { AdminStore } from '@/lib/admin';

const rules = AdminStore.listRules();
---

<AdminLayout title="Actuarial Rule Management" activeSection="rules">
  <div class="space-y-6 max-w-7xl mx-auto">
    <!-- Header with Action -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-white tracking-tight">Financial Rule Versions & Lifecycle</h2>
        <p class="text-xs text-slate-400">
          Only <strong>Verified & Published</strong> rules are served to the public calculator engine. Draft and unverified rules remain strictly quarantined.
        </p>
      </div>

      <div class="flex gap-2">
        <button
          type="button"
          id="open-create-rule-btn"
          class="px-4 py-2.5 bg-brand-600 hover:bg-brand-500 text-white font-bold text-xs rounded-xl shadow-sm transition-colors cursor-pointer"
        >
          + Create Draft Rule
        </button>
      </div>
    </div>

    <!-- Notification Toast Box -->
    <div id="rule-action-banner" class="hidden p-4 rounded-xl text-xs font-semibold"></div>

    <!-- Rules Table -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-950/60 border-b border-slate-800 text-slate-400">
            <tr>
              <th class="py-3.5 px-4 font-semibold">Plan</th>
              <th class="py-3.5 px-4 font-semibold">Calculator</th>
              <th class="py-3.5 px-4 font-semibold">Version</th>
              <th class="py-3.5 px-4 font-semibold">Strategy</th>
              <th class="py-3.5 px-4 font-semibold">Effective Range</th>
              <th class="py-3.5 px-4 font-semibold">Status</th>
              <th class="py-3.5 px-4 font-semibold">Public Live?</th>
              <th class="py-3.5 px-4 font-semibold text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800 text-slate-300">
            {
              rules.map((rule) => {
                const isPublished = rule.isPublished;
                return (
                  <tr class="hover:bg-slate-800/40 transition-colors" data-rule-id={rule.id}>
                    <td class="py-3.5 px-4 font-mono font-bold text-white">Table {rule.tableNo}</td>
                    <td class="py-3.5 px-4 font-bold text-slate-200 capitalize">{rule.calculatorCode}</td>
                    <td class="py-3.5 px-4 font-mono text-brand-400 font-semibold">{rule.version}</td>
                    <td class="py-3.5 px-4 font-mono text-[11px] text-slate-400">{rule.calculationStrategy}</td>
                    <td class="py-3.5 px-4 font-mono text-[11px]">
                      {rule.effectiveFrom} &rarr; {rule.effectiveTo || 'Present'}
                    </td>
                    <td class="py-3.5 px-4">
                      <span
                        class={`px-2 py-0.5 rounded-full text-[10px] font-bold uppercase ${
                          rule.status === 'published'
                            ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30'
                            : rule.status === 'verified'
                              ? 'bg-blue-500/20 text-blue-400 border border-blue-500/30'
                              : rule.status === 'review'
                                ? 'bg-amber-500/20 text-amber-400 border border-amber-500/30'
                                : rule.status === 'disabled'
                                  ? 'bg-rose-500/20 text-rose-400 border border-rose-500/30'
                                  : 'bg-slate-800 text-slate-400'
                        }`}
                      >
                        {rule.status}
                      </span>
                    </td>
                    <td class="py-3.5 px-4">
                      {isPublished ? (
                        <span class="text-emerald-400 font-bold flex items-center gap-1">
                          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                          Live
                        </span>
                      ) : (
                        <span class="text-slate-500">Quarantined</span>
                      )}
                    </td>
                    <td class="py-3.5 px-4 text-right space-x-1.5 whitespace-nowrap">
                      {rule.status === 'draft' && (
                        <button
                          type="button"
                          class="action-submit-review px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-amber-300 rounded-lg text-[11px] font-semibold cursor-pointer"
                          data-id={rule.id}
                        >
                          Submit Review
                        </button>
                      )}
                      {rule.status === 'review' && (
                        <button
                          type="button"
                          class="action-verify px-2.5 py-1 bg-blue-900/60 hover:bg-blue-800 text-blue-200 border border-blue-700 rounded-lg text-[11px] font-semibold cursor-pointer"
                          data-id={rule.id}
                        >
                          Verify & Gate
                        </button>
                      )}
                      {rule.status === 'verified' && (
                        <button
                          type="button"
                          class="action-publish px-2.5 py-1 bg-emerald-700 hover:bg-emerald-600 text-white rounded-lg text-[11px] font-semibold shadow-xs cursor-pointer"
                          data-id={rule.id}
                        >
                          Publish to Live
                        </button>
                      )}
                      {rule.status === 'published' && (
                        <button
                          type="button"
                          class="action-disable px-2.5 py-1 bg-rose-950 hover:bg-rose-900 text-rose-300 border border-rose-800 rounded-lg text-[11px] font-semibold cursor-pointer"
                          data-id={rule.id}
                        >
                          Emergency Disable
                        </button>
                      )}
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    const banner = document.getElementById('rule-action-banner');

    function notify(msg: string, isError: boolean = false) {
      if (!banner) return;
      banner.textContent = msg;
      banner.className = `p-4 rounded-xl text-xs font-semibold ${
        isError ? 'bg-rose-950/60 border border-rose-800 text-rose-300' : 'bg-emerald-950/60 border border-emerald-800 text-emerald-300'
      }`;
      banner.classList.remove('hidden');
      setTimeout(() => banner.classList.add('hidden'), 5000);
    }

    // Submit for Review
    document.querySelectorAll('.action-submit-review').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.id;
        try {
          const res = await fetch(`/api/admin/rules/${id}/review`, { method: 'POST' });
          const json = await res.json();
          if (res.ok && json.success) {
            notify('Rule submitted for actuarial review successfully.');
            setTimeout(() => window.location.reload(), 1000);
          } else {
            notify(json?.error?.message || 'Failed to submit review.', true);
          }
        } catch {
          notify('Server error.', true);
        }
      });
    });

    // Verify
    document.querySelectorAll('.action-verify').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.id;
        try {
          const res = await fetch(`/api/admin/rules/${id}/verify`, { method: 'POST' });
          const json = await res.json();
          if (res.ok && json.success) {
            notify('Rule verified! Passed all automated regression fixtures.');
            setTimeout(() => window.location.reload(), 1000);
          } else {
            notify(json?.error?.message || 'Verification rejected.', true);
          }
        } catch {
          notify('Server error.', true);
        }
      });
    });

    // Publish
    document.querySelectorAll('.action-publish').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.id;
        if (!confirm('PRODUCTION IMPACT WARNING: This change will immediately affect live public calculator results. Are you sure you want to publish?')) {
          return;
        }
        try {
          const res = await fetch(`/api/admin/rules/${id}/publish`, { method: 'POST' });
          const json = await res.json();
          if (res.ok && json.success) {
            notify('Rule successfully published to production calculators.');
            setTimeout(() => window.location.reload(), 1000);
          } else {
            notify(json?.error?.message || 'Publishing blocked.', true);
          }
        } catch {
          notify('Server error.', true);
        }
      });
    });

    // Disable
    document.querySelectorAll('.action-disable').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.id;
        if (!confirm('EMERGENCY ACTION: Disable this rule from production calculators?')) return;
        try {
          const res = await fetch(`/api/admin/rules/${id}/disable`, { method: 'POST' });
          const json = await res.json();
          if (res.ok && json.success) {
            notify('Rule emergency disabled. Public calculators will report calculation temporarily unavailable.');
            setTimeout(() => window.location.reload(), 1000);
          } else {
            notify(json?.error?.message || 'Disable action failed.', true);
          }
        } catch {
          notify('Server error.', true);
        }
      });
    });
  </script>
</AdminLayout>
