---
import CalculatorShell from '@/components/calculator/CalculatorShell.astro';
import CurrencyInput from '@/components/calculator/CurrencyInput.astro';
import RangeInput from '@/components/calculator/RangeInput.astro';
import CalculateButton from '@/components/calculator/CalculateButton.astro';
import ResetButton from '@/components/calculator/ResetButton.astro';
import ResultCard from '@/components/ui/ResultCard.astro';
import ResultBreakdown from '@/components/calculator/ResultBreakdown.astro';
import CalculationExplanation from '@/components/calculator/CalculationExplanation.astro';
import RelatedCalculatorCard from '@/components/calculator/RelatedCalculatorCard.astro';
import { CALCULATOR_SEO_DATA } from '@/lib/seo/calculator-content';

const seoData = CALCULATOR_SEO_DATA['lic-return-calculator'];

const breadcrumbs = [
  { name: 'Calculators', url: '/calculators' },
  { name: 'Policy Return & IRR Calculator', url: '/lic-return-calculator' }
];

const breakdownItems = [
  { id: '1', label: 'Total Invested Premiums (20 Yrs × ₹50,000)', amount: '₹10,00,000', notes: 'Cumulative cash outflow' },
  { id: '2', label: 'Guaranteed Lump-Sum Maturity Returns', amount: '₹21,00,000', isCredit: true, notes: 'Net maturity payout' },
  { id: '3', label: 'Net Monetary Gain / Wealth Addition', amount: '₹11,00,000', isCredit: true, notes: '100% Tax-Free' }
];

const relatedTools = [
  {
    title: 'Maturity Calculator',
    description: 'Calculate maturity corpus including bonus and FAB additions.',
    url: '/lic-maturity-calculator',
    category: 'Maturity'
  },
  {
    title: 'Premium Calculator',
    description: 'Calculate installment premiums for all active LIC plans.',
    url: '/lic-premium-calculator',
    category: 'Premium'
  }
];
---

<CalculatorShell
  title={seoData.seoTitle}
  description={seoData.metaDescription}
  calculatorTitle={seoData.h1}
  calculatorSubtitle={seoData.subtitle}
  category={seoData.category}
  lastReviewedDate={seoData.lastReviewedDate}
  sources={seoData.sources}
  faqs={seoData.faqs}
  breadcrumbs={breadcrumbs}
>
  <div slot="inputs" class="bg-white rounded-2xl border border-slate-200/90 p-6 sm:p-7 shadow-card">
    <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-6">
      <h2 class="text-base font-bold text-slate-900">Policy Cash Flow Parameters</h2>
      <ResetButton />
    </div>

    <form class="space-y-5" id="returnForm">
      <CurrencyInput
        id="annualPremium"
        name="annualPremium"
        label="Annual Premium (Excl. GST)"
        value={50000}
        placeholder="e.g. 50000"
        min={1000}
        required
      />
      <RangeInput
        id="policyTerm"
        name="policyTerm"
        label="Policy Term (Years)"
        value={20}
        min={5}
        max={40}
        unit="Years"
        required
      />
      <CurrencyInput
        id="expectedMaturityAmount"
        name="expectedMaturityAmount"
        label="Expected Maturity Payout (Sum Assured + Bonus)"
        value={2100000}
        placeholder="e.g. 2100000"
        min={10000}
        required
      />
      <div class="pt-2">
        <CalculateButton text="Calculate Exact IRR & Returns" />
      </div>
    </form>
  </div>

  <div slot="results">
    <ResultCard
      headline="Annualized Internal Rate of Return (IRR)"
      amount="5.62% p.a."
      subtitle="100% Tax-Free under Section 10(10D) (Equivalent to ~8.03% Pre-Tax Bank FD)"
      stats={[
        { label: 'Total Invested', value: '₹10,00,000' },
        { label: 'Maturity Payout', value: '₹21,00,000' },
        { label: 'Net Profit', value: '₹11,00,000' },
        { label: 'Nominal CAGR', value: '3.79% p.a.' }
      ]}
    />
  </div>

  <div slot="breakdown">
    <ResultBreakdown
      title="Yield & Cash Flow Performance"
      items={breakdownItems}
      totalLabel="Net Financial Gain"
      totalAmount="₹11,00,000"
      summaryNotes="Traditional LIC plans combine sovereign safety, guaranteed returns, and continuous life protection."
    />
  </div>

  <div slot="explanation">
    <CalculationExplanation
      howItWorks={seoData.howItWorks}
      inputsGuide={seoData.inputsGuide}
      resultsGuide={seoData.resultsGuide}
      assumptions={seoData.assumptionsAndLimitations}
    />
  </div>

  <div slot="related">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {relatedTools.map((tool) => (
        <RelatedCalculatorCard {...tool} />
      ))}
    </div>
  </div>
</CalculatorShell>
