---
import CalculatorShell from '@/components/calculator/CalculatorShell.astro';
import CurrencyInput from '@/components/calculator/CurrencyInput.astro';
import RangeInput from '@/components/calculator/RangeInput.astro';
import CalculateButton from '@/components/calculator/CalculateButton.astro';
import ResetButton from '@/components/calculator/ResetButton.astro';
import ResultCard from '@/components/ui/ResultCard.astro';
import ResultBreakdown from '@/components/calculator/ResultBreakdown.astro';
import CalculationExplanation from '@/components/calculator/CalculationExplanation.astro';
import RelatedCalculatorCard from '@/components/calculator/RelatedCalculatorCard.astro';
import { CALCULATOR_SEO_DATA } from '@/lib/seo/calculator-content';

const seoData = CALCULATOR_SEO_DATA['lic-term-insurance-calculator'];

const breadcrumbs = [
  { name: 'Calculators', url: '/calculators' },
  { name: 'Term Insurance Calculator', url: '/lic-term-insurance-calculator' }
];

const breakdownItems = [
  { id: '1', label: 'Base Mortality Risk Premium (Age 28, Term 35)', amount: '₹10,847', notes: 'Pure mortality risk charge' },
  { id: '2', label: 'High Sum Assured Rebate (₹1 Crore+)', amount: '₹1,500', isCredit: false, notes: 'Discount for high volume coverage' },
  { id: '3', label: 'Statutory GST (18.0% on Pure Protection)', amount: '₹1,953', isCredit: true, notes: 'Applicable tax on term insurance' }
];

const relatedTools = [
  {
    title: 'Premium Calculator',
    description: 'Compare term insurance with endowment savings plans.',
    url: '/lic-premium-calculator',
    category: 'Endowment'
  },
  {
    title: 'Maturity Calculator',
    description: 'Estimate maturity returns if you combine term with savings.',
    url: '/lic-maturity-calculator',
    category: 'Returns'
  }
];
---

<CalculatorShell
  title={seoData.seoTitle}
  description={seoData.metaDescription}
  calculatorTitle={seoData.h1}
  calculatorSubtitle={seoData.subtitle}
  category={seoData.category}
  lastReviewedDate={seoData.lastReviewedDate}
  sources={seoData.sources}
  faqs={seoData.faqs}
  breadcrumbs={breadcrumbs}
>
  <div slot="inputs" class="bg-white rounded-2xl border border-slate-200/90 p-6 sm:p-7 shadow-card">
    <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-6">
      <h2 class="text-base font-bold text-slate-900">Coverage Parameters</h2>
      <ResetButton />
    </div>

    <form class="space-y-5">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <RangeInput id="age" name="age" label="Your Current Age" value={28} min={18} max={65} unit="Years" required />
        <RangeInput id="policyTerm" name="policyTerm" label="Coverage Duration" value={35} min={10} max={40} unit="Years" required />
      </div>
      <CurrencyInput id="sumAssured" name="sumAssured" label="Life Cover Required" value={10000000} placeholder="e.g. 10000000" min={2500000} required helpText="e.g. ₹1,00,00,000 (1 Crore)" />
      <div class="pt-2">
        <CalculateButton text="Calculate Term Premium" />
      </div>
    </form>
  </div>

  <div slot="results">
    <ResultCard
      headline="Estimated Term Premium"
      amount="₹11,300 / Year"
      subtitle="For ₹1.00 Crore Pure Life Cover till Age 63 (Incl. 18% GST)"
      stats={[
        { label: 'Sum Assured', value: '₹1.00 Crore' },
        { label: 'Monthly Equivalent', value: '₹985 / mo' },
        { label: 'Tax Benefit (80C)', value: 'Eligible' },
        { label: 'Nominee Claim', value: '100% Tax-Free' }
      ]}
    />
  </div>

  <div slot="breakdown">
    <ResultBreakdown
      title="Term Insurance Cost Breakdown"
      subtitle="Annual cost structure for ₹1.00 Crore cover at Age 28"
      items={breakdownItems}
      totalLabel="Total Annual Premium (Incl. GST)"
      totalAmount="₹11,300 / yr"
    />
  </div>

  <div slot="explanation">
    <CalculationExplanation
      title={seoData.howItWorks.title}
      steps={seoData.howItWorks.steps}
      notes={seoData.assumptionsAndLimitations.notes}
    />
  </div>

  <div slot="related">
    <RelatedCalculatorCard tools={relatedTools} />
  </div>
</CalculatorShell>
