  },
  {
    slug: 'lic-surrender-after-10-years',
    title: 'Surrendering Your LIC Policy After 10 Years: Value, Loss % & Better Alternatives',
    desc: 'Year-10 surrender value on an illustrative ₹50,000/yr 20-year endowment (~₹4.6–5.1 lakh on ₹5 lakh paid), why the loss band narrows, paid-up value comparison, Form 5074 process and NEFT timeline.'
  },
  {
    slug: 'lic-premium-payment-online-receipt',
    title: 'LIC Premium Payment Online: Pay Direct (No Login), UPI Apps & Receipt Download',
    desc: 'All working online premium channels: Pay Direct without registration, Customer Portal with premium-paid certificate, UPI apps; receipt download steps, credit-card convenience fee, and 6–8 day refund for double payments.'
  },
  {
    slug: 'lic-how-much-loan-on-policy',
    title: 'How Much Loan Can You Get on Your LIC Policy? 90% of Surrender Value Explained',
    desc: 'LIC lends up to 90% of surrender value in force (85% paid-up): worked example ₹7.5L → ₹6.75L, eligibility (traditional plans with surrender value), half-yearly interest, 6-month minimum repayment, no credit score.'
  },
  {
    slug: 'lic-jeevan-shanti-758-pension',
    title: 'LIC Jeevan Shanti (758): Pension on ₹10 Lakh — Single Life vs Joint Life',
    desc: 'Single-premium deferred annuity: deferment 1–12 years, rates locked at inception, ~₹99,400/yr single vs ~₹94,100/yr joint on ₹10 lakh illustrated at 45, monthly-mode −4% haircut, purchase price returned on death.'
  },
  {
    slug: 'lic-duplicate-policy-bond-form-3756',
    title: 'Lost Your LIC Policy Bond? Duplicate Bond Process with Form 3756',
    desc: 'Duplicate LIC policy bond: Form 3756 indemnity on stamp paper, Form 3807 surety if sum assured over ₹50,000, newspaper advertisement when maturity/survival benefit falls within 3 years, and the Form 3815 claim-time shortcut.'
  },
  {
    slug: 'lic-money-back-vs-endowment',
    title: 'LIC Money-Back vs Endowment: Same ₹10 Lakh, Very Different Cash Flow',
    desc: 'Money-back pays 20% of sum assured at years 5/10/15 + 40% and bonuses at maturity; endowment pays SA + bonuses at maturity. Full-SA death benefit regardless of instalments, higher money-back premium, reinvestment question, who each suits.'
  },
  {
    slug: 'lic-child-plan-amritbaal-774',
    title: 'LIC Child Plans Explained: Amritbaal (774) & Children\'s Money Back',
    desc: 'Amritbaal 774: Guaranteed Additions ₹80 per ₹1,000 BSA/yr, maturity age 18–25 chosen by parent, single or 5/6/7-yr premium. Children\'s Money Back: 20% at ages 18/20/22 + 40% and bonuses at 25. Premium waiver rider on parent explained.'
  },
  {
    slug: 'lic-term-cover-how-much',
    title: 'How Much Term Insurance Do You Actually Need? The Expense Method',
    desc: 'Expense method beats the 10× thumb rule: annual expenses × support years + loans + children\'s goals − existing assets. Worked ₹8L-income example (₹80L thumb rule vs ~₹1.4 crore need), tenure to 60–65, claim-settlement and disclosure checks.'
  },
  {
    slug: 'lic-single-premium-plans',
    title: 'LIC Single Premium Plans: Pay Once, Stay Covered — Who Should Buy Them',
    desc: 'Single Premium Endowment (10–25 yrs, maturity SA + bonuses) and Bima Bachat (9/12/15-yr money-back, ~₹72–77.5k per ₹1L SA at 30). GSV 70% year 1, 90% from year 2; loan after year 1; 80C only in payment year; 10(10D) premium-to-SA test to verify.'
  },
  {
    slug: 'lic-survival-benefit-claim',
    title: 'LIC Survival Benefit Claim: Your Money-Back Instalment Falls Due',
    desc: 'Survival benefit payable when premiums are paid to the due date: branch intimation, discharge receipt, NEFT mandate. Missed instalments remain claimable as unclaimed amounts and can be adjusted against money-back revival dues.'
  },
  {
    slug: 'lic-bonus-rate-check-plan',
    title: 'LIC Bonus Rate: How to Check What Your Plan Was Declared',
    desc: 'Reversionary bonus declared per ₹1,000 sum assured after the 31-March valuation; rate varies by plan and term band (illustration: ₹44/1,000 ≈ ₹22k/yr on ₹5L SA, ≈ ₹3.3L over 15 yrs). Where the official plan-wise chart lives, and why non-par plans show none.'
  },
  {
    slug: 'lic-check-surrender-value',
    title: 'How to Check Your LIC Surrender Value: Portal, Phone and Branch Quotation',
    desc: 'Customer Portal enrolment → Loan & Bonus details shows surrender value and loan eligibility; IVR 022-6827-6827 loan menu gives a 90%-of-SV proxy; the servicing branch\'s written quotation is authoritative. Surrender via Form 5074 at the servicing branch; no online surrender.'
  },
  {
    slug: 'lic-revival-quotation-interest',
    title: 'LIC Revival Quotation Explained: Arrears, 9.5% Interest and the Three Schemes',
    desc: 'Revival quotation = arrears of premium + interest ~9.5% p.a. compounded half-yearly from each due date (illustration ₹50k/yr × 3 yrs ≈ ₹1.74 lakh). Ordinary vs special (commencement date-shifted) vs instalment revival, Form 680 DGH, SB/loan set-offs, campaign late-fee concessions.'
  },
  {
    slug: 'lic-ulip-vs-traditional',
    title: 'LIC ULIP vs Traditional Policy: Market-Linked Growth or Guaranteed Certainty?',
    desc: 'LIC ULIPs (SIIP, Nivesh Plus): fund value at NAV after ~1.35% p.a. FMC, allocation/mortality charges, 5-year lock-in, maturity taxed when annual premium exceeds ₹2.5 lakh. Traditional participating plans: SA + vested bonuses, no market risk. Decision grid by goal and horizon.'
  },
  {
    slug: 'lic-80c-old-vs-new-regime',
    title: 'LIC Premium and Section 80C: Old vs New Tax Regime — Who Still Gets the Deduction?',
    desc: 'The new (default) tax regime has no 80C — an LIC premium earns zero deduction there. The old regime keeps the ₹1.5 lakh 80C bucket. FY 2025-26 slabs, the ₹12 lakh 87A rebate, a worked ₹20 lakh-salary comparison, and the break-even deduction level.'
  },
  {
    slug: 'lic-irdai-commission-caps-2026',
    title: 'IRDAI Commission Caps 2026: What LIC Policyholders Should Know',
    desc: 'IRDAI has proposed product-level commission caps and lower expense limits (life EoM 15% in two years, 12.5% in five). What it means for your LIC premium, your agent and your existing policy — and how to send feedback before 25 October 2026.'
  },
  {
    slug: 'lic-policy-loan-rules',
    title: 'LIC Policy Loan Rules, Interest Rate & Repayment Guide',
    desc: 'Learn how much you can borrow against your LIC policy without losing life cover.'
  },
  {
    slug: 'lic-unclaimed-amount-check-claim',
    title: 'Unclaimed Money in LIC: Check Online & Claim Maturity/Survival Amount',
    desc: 'LIC\'s official Unclaimed Amounts of Policyholders search (name + date of birth mandatory), the branch claim with NEFT mandate, lost-bond and nominee routes, and the 10-year Senior Citizens\' Welfare Fund transfer with a 25-year claim window.'
  }
];

export function getStaticPaths() {
  const nonDefaultLocales = LOCALE_CODES.filter((l) => l !== DEFAULT_LOCALE);
  const paths: any[] = [];

  for (const lang of nonDefaultLocales) {
    for (const guide of GUIDE_ITEMS) {
      paths.push({
        params: { lang, slug: guide.slug },
        props: { guide }
      });
    }
  }

  return paths;
}

const { lang } = Astro.params;
const { guide } = Astro.props;
const locale = (lang as Locale) || DEFAULT_LOCALE;

const breadcrumbs = [
  { name: t(locale, 'nav.calculators'), url: getLocalizedPath('/calculators/', locale) },
  { name: 'Guides', url: getLocalizedPath('/guides/', locale) },
  { name: guide.title, url: getLocalizedPath(`/guides/${guide.slug}`, locale) }
];
---

<BaseLayout
  title={`${guide.title} - ${t(locale, 'site.name')}`}
  description={guide.desc}
  breadcrumbs={breadcrumbs}
  locale={locale}
>
  <article class="max-w-4xl mx-auto py-12 px-4 sm:px-6 space-y-10">
    <div class="space-y-3 border-b border-slate-200 pb-8">
      <span class="px-3 py-1 rounded-full text-xs font-bold bg-brand-50 text-brand-700 border border-brand-200">
        Educational Guide
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">{guide.title}</h1>
      <p class="text-base text-slate-600 leading-relaxed">{guide.desc}</p>
    </div>

    <ContextualLinks currentPath={`/guides/${guide.slug}`} />

    <AuthorReviewerCard />
  </article>
</BaseLayout>
