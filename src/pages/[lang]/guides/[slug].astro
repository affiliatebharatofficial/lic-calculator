---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AuthorReviewerCard from '@/components/editorial/AuthorReviewerCard.astro';
import ContextualLinks from '@/components/seo/ContextualLinks.astro';
import { LOCALE_CODES, DEFAULT_LOCALE, t, getLocalizedPath } from '@/lib/i18n';
import type { Locale } from '@/types/i18n';

export const GUIDE_ITEMS = [
  {
    slug: 'what-is-lic-surrender-value',
    title: 'What is LIC Surrender Value? Calculation Guide & GSV/SSV Rules',
    desc: 'Understand how LIC policy surrender value is calculated, the difference between GSV and SSV, and 2-year vesting rules.'
  },
  {
    slug: 'lic-paid-up-vs-surrender',
    title: 'LIC Paid-Up vs. Surrender: Which Option is Financially Better?',
    desc: 'Comparing financial trade-offs between converting an LIC policy into a reduced Paid-Up policy vs immediate cash Surrender.'
  },
  {
    slug: 'how-lic-bonus-is-calculated',
    title: 'How is LIC Bonus Calculated? Simple Reversionary & FAB Rates Guide',
    desc: 'Actuarial guide explaining simple reversionary bonuses per ₹1,000 Sum Assured and Final Additional Bonus rules.'
  },
  {
    slug: 'lic-irdai-surrender-rules-2024',
    title: 'LIC New Surrender Rules (IRDAI, 1 Oct 2024): Surrender Value Now After Just 1 Year',
    desc: 'IRDAI\'s revised surrender norms from 1 October 2024 make surrender value payable after the first policy year, with a fairer G-Sec-linked SSV formula. Old rule vs new rule explained.'
  },
  {
    slug: 'lic-surrender-after-5-years',
    title: 'LIC Surrender After 5 Years: How Much Will You Get — and Lose?',
    desc: 'Illustrative year-5 payout and loss calculation, how GSV and SSV are worked out after 5 years, and the paid-up and loan alternatives to price before surrendering.'
  },
  {
    slug: 'lic-policy-status-check',
    title: 'How to Check LIC Policy Status Online, by SMS & WhatsApp (5 Methods)',
    desc: 'Five ways to check whether your LIC policy is in-force, lapsed, paid-up or matured — Customer Portal, WhatsApp, SMS, helpline and branch — and the next step for each status.'
  },
  {
    slug: 'lic-policy-revival',
    title: 'LIC Policy Lapsed? Revival Process, Cost & Last Date (5-Year Rule)',
    desc: 'How to revive a lapsed LIC policy within 5 years of the first unpaid premium: arrears-plus-interest cost explained with a worked example, health-declaration step, and when revival beats paid-up or surrender.'
  },
  {
    slug: 'lic-premium-grace-period-late-fee',
    title: 'Missed Your LIC Premium Date? Grace Period, Late Fee & What Happens Next',
    desc: 'LIC grace period explained: 30 days (15 for monthly mode), cover continues during grace, late-fee interest applies only to revival arrears, and the exact point a policy lapses.'
  },
  {
    slug: 'lic-gst-0-percent-premium-change',
    title: 'LIC Premium Shows No GST? The 0% GST Change Explained (Sep 2025)',
    desc: 'Individual life insurance became GST-exempt on 22 September 2025: actual saving by plan type (endowment 2.25% renewals, term 18%), how to check your notice, and why the base premium may move.'
  },
  {
    slug: 'lic-maturity-claim-form-3825',
    title: 'LIC Policy Maturing? Maturity Claim with Form 3825 — Documents & Steps',
    desc: 'Form 3825 discharge receipt explained: documents for an LIC maturity claim (original bond, NEFT mandate, ID proof), LIC intimation timing, the 1-month submission rule, and expected deductions.'
  },
  {
    slug: 'lic-death-claim-documents-nominee',
    title: 'LIC Death Claim: Complete Documents Checklist for the Nominee (Forms 3783 & 3801)',
    desc: 'Nominee checklist for an LIC death claim: intimation letter, Claim Form 3783/3783A, discharge Form 3801, death certificate, original policy bond, NEFT — plus early-death extra forms 3784, 3816, 3785, 3787.'
  },
  {
    slug: 'lic-maturity-tax-10-10d-explained',
    title: 'Is LIC Maturity Tax-Free? Section 10(10D), the ₹5 Lakh Premium Rule & TDS Explained',
    desc: 'Most LIC maturity payouts are exempt under 10(10D). Two tests decide yours: premium within 10% of sum assured, and for policies issued on/after 1 Apr 2023 aggregate premiums within ₹5 lakh a year; death benefits always exempt; 194DA TDS if taxable.'
  },
  {
    slug: 'lic-policy-loan-interest-rate',
    title: 'LIC Policy Loan Interest Rate: Real Cost Over 1, 3 & 5 Years',
    desc: 'No single published LIC policy-loan rate; plan documents most often cite ~10.5% p.a. compounded half-yearly. Rupee cost of a ₹1 lakh loan at 1, 3 and 5 years, the interest-only trap, and the claim-time adjustment.'
  },
  {
    slug: 'lic-change-nominee-form-3750',
    title: 'How to Change the Nominee in Your LIC Policy (Form 3750, Branch & Online Truth)',
