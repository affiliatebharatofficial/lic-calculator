---
import CalculatorShell from '@/components/calculator/CalculatorShell.astro';
import CurrencyInput from '@/components/calculator/CurrencyInput.astro';
import RangeInput from '@/components/calculator/RangeInput.astro';
import CalculateButton from '@/components/calculator/CalculateButton.astro';
import ResetButton from '@/components/calculator/ResetButton.astro';
import ResultCard from '@/components/ui/ResultCard.astro';
import ResultBreakdown from '@/components/calculator/ResultBreakdown.astro';
import CalculationExplanation from '@/components/calculator/CalculationExplanation.astro';
import RelatedCalculatorCard from '@/components/calculator/RelatedCalculatorCard.astro';
import { LOCALE_CODES, DEFAULT_LOCALE, t, getLocalizedPath } from '@/lib/i18n';
import { getCalculatorSeoData } from '@/lib/seo/calculator-content';
import type { Locale } from '@/types/i18n';

export function getStaticPaths() {
  return LOCALE_CODES.filter((l) => l !== DEFAULT_LOCALE).map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
const locale = (lang as Locale) || DEFAULT_LOCALE;
const seoData = getCalculatorSeoData('lic-pension-calculator', locale);

const breadcrumbs = [
  { name: t(locale, 'nav.calculators'), url: getLocalizedPath('/calculators/', locale) },
  { name: t(locale, 'nav.pensionCalculator'), url: getLocalizedPath('/lic-pension-calculator/', locale) }
];

const breakdownItems = [
  { id: '1', label: t(locale, 'common.purchasePrice'), amount: '₹25,00,000', notes: 'Corpus' },
  { id: '2', label: 'Annuity GST (1.8%)', amount: '₹44,204', isCredit: true, notes: 'Statutory GST' },
  { id: '3', label: t(locale, 'common.annualPension'), amount: '₹1,74,000 / yr', isCredit: true, notes: '~6.96% p.a.' }
];

const relatedTools = [
  {
    title: t(locale, 'nav.maturityCalculator'),
    description: 'Check how much maturity corpus your savings plan will generate.',
    url: getLocalizedPath('/lic-maturity-calculator/', locale),
    category: 'Corpus'
  },
  {
    title: t(locale, 'nav.loanCalculator'),
    description: 'Borrow against policy surrender value before retirement.',
    url: getLocalizedPath('/lic-loan-calculator/', locale),
    category: 'Liquidity'
  }
];
---

<CalculatorShell
  title={seoData.seoTitle}
  description={seoData.metaDescription}
  calculatorTitle={seoData.h1}
  calculatorSubtitle={seoData.subtitle}
  category={seoData.category}
  lastReviewedDate={seoData.lastReviewedDate}
  sources={seoData.sources}
  faqs={seoData.faqs}
  locale={locale}
  breadcrumbs={breadcrumbs}
>
  <div slot="inputs" class="bg-white rounded-2xl border border-slate-200/90 p-6 sm:p-7 shadow-card">
    <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-6">
      <h2 class="text-base font-bold text-slate-900">{t(locale, 'common.assumptions')}</h2>
      <ResetButton />
    </div>

    <form id="lic-pension-form" class="space-y-5">
      <CurrencyInput
        id="purchasePrice"
        name="purchasePrice"
        label={t(locale, 'common.purchasePrice')}
        value={2500000}
        min={100000}
        max={100000000}
        step={50000}
        required
      />
      <RangeInput
        id="age"
        name="age"
        label={t(locale, 'common.age')}
        value={60}
        min={30}
        max={85}
        unit={t(locale, 'common.years')}
        required
      />
      <div class="pt-2">
        <CalculateButton text={t(locale, 'common.calculate')} />
      </div>
    </form>
  </div>

  <div slot="results">
    <ResultCard
      headline={t(locale, 'common.monthlyPension')}
      amount="₹14,500 / month"
      subtitle={`Estimated Annuity Rate ~6.96% p.a. (${t(locale, 'common.annualPension')}: ₹1,74,000/yr)`}
      stats={[
        { label: t(locale, 'common.purchasePrice'), value: '₹25,00,000' },
        { label: t(locale, 'common.annualPension'), value: '₹1,74,000' },
        { label: 'Return of Purchase Price', value: 'Option Available' },
        { label: 'Pension Frequency', value: 'Monthly (NEFT)' }
      ]}
    />
  </div>

  <div slot="breakdown">
    <ResultBreakdown
      title={t(locale, 'common.breakdown')}
      subtitle={`${t(locale, 'common.componentBreakdown')} ₹25,00,000 ${t(locale, 'common.purchasePrice')}`}
      items={breakdownItems}
      totalLabel={t(locale, 'common.annualPension')}
      totalAmount="₹1,74,000 / yr"
    />
  </div>

  <div slot="explanation">
    <CalculationExplanation
      title={seoData.howItWorks.title}
      description={seoData.howItWorks.description}
      steps={seoData.howItWorks.steps}
      notes={seoData.assumptionsAndLimitations.notes}
      locale={locale}
    />
  </div>

  <div slot="related">
    <RelatedCalculatorCard tools={relatedTools} />
  </div>
</CalculatorShell>
