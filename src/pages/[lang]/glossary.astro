---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import { GLOSSARY_TERMS, LOCALE_CODES, DEFAULT_LOCALE, t, getLocalizedPath } from '@/lib/i18n';
import type { Locale } from '@/types/i18n';

export function getStaticPaths() {
  return LOCALE_CODES.filter((l) => l !== DEFAULT_LOCALE).map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
const locale = (lang as Locale) || DEFAULT_LOCALE;

const breadcrumbs = [
  { name: 'Glossary', url: getLocalizedPath('/glossary', locale) }
];
---

<BaseLayout
  title={`Insurance Terminology Glossary - ${t(locale, 'site.name')}`}
  description="Comprehensive glossary of LIC policy and financial terms translated across English and regional Indian languages."
  breadcrumbs={breadcrumbs}
  locale={locale}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumbs items={breadcrumbs} />

    <div class="border-b border-slate-200 pb-6 mb-8 mt-2">
      <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Financial & Insurance Glossary
      </h1>
      <p class="text-base text-slate-600 mt-2">
        Clear, accurate definitions of key life insurance concepts and mathematical terms.
      </p>
    </div>

    <div class="space-y-4">
      {
        GLOSSARY_TERMS.map((term) => {
          const localizedName = term.localizedTerms[locale] || term.localizedTerms.en;
          const localizedDesc = term.descriptions[locale] || term.descriptions.en;
          return (
            <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-2">
              <div class="flex items-center justify-between">
                <h2 class="text-lg font-bold text-slate-900">{localizedName}</h2>
                <span class="text-xs text-slate-400 font-mono">({term.englishTerm})</span>
              </div>
              <p class="text-sm text-slate-600 leading-relaxed">{localizedDesc}</p>
            </div>
          );
        })
      }
    </div>
  </div>
</BaseLayout>
