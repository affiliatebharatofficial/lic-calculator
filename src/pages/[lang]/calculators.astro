---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import Badge from '@/components/ui/Badge.astro';
import CalculatorSearch from '@/components/search/CalculatorSearch.astro';
import { ALL_CALCULATORS } from '@/lib/calculators/registry';
import { LOCALE_CODES, DEFAULT_LOCALE, t, getLocalizedPath } from '@/lib/i18n';
import type { Locale } from '@/types/i18n';

export function getStaticPaths() {
  return LOCALE_CODES.filter((l) => l !== DEFAULT_LOCALE).map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
const locale = (lang as Locale) || DEFAULT_LOCALE;

const breadcrumbs = [
  { name: t(locale, 'nav.calculators'), url: getLocalizedPath('/calculators', locale) }
];
---

<BaseLayout
  title={`${t(locale, 'nav.calculators')} - ${t(locale, 'site.name')}`}
  description={t(locale, 'site.description')}
  breadcrumbs={breadcrumbs}
  locale={locale}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12" data-directory-container>
    <Breadcrumbs items={breadcrumbs} />

    <!-- Page Header -->
    <div class="border-b border-slate-200/80 pb-8 mb-8 mt-2 flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-800 mb-1 block">
          {t(locale, 'nav.calculators')}
        </span>
        <h1 class="text-2xl sm:text-4xl font-extrabold text-navy-800 tracking-tight">
          {t(locale, 'home.featuredCalculators')}
        </h1>
        <p class="text-sm sm:text-base text-slate-600 mt-2">
          {t(locale, 'home.heroSubtitle')}
        </p>
      </div>

      <!-- Quick Search Bar in Directory Header -->
      <div class="w-full md:w-72 shrink-0">
        <CalculatorSearch variant="inline" placeholder={t(locale, 'common.calculate') + '...'} locale={locale} />
      </div>
    </div>

    <!-- Featured Flagship Banner: Surrender Analysis -->
    <div class="mb-8 p-6 sm:p-7 rounded-2xl bg-gradient-to-r from-navy-950 via-slate-900 to-navy-900 text-white shadow-xl border border-slate-800 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 relative overflow-hidden">
      <div class="absolute top-0 left-0 right-0 h-1 bg-accent-500"></div>
      <div class="space-y-2 max-w-2xl">
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-accent-400 text-navy-950 uppercase tracking-wider">
            Flagship Experience
          </span>
          <span class="text-xs text-slate-400">3-Way Decision Model</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-extrabold text-white">
          {t(locale, 'home.surrenderSpotlightTitle')}
        </h2>
        <p class="text-xs sm:text-sm text-slate-300">
          {t(locale, 'home.surrenderSpotlightDesc')}
        </p>
      </div>
      <a
        href={getLocalizedPath('/lic-surrender-analysis', locale)}
        class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-accent-500 hover:bg-accent-400 active:bg-accent-600 text-navy-900 font-bold text-xs sm:text-sm shadow-md transition-all shrink-0 cursor-pointer border border-accent-600/30"
      >
        <span>{t(locale, 'home.calculateSurrender')}</span>
        <span>→</span>
      </a>
    </div>

    <!-- Calculators Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="calculator-cards-grid">
      {
        ALL_CALCULATORS.map((calc) => {
          const isSurrender = calc.category === 'surrender';
          return (
            <div
              class={`calculator-card flex flex-col justify-between bg-white rounded-2xl border p-6 shadow-card hover:shadow-card-hover transition-all duration-200 ${
                isSurrender ? 'border-accent-300 bg-gradient-to-br from-accent-50/40 via-white to-white hover:border-accent-400' : 'border-slate-200/90 hover:border-accent-400'
              }`}
              data-category={calc.category}
            >
              <div>
                <div class="flex items-center justify-between gap-2 mb-4">
                  <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-accent-100 text-amber-950 font-bold text-sm border border-accent-200">
                    #
                  </span>
                  <Badge type={isSurrender ? 'warning' : calc.isAvailable ? 'default' : 'info'} class={isSurrender ? 'bg-accent-100 text-amber-950 font-bold border-accent-300' : ''}>
                    {calc.isAvailable ? calc.category : t(locale, 'common.comingSoon')}
                  </Badge>
                </div>

                <h3 class="text-lg font-bold text-navy-800 hover:text-amber-700 transition-colors">
                  {t(locale, calc.titleKey)}
                </h3>
                <p class="text-xs sm:text-sm text-slate-500 mt-2 line-clamp-3">
                  {t(locale, calc.descriptionKey)}
                </p>
              </div>

              <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
                <span class="text-xs text-slate-400 font-mono">
                  Plan Tables Supported
                </span>
                {calc.isAvailable ? (
                  <a
                    href={getLocalizedPath(`/${calc.slug}`, locale)}
                    class="inline-flex items-center gap-1.5 text-xs font-bold text-navy-800 hover:text-amber-700 transition-colors"
                  >
                    <span>{t(locale, 'common.calculate')}</span>
                    <span>&rarr;</span>
                  </a>
                ) : (
                  <span class="text-xs font-semibold text-slate-400">
                    {t(locale, 'common.comingSoon')}
                  </span>
                )}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</BaseLayout>
