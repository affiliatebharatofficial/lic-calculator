---
import CalculatorShell from '@/components/calculator/CalculatorShell.astro';
import CurrencyInput from '@/components/calculator/CurrencyInput.astro';
import RangeInput from '@/components/calculator/RangeInput.astro';
import CalculateButton from '@/components/calculator/CalculateButton.astro';
import ResetButton from '@/components/calculator/ResetButton.astro';
import ResultCard from '@/components/ui/ResultCard.astro';
import ResultBreakdown from '@/components/calculator/ResultBreakdown.astro';
import CalculationExplanation from '@/components/calculator/CalculationExplanation.astro';
import RelatedCalculatorCard from '@/components/calculator/RelatedCalculatorCard.astro';
import { LOCALE_CODES, DEFAULT_LOCALE, t, getLocalizedPath } from '@/lib/i18n';
import { getCalculatorSeoData } from '@/lib/seo/calculator-content';
import type { Locale } from '@/types/i18n';

export function getStaticPaths() {
  return LOCALE_CODES.filter((l) => l !== DEFAULT_LOCALE).map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
const locale = (lang as Locale) || DEFAULT_LOCALE;
const seoData = getCalculatorSeoData('lic-term-insurance-calculator', locale);

const breadcrumbs = [
  { name: t(locale, 'nav.calculators'), url: getLocalizedPath('/calculators/', locale) },
  { name: t(locale, 'nav.termCalculator'), url: getLocalizedPath('/lic-term-insurance-calculator/', locale) }
];

const breakdownItems = [
  { id: '1', label: `${t(locale, 'common.annualPremium')} (Mortality Risk)`, amount: '₹10,847', notes: 'Pure Risk Charge' },
  { id: '2', label: 'High Sum Assured Rebate', amount: '-₹1,500', isCredit: false, notes: '₹1 Crore+ Volume Discount' },
  { id: '3', label: 'Statutory GST (18.0%)', amount: '₹1,953', isCredit: true, notes: 'Pure Protection GST' }
];

const relatedTools = [
  {
    title: t(locale, 'nav.premiumCalculator'),
    description: 'Compare term insurance with endowment savings plans.',
    url: getLocalizedPath('/lic-premium-calculator/', locale),
    category: 'Endowment'
  },
  {
    title: t(locale, 'nav.maturityCalculator'),
    description: 'Estimate maturity returns if you combine term with savings.',
    url: getLocalizedPath('/lic-maturity-calculator/', locale),
    category: 'Returns'
  }
];
---

<CalculatorShell
  title={seoData.seoTitle}
  description={seoData.metaDescription}
  calculatorTitle={seoData.h1}
  calculatorSubtitle={seoData.subtitle}
  category={seoData.category}
  lastReviewedDate={seoData.lastReviewedDate}
  sources={seoData.sources}
  faqs={seoData.faqs}
  locale={locale}
  breadcrumbs={breadcrumbs}
>
  <div slot="inputs" class="bg-white rounded-2xl border border-slate-200/90 p-6 sm:p-7 shadow-card">
    <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-6">
      <h2 class="text-base font-bold text-slate-900">{t(locale, 'common.assumptions')}</h2>
      <ResetButton />
    </div>

    <form class="space-y-5">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <RangeInput id="age" name="age" label={t(locale, 'common.age')} value={28} min={18} max={65} unit={t(locale, 'common.years')} required />
        <RangeInput id="policyTerm" name="policyTerm" label={t(locale, 'common.policyTerm')} value={35} min={10} max={40} unit={t(locale, 'common.years')} required />
      </div>
      <CurrencyInput id="sumAssured" name="sumAssured" label={t(locale, 'common.sumAssured')} value={10000000} min={2500000} required />
      <div class="pt-2">
        <CalculateButton text={t(locale, 'common.calculate')} />
      </div>
    </form>
  </div>

  <div slot="results">
    <ResultCard
      headline={t(locale, 'common.recommendedCover')}
      amount="₹11,300 / Year"
      subtitle={`₹1.00 Crore ${t(locale, 'common.baseSumAssuredDesc')} (Incl. 18% GST)`}
      stats={[
        { label: t(locale, 'common.sumAssured'), value: '₹1.00 Crore' },
        { label: 'Monthly Equivalent', value: '₹985 / mo' },
        { label: 'Tax Benefit (80C)', value: 'Eligible' },
        { label: 'Nominee Claim', value: '100% Tax-Free' }
      ]}
    />
  </div>

  <div slot="breakdown">
    <ResultBreakdown
      title={t(locale, 'common.breakdown')}
      subtitle={`${t(locale, 'common.componentBreakdown')} ₹1.00 Crore ${t(locale, 'common.sumAssured')}`}
      items={breakdownItems}
      totalLabel={t(locale, 'common.annualPremium')}
      totalAmount="₹11,300 / yr"
    />
  </div>

  <div slot="explanation">
    <CalculationExplanation
      title={seoData.howItWorks.title}
      description={seoData.howItWorks.description}
      steps={seoData.howItWorks.steps}
      notes={seoData.assumptionsAndLimitations.notes}
      locale={locale}
    />
  </div>

  <div slot="related">
    <RelatedCalculatorCard tools={relatedTools} />
  </div>
</CalculatorShell>
