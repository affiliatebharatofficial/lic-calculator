---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import { LOCALE_CODES, DEFAULT_LOCALE, getLocalizedPath } from '@/lib/i18n';
import { getTermsContent } from '@/lib/content/terms-content';
import type { Locale } from '@/types/i18n';

export function getStaticPaths() {
  return LOCALE_CODES.filter((l) => l !== DEFAULT_LOCALE).map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
const locale = (lang as Locale) || DEFAULT_LOCALE;
const content = getTermsContent(locale);

const breadcrumbs = [
  { name: content.h1, url: getLocalizedPath('/terms/', locale) }
];
---

<BaseLayout
  title={content.seoTitle}
  description={content.metaDescription}
  breadcrumbs={breadcrumbs}
  locale={locale}
  jsonLdType="WebPage"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Breadcrumbs -->
    <Breadcrumbs items={breadcrumbs} />

    <!-- Page Header -->
    <div class="border-b border-slate-200 pb-6 mb-8 mt-3">
      <div class="flex items-center gap-2 mb-2">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold bg-blue-100 text-blue-900 border border-blue-300">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
          User Agreement
        </span>
        <span class="text-xs text-slate-500 font-medium">
          {content.lastUpdatedLabel}: {content.lastUpdatedDate}
        </span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        {content.h1}
      </h1>
      <p class="text-base text-slate-600 mt-2 max-w-3xl leading-relaxed">
        {content.subtitle}
      </p>
    </div>

    <!-- Terms Summary Banner -->
    <div class="mb-10 p-5 sm:p-6 bg-gradient-to-r from-blue-50 to-indigo-50/60 border-2 border-blue-300 rounded-2xl shadow-xs">
      <div class="flex items-start gap-3.5">
        <div class="w-8 h-8 rounded-xl bg-blue-600 text-white flex items-center justify-center font-bold text-lg shrink-0 mt-0.5 shadow-xs">
          §
        </div>
        <div>
          <h2 class="text-base font-bold text-blue-950">
            Terms of Use Overview
          </h2>
          <p class="text-sm text-blue-900/90 mt-1 leading-relaxed">
            By using lic-calculators.com, you agree to access our educational financial calculators strictly for lawful personal estimation purposes without establishing an official relationship with Life Insurance Corporation of India.
          </p>
        </div>
      </div>
    </div>

    <!-- Main Terms of Service Sections -->
    <div class="space-y-10 text-slate-700 text-sm sm:text-base leading-relaxed">
      {content.sections.map((section) => (
        <section class="space-y-4 pt-2 border-t border-slate-100 first:border-t-0 first:pt-0">
          <h2 class="text-xl sm:text-2xl font-bold text-navy-900 tracking-tight">
            {section.title}
          </h2>

          {section.paragraphs.map((p) => (
            <p class="text-slate-600 leading-relaxed">
              {p}
            </p>
          ))}

          {section.listItems && section.listItems.length > 0 && (
            <ul class="list-disc pl-5 sm:pl-6 space-y-2 text-slate-600 marker:text-blue-500">
              {section.listItems.map((item) => (
                <li class="leading-relaxed pl-1">{item}</li>
              ))}
            </ul>
          )}

          {section.alert && (
            <div class={`p-4 rounded-xl text-sm font-medium border ${
              section.alert.type === 'warning'
                ? 'bg-amber-50 text-amber-900 border-amber-200'
                : 'bg-blue-50 text-blue-900 border-blue-200'
            }`}>
              {section.alert.text}
            </div>
          )}
        </section>
      ))}

      <!-- Related Legal & Platform Resources Navigation Box -->
      <section class="pt-8 mt-12 border-t-2 border-slate-200">
        <h2 class="text-xl font-bold text-slate-900 mb-4">
          {content.relatedLinksHeading}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {content.relatedLinks.map((link) => (
            <a
              href={getLocalizedPath(link.url, locale)}
              class="p-4 rounded-xl border border-slate-200 bg-white hover:border-accent-400 hover:shadow-xs transition-all group"
            >
              <div class="font-bold text-navy-800 group-hover:text-blue-700 transition-colors flex items-center justify-between text-sm sm:text-base">
                <span>{link.label}</span>
                <span class="text-slate-400 group-hover:text-blue-700 transition-transform group-hover:translate-x-0.5">&rarr;</span>
              </div>
              <p class="text-xs text-slate-500 mt-1 leading-snug">
                {link.description}
              </p>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

