---
import CalculatorShell from '@/components/calculator/CalculatorShell.astro';
import CurrencyInput from '@/components/calculator/CurrencyInput.astro';
import RangeInput from '@/components/calculator/RangeInput.astro';
import CalculateButton from '@/components/calculator/CalculateButton.astro';
import ResetButton from '@/components/calculator/ResetButton.astro';
import ResultCard from '@/components/ui/ResultCard.astro';
import ResultBreakdown from '@/components/calculator/ResultBreakdown.astro';
import CalculationExplanation from '@/components/calculator/CalculationExplanation.astro';
import RelatedCalculatorCard from '@/components/calculator/RelatedCalculatorCard.astro';
import { getCalculatorSeoData } from '@/lib/seo/calculator-content';
import { LOCALE_CODES, DEFAULT_LOCALE, getLocalizedPath, t } from '@/lib/i18n';
import type { Locale } from '@/types/i18n';

export function getStaticPaths() {
  return LOCALE_CODES.filter((l) => l !== DEFAULT_LOCALE).map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
const locale = (lang as Locale) || DEFAULT_LOCALE;
const seoData = getCalculatorSeoData('lic-annuity-calculator', locale);

const breadcrumbs = [
  { name: t(locale, 'nav.calculators'), url: getLocalizedPath('/calculators', locale) },
  { name: t(locale, 'nav.annuityCalculator'), url: getLocalizedPath('/lic-annuity-calculator', locale) }
];

const breakdownItems = [
  { id: '1', label: t(locale, 'common.purchasePrice'), amount: '₹25,00,000', notes: 'Corpus' },
  { id: '2', label: 'GST (1.8%)', amount: '₹44,204', isCredit: true, notes: 'Tax' },
  { id: '3', label: t(locale, 'common.annualPension'), amount: '₹1,78,000 / yr', isCredit: true, notes: 'Guaranteed' }
];

const relatedTools = [
  {
    title: t(locale, 'nav.pensionCalculator'),
    description: t(locale, 'tools.pensionDesc'),
    url: getLocalizedPath('/lic-pension-calculator', locale),
    category: 'Retirement'
  },
  {
    title: t(locale, 'nav.maturityCalculator'),
    description: t(locale, 'tools.maturityDesc'),
    url: getLocalizedPath('/lic-maturity-calculator', locale),
    category: 'Corpus'
  }
];
---

<CalculatorShell
  title={seoData.seoTitle}
  description={seoData.metaDescription}
  calculatorTitle={seoData.h1}
  calculatorSubtitle={seoData.subtitle}
  category={seoData.category}
  lastReviewedDate={seoData.lastReviewedDate}
  sources={seoData.sources}
  faqs={seoData.faqs}
  breadcrumbs={breadcrumbs}
  locale={locale}
>
  <div slot="inputs" class="bg-white rounded-2xl border border-slate-200/90 p-6 sm:p-7 shadow-card">
    <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-6">
      <h2 class="text-base font-bold text-slate-900">{t(locale, 'common.purchasePrice')}</h2>
      <ResetButton locale={locale} />
    </div>

    <form class="space-y-5" id="annuityForm">
      <CurrencyInput
        id="purchasePrice"
        name="purchasePrice"
        label={t(locale, 'common.purchasePrice')}
        value={2500000}
        placeholder="e.g. 2500000"
        min={100000}
        required
        locale={locale}
      />
      <RangeInput
        id="age"
        name="age"
        label={t(locale, 'common.age')}
        value={60}
        min={30}
        max={85}
        unit={t(locale, 'common.years')}
        required
      />
      <div class="space-y-1.5">
        <label for="annuityOption" class="block text-xs font-semibold text-slate-700">Option</label>
        <select
          id="annuityOption"
          name="annuityOption"
          class="w-full h-11 px-3.5 text-xs font-medium text-slate-800 bg-white border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-accent-500"
        >
          <option value="return_of_purchase_price">Option F: Return of Purchase Price (100%)</option>
          <option value="life_only">Option A: Life Annuity (Higher Payout)</option>
          <option value="joint_life_ropp">Option J: Joint Life Annuity</option>
        </select>
      </div>
      <div class="pt-2">
        <CalculateButton text={t(locale, 'common.calculate')} />
      </div>
    </form>
  </div>

  <div slot="results">
    <ResultCard
      headline={t(locale, 'common.monthlyPension')}
      amount="₹14,833 / month"
      subtitle="~7.12% p.a. (Annual: ₹1,78,000/yr)"
      stats={[
        { label: t(locale, 'common.purchasePrice'), value: '₹25,00,000' },
        { label: t(locale, 'common.annualPension'), value: '₹1,78,000' },
        { label: 'Return of Corpus', value: '₹25,00,000' },
        { label: 'Mode', value: 'Monthly (NEFT)' }
      ]}
    />
  </div>

  <div slot="breakdown">
    <ResultBreakdown
      title={t(locale, 'common.breakdown')}
      items={breakdownItems}
      totalLabel={t(locale, 'common.annualPension')}
      totalAmount="₹1,78,000 / yr"
      summaryNotes="LIC Annuity Rate."
    />
  </div>

  <div slot="explanation">
    <CalculationExplanation
      howItWorks={seoData.howItWorks}
      inputsGuide={seoData.inputsGuide}
      resultsGuide={seoData.resultsGuide}
      assumptions={seoData.assumptionsAndLimitations}
    />
  </div>

  <div slot="related">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {relatedTools.map((tool) => (
        <RelatedCalculatorCard {...tool} />
      ))}
    </div>
  </div>
</CalculatorShell>
