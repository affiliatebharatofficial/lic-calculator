---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import { LOCALE_CODES, DEFAULT_LOCALE, t, getLocalizedPath } from '@/lib/i18n';
import type { Locale } from '@/types/i18n';

export function getStaticPaths() {
  return LOCALE_CODES.filter((l) => l !== DEFAULT_LOCALE).map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
const locale = (lang as Locale) || DEFAULT_LOCALE;

const breadcrumbs = [
  { name: t(locale, 'nav.about') || 'About', url: getLocalizedPath('/about', locale) }
];
---

<BaseLayout
  title={`About Us - ${t(locale, 'site.name')}`}
  description={t(locale, 'site.description')}
  breadcrumbs={breadcrumbs}
  locale={locale}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumbs items={breadcrumbs} />

    <div class="border-b border-slate-200 pb-6 mb-8 mt-2">
      <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        About LIC Calculator
      </h1>
      <p class="text-base text-slate-600 mt-2">
        Independent, transparent, and deterministic financial tools for policyholders.
      </p>
    </div>

    <div class="prose prose-slate max-w-none text-sm sm:text-base leading-relaxed space-y-4 text-slate-700">
      <p>
        <strong>lic-calculators.com</strong> was created to give policyholders instant, transparent, and accurate financial clarity about their life insurance policies.
      </p>
      <p>
        Our tools are engineered using deterministic actuarial formulas and verified rule tables to compute premiums, surrender values, capital shortfalls, and maturity returns without bias or commercial sales pressure.
      </p>
      <div class="p-4 bg-amber-50 border border-amber-200 rounded-xl text-xs sm:text-sm text-amber-900 mt-6">
        <strong>Important Notice:</strong> We are an independent informational website and are not affiliated with, sponsored by, or endorsed by Life Insurance Corporation of India (LIC).
      </div>
    </div>
  </div>
</BaseLayout>
