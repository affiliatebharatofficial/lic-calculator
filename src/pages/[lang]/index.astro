    },
    aiSection: {
      badge: 'Coming in Future Phase',
      title: 'Understand your policy with AI',
      desc: 'Get instant, plain-language explanations of your calculation results, understand complex policy circulars, and learn the exact trade-offs before making permanent decisions.',
      cards: [
        { title: 'Explain Results', desc: 'Breaks down why surrender value differs from premiums paid.' },
        { title: 'Answer Policy Queries', desc: 'Clarifies loan interest, grace periods, and bonus vesting rules.' },
        { title: 'Input Identification', desc: 'Guides you on locating Sum Assured and Table numbers on bond papers.' },
        { title: 'Policy PDF Analysis', desc: 'Future capability to parse policy document statements securely.' }
      ]
    },
    plansSection: {
      badge: 'Reference Catalog',
      title: 'Popular LIC Plans & Table Numbers',
      desc: 'Browse major endowment, money back, whole life, and pension plans.',
      viewAll: 'View All Plans →',
      plans: [
        { tableNo: 914, name: 'New Endowment Plan', category: 'Endowment', minAge: 8, maxAge: 55, minTerm: 12, maxTerm: 35, slug: 'lic-premium-calculator/?plan=914' },
        { tableNo: 915, name: 'New Jeevan Anand', category: 'Endowment + Whole Life', minAge: 18, maxAge: 50, minTerm: 15, maxTerm: 35, slug: 'lic-premium-calculator/?plan=915' },
        { tableNo: 936, name: 'Jeevan Labh', category: 'Limited Premium', minAge: 8, maxAge: 59, minTerm: 16, maxTerm: 25, slug: 'lic-premium-calculator/?plan=936' },
        { tableNo: 945, name: 'Jeevan Umang', category: 'Whole Life 8% Survival', minAge: 0, maxAge: 55, minTerm: 15, maxTerm: 30, slug: 'lic-premium-calculator/?plan=945' },
        { tableNo: 855, name: 'Tech Term', category: 'Pure Term Cover', minAge: 18, maxAge: 65, minTerm: 10, maxTerm: 40, slug: 'lic-term-insurance-calculator' },
        { tableNo: 857, name: 'Saral Pension', category: 'Immediate Annuity', minAge: 40, maxAge: 80, minTerm: 1, maxTerm: 1, slug: 'lic-pension-calculator' }
      ],
      ageLabel: 'Entry Age:',
      termLabel: 'Policy Term:',
      yearsText: 'Yrs',
      openBtn: 'Open Premium Tool →'
    },
    howItWorks: {
      badge: 'Simple Process',
      title: 'How LIC Calculator Works',
      desc: 'Four quick steps to transparent, deterministic policy calculations.',
      steps: [
        { num: 1, title: 'Select Calculator', desc: 'Choose from Surrender Value, Premium, Maturity, Loan, or Bonus tools based on your goal.' },
        { num: 2, title: 'Enter Details', desc: 'Input basic parameters like age, sum assured, policy term, and completed premium years.' },
        { num: 3, title: 'Get Estimate', desc: 'Instant calculation computed via deterministic formulas and versioned actuarial tables.' },
        { num: 4, title: 'Decide & Compare', desc: 'Review detailed breakdowns, compare Surrender vs. Paid-Up options, and make informed choices.' }
      ]
    },
    guidesSection: {
      badge: 'Knowledge Base',
      title: 'Policy Guides & Explanations',
      desc: 'Clear, unbiased articles on policy lifecycle rules, surrender factors, and bonus additions.',
      allGuides: 'All Guides →',
      readGuide: 'Read Guide →',
      guides: [
        { badge: 'Surrender Guide', badgeType: 'warning', title: 'LIC Surrender Value Explained', desc: 'How Guaranteed Surrender Value (GSV) and Special Surrender Value (SSV) factors are determined.', link: '/lic-surrender-value-calculator' },
        { badge: 'Maturity Guide', badgeType: 'info', title: 'LIC Maturity Value Calculation', desc: 'How Simple Reversionary Bonuses and Final Additional Bonuses accumulate toward maturity.', link: '/lic-maturity-calculator' },
        { badge: 'Loan Guide', badgeType: 'default', title: 'LIC Policy Loan Rules & Rates', desc: 'Borrowing rules against policy surrender values, interest calculation, and repayment terms.', link: '/lic-loan-calculator' },
        { badge: 'Bonus Guide', badgeType: 'default', title: 'How LIC Annual Bonus Works', desc: 'Understanding actuarial valuation declarations per thousand sum assured for participating plans.', link: '/lic-bonus-calculator' }
      ]
    },
    faqSection: {
      badge: 'Got Questions?',
      title: 'Frequently Asked Questions',
      desc: 'Clear answers about LIC calculations, surrender value, and our independent platform.',
      faqs: [
        { q: 'What is an LIC surrender value?', a: 'Surrender value is the payable cash amount an insurance policyholder receives if they choose to terminate their policy before the completion of the contractual term. It is calculated as the higher of Guaranteed Surrender Value (GSV) and Special Surrender Value (SSV).' },
        { q: 'Can I calculate my LIC maturity value online?', a: 'Yes. For participating (with-profit) endowment policies, maturity value is estimated as: Basic Sum Assured + Total Accrued Simple Reversionary Bonuses + Final Additional Bonus (FAB if eligible).' },
        { q: 'Is this an official LIC website or calculator?', a: 'No. lic-calculators.com is an independent informational and calculation portal developed for educational financial planning. We have no affiliation, partnership, or authorization from Life Insurance Corporation of India (LIC). For official policy services, visit licindia.in.' },
        { q: 'Are calculator results exact?', a: 'Our tools use publicly declared tabular rates, standard modal rebates, and published bonus rates. However, final official settlement amounts are subject to LIC’s official underwriting records and prevailing government taxes (GST).' },
