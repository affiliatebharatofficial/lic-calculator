      desc: 'lic-calculators.com is an independent informational and calculation portal. It is NOT affiliated with, authorized by, or endorsed by the Life Insurance Corporation of India (LIC). All product names, logos, and brands are property of their respective owners.',
      linkText: 'Read Our Full Legal Disclaimer & Transparency Statement →'
    }
  }
};

const d = HOME_DATA[locale] || HOME_DATA.en;
---

<BaseLayout
  title={d.seoTitle}
  description={d.metaDesc}
  locale={locale}
  jsonLdType="WebSite"
>
  <!-- ==================================================
       SECTION 1: HERO & INSTANT CALCULATOR SEARCH
       ================================================== -->
  <section class="relative bg-gradient-to-b from-accent-50/40 via-slate-50 to-white py-12 sm:py-16 md:py-20 border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-accent-100 text-amber-950 text-xs font-bold mb-6 border border-accent-300 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-accent-500 animate-pulse"></span>
        {d.badge}
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-navy-800 tracking-tight max-w-4xl mx-auto leading-tight">
        {d.heroTitle} <span class="text-slate-900">{d.heroTitleHighlight}</span><span class="text-accent-500">.</span>
      </h1>

      <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        {d.heroSubtitle}
      </p>

      <!-- Interactive Live Search Bar in Hero -->
      <div class="mt-8 max-w-xl mx-auto">
        <CalculatorSearch variant="inline" placeholder={d.searchPlaceholder} locale={locale} />
      </div>

      <!-- Hero Call-to-Action Buttons -->
      <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-3.5">
        <Button variant="primary" size="lg" href={getLocalizedPath('/calculators/', locale)} class="w-full sm:w-auto shadow-sm">
          {d.exploreBtn}
        </Button>
        <Button
          variant="secondary"
          size="lg"
          href={getLocalizedPath('/lic-surrender-value-calculator/', locale)}
          class="w-full sm:w-auto border-accent-300 text-navy-800 hover:bg-accent-50 font-bold"
        >
          <span class="w-2 h-2 rounded-full bg-accent-500 mr-2"></span>
          {d.surrenderHeroBtn}
        </Button>
      </div>

      <!-- Microcopy Trust / Disclaimer -->
      <div class="mt-8 pt-6 border-t border-slate-200/60 max-w-xl mx-auto flex items-center justify-center gap-2 text-xs text-slate-400">
        <svg class="h-4 w-4 text-slate-400 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd" />
        </svg>
        <span>
          {d.trustMicrocopy}
        </span>
      </div>
    </div>
  </section>

  <!-- ==================================================
       SECTION 2: POPULAR CALCULATORS WITH VISUAL HIERARCHY
       ================================================== -->
  <section class="py-16 bg-slate-50/60 border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-amber-800">{d.exploreSectionBadge}</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-800 tracking-tight mt-1">
            {d.exploreSectionTitle}
          </h2>
          <p class="text-sm text-slate-500 mt-1">
            {d.exploreSectionSubtitle}
          </p>
        </div>
        <a href={getLocalizedPath('/calculators/', locale)} class="text-xs font-bold text-navy-800 hover:text-amber-700 mt-3 sm:mt-0 flex items-center gap-1">
          {d.viewAllCalculators}
        </a>
      </div>

      <!-- Asymmetrical Hierarchy Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Highlighted / Primary Tool: Surrender Value & Loss -->
        <div class="lg:col-span-6 flex flex-col">
          <div class="h-full bg-gradient-to-br from-accent-50/50 via-amber-50/20 to-white rounded-2xl border-2 border-accent-300 p-6 sm:p-8 shadow-card flex flex-col justify-between hover:border-accent-400 transition-all group">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <Badge type="warning" class="bg-accent-100 text-amber-950 font-bold border-accent-300">
                  {d.surrenderCard.badge}
                </Badge>
                <span class="text-xs font-bold text-amber-900">
                  {d.surrenderCard.subBadge}
                </span>
              </div>

              <h3 class="text-xl sm:text-2xl font-extrabold text-navy-800 group-hover:text-amber-900 transition-colors">
                {d.surrenderCard.title}
              </h3>

              <p class="text-sm text-slate-700 leading-relaxed">
                {d.surrenderCard.desc}
              </p>

              <div class="grid grid-cols-2 gap-3 pt-2">
                <div class="p-3 bg-white rounded-xl border border-accent-200">
                  <span class="text-[10px] text-slate-500 block uppercase font-medium">{d.surrenderCard.calcTitle}</span>
                  <span class="text-xs font-bold text-navy-800">{d.surrenderCard.calcVal}</span>
                </div>
                <div class="p-3 bg-white rounded-xl border border-accent-200">
                  <span class="text-[10px] text-slate-500 block uppercase font-medium">{d.surrenderCard.lossTitle}</span>
                  <span class="text-xs font-bold text-rose-700">{d.surrenderCard.lossVal}</span>
                </div>
              </div>
            </div>

            <div class="mt-6 pt-5 border-t border-accent-200 flex items-center justify-between">
              <span class="text-xs font-bold text-amber-950 group-hover:underline">
                {d.surrenderCard.actionText}
              </span>
              <a
                href={getLocalizedPath('/lic-surrender-value-calculator/', locale)}
                class="inline-flex items-center justify-center px-4 py-2 rounded-xl text-xs font-bold text-navy-800 bg-accent-500 hover:bg-accent-600 active:bg-accent-700 transition-colors shadow-sm border border-accent-600/30"
              >
                {d.surrenderCard.btnText}
              </a>
            </div>
          </div>
        </div>

        <!-- Secondary Calculators Grid (4 Tools) -->
        <div class="lg:col-span-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {
            d.gridTools.map((tool) => (
              <a
                href={getLocalizedPath(`/${tool.slug}`, locale)}
                class="p-5 bg-white rounded-xl border border-slate-200/90 shadow-card hover:border-accent-400 hover:shadow-card-hover transition-all group flex flex-col justify-between"
              >
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">{tool.category}</span>
                    <Badge type="default">{tool.badge}</Badge>
                  </div>
                  <h4 class="text-sm font-bold text-navy-800 group-hover:text-amber-700 transition-colors">
                    {tool.title}
                  </h4>
                  <p class="text-xs text-slate-500 mt-1 line-clamp-2">
                    {tool.desc}
                  </p>
                </div>
                <div class="mt-3 pt-3 border-t border-slate-100 text-xs font-bold text-navy-800 group-hover:text-amber-700 flex justify-between">
                  <span>{d.surrenderCard.calcTitle}</span>
                  <span>&rarr;</span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ==================================================
       SECTION 3: CALCULATOR FINDER INTERACTIVE UI
       ================================================== -->
  <section class="py-16 bg-white border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <CalculatorFinder locale={locale} />
    </div>
  </section>

  <!-- ==================================================
       SECTION 4: SURRENDER FEATURE SPOTLIGHT
       ================================================== -->
  <section class="py-16 bg-gradient-to-br from-accent-50/30 via-slate-50 to-white border-b border-accent-200/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-4">
          <Badge type="warning" class="bg-accent-100 text-amber-950 font-bold border-accent-300">{d.surrenderDeepDive.badge}</Badge>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-navy-800 tracking-tight">
            {d.surrenderDeepDive.title}
          </h2>
          <p class="text-sm sm:text-base text-slate-700 leading-relaxed">
            {d.surrenderDeepDive.desc}
          </p>

          <div class="space-y-2.5 pt-2 text-xs sm:text-sm text-slate-800">
            {
              d.surrenderDeepDive.bullets.map((b) => (
                <div class="flex items-start gap-2.5">
                  <span class="text-emerald-600 font-bold">✓</span>
                  <span><strong>{b.title}</strong> {b.desc}</span>
                </div>
              ))
            }
          </div>

          <div class="pt-4 flex flex-wrap items-center gap-3">
            <Button variant="primary" href={getLocalizedPath('/lic-surrender-value-calculator/', locale)}>
              {d.surrenderDeepDive.calcBtn}
            </Button>
            <Button variant="secondary" href={getLocalizedPath('/lic-surrender-loss-calculator/', locale)} class="border-slate-300 text-navy-800 hover:bg-slate-100">
              {d.surrenderDeepDive.lossBtn}
            </Button>
          </div>
        </div>

        <!-- Preview UI Box (Illustration Only) -->
        <div class="lg:col-span-5">
          <div class="rounded-2xl bg-navy-950 p-6 sm:p-7 text-white shadow-2xl border border-slate-800 space-y-4 relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1 bg-accent-500"></div>
            <div class="flex items-center justify-between border-b border-slate-800 pb-3">
              <span class="text-xs font-bold uppercase tracking-wider text-accent-400">
                {d.surrenderDeepDive.previewTitle}
              </span>
              <span class="text-[10px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded border border-slate-700 font-medium">
                {d.surrenderDeepDive.previewBadge}
              </span>
            </div>

            <div class="space-y-3 font-mono text-xs sm:text-sm">
              <div class="flex justify-between py-2 border-b border-slate-800/80">
                <span class="text-slate-400">{d.surrenderDeepDive.paidLabel}</span>
                <span class="font-bold text-white">{d.surrenderDeepDive.paidVal}</span>
              </div>
              <div class="flex justify-between py-2 border-b border-slate-800/80">
                <span class="text-slate-400">{d.surrenderDeepDive.payoutLabel}</span>
                <span class="font-bold text-emerald-400">{d.surrenderDeepDive.payoutVal}</span>
              </div>
              <div class="flex justify-between py-2 border-b border-slate-800/80">
                <span class="text-slate-400">{d.surrenderDeepDive.lossLabel}</span>
                <span class="font-bold text-rose-400">{d.surrenderDeepDive.lossVal}</span>
              </div>
              <div class="flex justify-between py-2 border-b border-slate-800/80">
                <span class="text-slate-400">{d.surrenderDeepDive.paidUpLabel}</span>
                <span class="font-bold text-accent-300">{d.surrenderDeepDive.paidUpVal}</span>
              </div>
            </div>

            <p class="text-[11px] text-slate-400 italic leading-snug pt-1">
              {d.surrenderDeepDive.previewNote}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================================================
       SECTION 5: AI ASSISTANT SPOTLIGHT
       ================================================== -->
  <section class="py-16 bg-slate-50/60 border-b border-slate-200/80" id="ai-assistant">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-6 space-y-4">
          <Badge type="info">{d.aiSection.badge}</Badge>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-navy-800 tracking-tight">
            {d.aiSection.title}
          </h2>
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
            {d.aiSection.desc}
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
            {
              d.aiSection.cards.map((card) => (
                <div class="p-3.5 bg-white rounded-xl border border-slate-200 hover:border-accent-300 transition-colors">
                  <h4 class="text-xs font-bold text-navy-800 mb-1">{card.title}</h4>
                  <p class="text-[11px] text-slate-500">{card.desc}</p>
                </div>
              ))
            }
          </div>
        </div>

        <div class="lg:col-span-6">
          <AIChatPanel locale={locale} />
        </div>
      </div>
    </div>
  </section>

  <!-- ==================================================
       SECTION 6: POPULAR LIC PLANS BROWSABLE CATALOG
       ================================================== -->
  <section class="py-16 bg-white border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-amber-800">{d.plansSection.badge}</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-800 tracking-tight mt-1">
            {d.plansSection.title}
          </h2>
          <p class="text-sm text-slate-500 mt-1">
            {d.plansSection.desc}
          </p>
        </div>
        <a href={getLocalizedPath('/plans/', locale)} class="text-xs font-bold text-navy-800 hover:text-amber-700 mt-3 sm:mt-0">
          {d.plansSection.viewAll}
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          d.plansSection.plans.map((plan) => (
            <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-card hover:border-accent-400 hover:shadow-card-hover transition-all flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="font-mono text-xs font-bold text-amber-950 bg-accent-50 px-2 py-0.5 rounded border border-accent-200">
                    Table {plan.tableNo}
                  </span>
                  <Badge type="default">{plan.category}</Badge>
                </div>
                <h3 class="text-base font-bold text-navy-800 mt-1">
                  {plan.name}
                </h3>
                <div class="mt-3 pt-3 border-t border-slate-100 space-y-1 text-xs text-slate-600">
                  <div class="flex justify-between">
                    <span class="text-slate-400">{d.plansSection.ageLabel}</span>
                    <span class="font-semibold text-slate-800">{plan.minAge} - {plan.maxAge} {d.plansSection.yearsText}</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-slate-400">{d.plansSection.termLabel}</span>
                    <span class="font-semibold text-slate-800">{plan.minTerm} - {plan.maxTerm} {d.plansSection.yearsText}</span>
                  </div>
                </div>
              </div>

              <div class="mt-4 pt-3 border-t border-slate-100">
                <a
                  href={getLocalizedPath(`/${plan.slug}`, locale)}
                  class="text-xs font-bold text-navy-800 hover:text-amber-700 flex items-center justify-between"
                >
                  <span>{d.plansSection.openBtn}</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ==================================================
       SECTION 7: HOW IT WORKS (4-STEP FLOW)
       ================================================== -->
  <section class="py-16 bg-slate-50/60 border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-xs font-bold uppercase tracking-wider text-amber-800">{d.howItWorks.badge}</span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-800 tracking-tight mt-1">
        {d.howItWorks.title}
      </h2>
      <p class="text-sm text-slate-500 mt-2 max-w-xl mx-auto">
        {d.howItWorks.desc}
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-12 text-left">
        {
          d.howItWorks.steps.map((s) => (
            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-card relative">
              <div class="w-9 h-9 rounded-xl bg-navy-800 text-accent-400 border border-navy-700 flex items-center justify-center font-extrabold text-sm mb-4 shadow-sm">
                {s.num}
              </div>
              <h3 class="text-base font-bold text-navy-800 mb-1.5">{s.title}</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                {s.desc}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ==================================================
       SECTION 8: GUIDES & RESOURCES
       ================================================== -->
  <section class="py-16 bg-white border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-amber-800">{d.guidesSection.badge}</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-800 tracking-tight mt-1">
            {d.guidesSection.title}
          </h2>
          <p class="text-sm text-slate-500 mt-1">
            {d.guidesSection.desc}
          </p>
        </div>
        <a href={getLocalizedPath('/guides/', locale)} class="text-xs font-bold text-navy-800 hover:text-amber-700 mt-3 sm:mt-0">
          {d.guidesSection.allGuides}
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        {
          d.guidesSection.guides.map((g) => (
            <div class="bg-slate-50 rounded-xl p-5 border border-slate-200 hover:border-accent-300 transition-all flex flex-col justify-between">
              <div>
                <Badge type={g.badgeType} class="mb-2">{g.badge}</Badge>
                <h3 class="text-sm font-bold text-navy-800 mb-2">{g.title}</h3>
                <p class="text-xs text-slate-600 leading-relaxed">
                  {g.desc}
                </p>
              </div>
              <a href={getLocalizedPath(g.link, locale)} class="text-xs font-bold text-navy-800 hover:text-amber-700 mt-4 pt-3 border-t border-slate-200">
                {d.guidesSection.readGuide}
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ==================================================
       SECTION 9: FAQ ACCORDION
       ================================================== -->
  <section class="py-16 bg-slate-50/60 border-b border-slate-200/80">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-800">{d.faqSection.badge}</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-800 tracking-tight mt-1">
          {d.faqSection.title}
        </h2>
        <p class="text-sm text-slate-500 mt-2">
          {d.faqSection.desc}
        </p>
      </div>

      <Accordion>
        {
          d.faqSection.faqs.map((faq, index) => (
            <AccordionItem title={faq.q} open={index === 0}>
              <p>{faq.a}</p>
            </AccordionItem>
          ))
        }
      </Accordion>
    </div>
  </section>

  <!-- ==================================================
       SECTION 10: TRUST & INDEPENDENCE DISCLAIMER BLOCK
       ================================================== -->
  <section class="py-14 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl bg-slate-50 border border-slate-200/90 p-6 sm:p-8 text-center space-y-4 relative overflow-hidden">
        <div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-accent-100 text-amber-950 font-bold text-base mb-1 border border-accent-300">
          ℹ
        </div>
        <h3 class="text-lg sm:text-xl font-bold text-navy-800">
          {d.disclaimer.title}
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 max-w-2xl mx-auto leading-relaxed">
          {d.disclaimer.desc}
        </p>
        <div class="pt-2">
          <a
            href={getLocalizedPath('/disclaimer/', locale)}
            class="text-xs font-bold text-navy-800 hover:text-amber-800 underline"
          >
            {d.disclaimer.linkText}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
