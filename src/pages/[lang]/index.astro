      payoutLabel: 'Est. Cash Payout (SSV):',
      payoutVal: '₹1,65,000',
      lossLabel: 'Net Estimated Loss:',
      lossVal: '-₹1,35,000 (45%)',
      paidUpLabel: 'Paid-Up Cover Available:',
      paidUpVal: '₹2,50,000 Cover',
