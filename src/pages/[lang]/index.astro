---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import { ALL_CALCULATORS } from '@/lib/calculators/registry';
import { LOCALE_CODES, DEFAULT_LOCALE, t, getLocalizedPath } from '@/lib/i18n';
import type { Locale } from '@/types/i18n';

export function getStaticPaths() {
  return LOCALE_CODES.filter((l) => l !== DEFAULT_LOCALE).map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
const locale = (lang as Locale) || DEFAULT_LOCALE;
---

<BaseLayout
  title={`${t(locale, 'site.name')} - ${t(locale, 'site.tagline')}`}
  description={t(locale, 'site.description')}
  locale={locale}
  jsonLdType="WebSite"
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-brand-50/70 via-slate-50 to-white py-12 sm:py-20 border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-100 text-brand-800 text-xs font-semibold mb-6">
        <span class="w-2 h-2 rounded-full bg-brand-600"></span>
        Fast • Transparent • Multilingual
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight max-w-4xl mx-auto leading-tight sm:leading-none">
        {t(locale, 'home.heroTitle')}
      </h1>

      <p class="mt-5 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        {t(locale, 'home.heroSubtitle')}
      </p>

      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button variant="primary" size="lg" href={getLocalizedPath('/calculators', locale)}>
          {t(locale, 'home.exploreCalculators')}
        </Button>
        <Button variant="secondary" size="lg" href={getLocalizedPath('/lic-surrender-value-calculator', locale)} class="border-amber-300 hover:bg-amber-50/40 text-amber-900">
          {t(locale, 'home.calculateSurrender')}
        </Button>
      </div>

      <p class="mt-6 text-xs text-slate-500 max-w-xl mx-auto">
        <strong>{t(locale, 'disclaimer.notice')}:</strong> {t(locale, 'disclaimer.shortText')}
      </p>
    </div>
  </section>

  <!-- Popular Calculators Section -->
  <section class="py-14 bg-slate-50/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
            {t(locale, 'home.featuredCalculators')}
          </h2>
          <p class="text-sm text-slate-500 mt-1">
            {t(locale, 'home.featuredSubtitle')}
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          ALL_CALCULATORS.filter((c) => c.isAvailable).slice(0, 6).map((calc) => (
            <a href={getLocalizedPath(`/${calc.slug}`, locale)} class="group block">
              <div class="h-full bg-white rounded-xl border border-slate-200/90 p-6 shadow-card hover:shadow-card-hover transition-all hover:border-brand-300 flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between mb-3">
                    <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-brand-50 text-brand-700 font-bold group-hover:bg-brand-600 group-hover:text-white transition-colors text-sm">
                      #
                    </span>
                    <Badge type="default">{calc.category}</Badge>
                  </div>
                  <h3 class="text-base font-bold text-slate-900 group-hover:text-brand-700 transition-colors">
                    {t(locale, calc.titleKey)}
                  </h3>
                  <p class="text-xs text-slate-500 mt-2 line-clamp-2">
                    {t(locale, calc.descriptionKey)}
                  </p>
                </div>
                <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-brand-700">
                  <span>{t(locale, 'common.calculate')}</span>
                  <span>&rarr;</span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
