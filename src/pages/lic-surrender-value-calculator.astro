---
import CalculatorShell from '@/components/calculator/CalculatorShell.astro';
import PlanSelector from '@/components/calculator/PlanSelector.astro';
import CurrencyInput from '@/components/calculator/CurrencyInput.astro';
import RangeInput from '@/components/calculator/RangeInput.astro';
import CalculateButton from '@/components/calculator/CalculateButton.astro';
import ResetButton from '@/components/calculator/ResetButton.astro';
import ResultCard from '@/components/ui/ResultCard.astro';
import ResultBreakdown from '@/components/calculator/ResultBreakdown.astro';
import CalculationExplanation from '@/components/calculator/CalculationExplanation.astro';
import RelatedCalculatorCard from '@/components/calculator/RelatedCalculatorCard.astro';
import AIExplanationCard from '@/components/ai/AIExplanationCard.astro';
import { CALCULATOR_SEO_DATA } from '@/lib/seo/calculator-content';

const seoData = CALCULATOR_SEO_DATA['lic-surrender-value-calculator'];

const breadcrumbs = [
  { name: 'Calculators', url: '/calculators' },
  { name: 'Surrender Value Calculator', url: '/lic-surrender-value-calculator' }
];

const breakdownItems = [
  { id: '1', label: 'Total Premiums Paid So Far', amount: '₹1,25,000', notes: '5 years of premium payments' },
  { id: '2', label: 'Guaranteed Surrender Value (GSV @ 50%)', amount: '₹50,000', notes: 'Guaranteed percentage of eligible premiums' },
  { id: '3', label: 'Special Surrender Value (SSV @ 55% of Paid-Up)', amount: '₹68,750', notes: 'Actuarial discounted paid-up value (Higher & Payable)' }
];

const relatedTools = [
  {
    title: 'Surrender Loss Calculator',
    description: 'Quantify your capital shortfall and loss percentage if you surrender today.',
    url: '/lic-surrender-loss-calculator',
    category: 'Surrender'
  },
  {
    title: 'Advanced Surrender Decision Analysis',
    description: '3-way numerical comparison: Surrender Now vs. Make Paid-Up vs. Continue.',
    url: '/lic-surrender-analysis',
    category: 'Decision'
  },
  {
    title: 'Policy Loan Calculator',
    description: 'Borrow up to 90% of your surrender value instead of terminating the policy.',
    url: '/lic-loan-calculator',
    category: 'Liquidity'
  }
];
---

<CalculatorShell
  title={seoData.seoTitle}
  description={seoData.metaDescription}
  calculatorTitle={seoData.h1}
  calculatorSubtitle={seoData.subtitle}
  category={seoData.category}
  lastReviewedDate={seoData.lastReviewedDate}
  sources={seoData.sources}
  faqs={seoData.faqs}
  breadcrumbs={breadcrumbs}
>
  <!-- Form Inputs Slot -->
  <div slot="inputs" class="bg-white rounded-2xl border border-slate-200/90 p-6 sm:p-7 shadow-card">
    <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-6">
      <h2 class="text-base font-bold text-slate-900">Policy Surrender Parameters</h2>
      <ResetButton />
    </div>

    <div id="calc-error-banner" class="hidden mb-5 p-3.5 rounded-xl bg-rose-50 border border-rose-200/80 text-rose-700 text-xs font-semibold" role="alert"></div>

    <form id="lic-surrender-form" class="space-y-5">
      <PlanSelector
        id="planTableNo"
        name="planTableNo"
        label="Select LIC Plan"
        defaultValue={914}
        required
      />

      <CurrencyInput
        id="sumAssured"
        name="sumAssured"
        label="Original Sum Assured"
        min={100000}
        max={100000000}
        step={25000}
        value={500000}
        required
      />

      <RangeInput
        id="policyTerm"
        name="policyTerm"
        label="Original Policy Term"
        min={12}
        max={35}
        step={1}
        value={20}
        unit="Years"
        required
      />

      <RangeInput
        id="completedYears"
        name="completedYears"
        label="Completed Years of Premium Paid"
        min={1}
        max={35}
        step={1}
        value={5}
        unit="Years"
        required
        helpText="Minimum 2 years required to acquire surrender cash value."
      />

      <CurrencyInput
        id="totalPremiumsPaid"
        name="totalPremiumsPaid"
        label="Total Premiums Paid (Excl. GST)"
        min={1000}
        max={50000000}
        step={5000}
        value={125000}
        required
      />

      <div class="pt-2">
        <CalculateButton text="Calculate Surrender Value" />
      </div>
    </form>
  </div>

  <!-- Results Slot -->
  <div slot="results" id="calc-result-container">
    <div class="space-y-4">
      <ResultCard
        headline="Estimated Cash Surrender Payout"
        amount="₹68,750"
        subtitle="Special Surrender Value (SSV) applies as it is higher than GSV (₹50,000)"
        stats={[
          { label: 'Total Paid So Far', value: '₹1,25,000' },
          { label: 'Guaranteed (GSV)', value: '₹50,000' },
          { label: 'Special (SSV)', value: '₹68,750' },
          { label: 'Paid-Up Sum Assured', value: '₹1,25,000' }
        ]}
      />

      <div id="calc-rule-source-badge" class="text-xs text-slate-500 bg-slate-50 border border-slate-200/60 p-2.5 rounded-xl text-center">
        Rule Version: SYNTHETIC_2024.1 (Verified Rule Set Table 914)
      </div>

      <button
        type="button"
        id="explain-ai-btn"
        class="w-full py-2.5 px-4 bg-gradient-to-r from-brand-600 to-indigo-600 hover:from-brand-700 hover:to-indigo-700 text-white font-bold text-xs rounded-xl shadow-sm hover:shadow transition-all flex items-center justify-center gap-2 cursor-pointer"
      >
        <span>✨</span>
        <span>Explain this surrender value with AI</span>
      </button>

      <AIExplanationCard calculatorId="lic-surrender-value-calculator" />
    </div>
  </div>

  <!-- Bottom Slots -->
  <div slot="breakdown">
    <ResultBreakdown
      title="Surrender Value Comparison Breakdown"
      subtitle="Comparing GSV vs SSV for 5 completed years on Table 914"
      items={breakdownItems}
      totalLabel="Payable Cash Surrender Value"
      totalAmount="₹68,750"
    />
  </div>

  <div slot="explanation">
    <CalculationExplanation
      title={seoData.howItWorks.title}
      steps={seoData.howItWorks.steps}
      notes={seoData.assumptionsAndLimitations.notes}
    />
  </div>

  <div slot="related">
    <RelatedCalculatorCard tools={relatedTools} />
  </div>
</CalculatorShell>

<div id="calc-live-announcer" class="sr-only" aria-live="polite"></div>

<script>
  import { initCalculatorForm } from '@/lib/client/calculator-client';

  document.addEventListener('DOMContentLoaded', () => {
    initCalculatorForm({
      formId: 'lic-surrender-form',
      apiEndpoint: '/api/calculators/surrender',
      calculatorId: 'lic-surrender-value-calculator',
      calculatorName: 'LIC Surrender Value Calculator'
    });
  });
</script>
