const articleSchema = StructuredDataGenerator.generateArticle({
  headline: 'LIC Complaint Not Resolved? The IGMS → Bima Bharosa → Insurance Ombudsman Route',
  description: 'If LIC has not resolved your complaint, the escalation ladder is fixed: written complaint to LIC first (30 days), then IRDAI Bima Bharosa, then the free Insurance Ombudsman for disputes up to ₹50 lakh — filed within one year of LIC\'s final reply. Steps, documents, timelines and the mistakes that kill a case.',
