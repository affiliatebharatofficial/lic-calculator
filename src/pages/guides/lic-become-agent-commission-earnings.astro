const author = AuthorManager.getDefaultAuthor();
const reviewer = AuthorManager.getDefaultReviewer();

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Educational Guides', url: '/guides/' },
  { name: 'How to Become a LIC Agent', url: '/guides/lic-become-agent-commission-earnings' }
];

const articleSchema = StructuredDataGenerator.generateArticle({
  headline: 'How to Become a LIC Agent in India — Eligibility, Exam & What Agents Actually Earn (2026)',
  description: 'No salary, no degree needed, no upper age limit — but also no fixed income. A LIC agent is a licensed, commission-only intermediary: 18+ age, 10th pass (rural) / 12th pass (urban), 25 hours of IRDAI training, the IC38 exam, and an appointment from LIC. First-year commission is 25% on long endowment plans (35% with bonus), 7.5% in years 2–3 and 5% after — and under IRDAI\'s 2024 EOM Regulations there are no fixed national slabs anymore, so the branch\'s current circular is final.',
  url: `${siteUrl}/guides/lic-become-agent-commission-earnings`,
  publishedDate: '2026-11-22T00:00:00Z',
