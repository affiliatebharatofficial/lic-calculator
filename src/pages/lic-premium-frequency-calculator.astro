---
import CalculatorShell from '@/components/calculator/CalculatorShell.astro';
import CurrencyInput from '@/components/calculator/CurrencyInput.astro';
import CalculateButton from '@/components/calculator/CalculateButton.astro';
import ResetButton from '@/components/calculator/ResetButton.astro';
import ResultCard from '@/components/ui/ResultCard.astro';
import ResultBreakdown from '@/components/calculator/ResultBreakdown.astro';
import CalculationExplanation from '@/components/calculator/CalculationExplanation.astro';
import RelatedCalculatorCard from '@/components/calculator/RelatedCalculatorCard.astro';
import { CALCULATOR_SEO_DATA } from '@/lib/seo/calculator-content';

const seoData = CALCULATOR_SEO_DATA['lic-premium-frequency-calculator'];

const breadcrumbs = [
  { name: 'Calculators', url: '/calculators/' },
  { name: 'Premium Mode & Frequency Calculator', url: '/lic-premium-frequency-calculator/' }
];

const breakdownItems = [
  { id: '1', label: 'Yearly Mode (2% Rebate) + 2.25% Renewal GST', amount: '₹49,000 / yr', isCredit: true, notes: 'Most economical' },
  { id: '2', label: 'Half-Yearly Mode (1% Rebate) + 2.25% Renewal GST', amount: '₹24,750 / half-yr', isCredit: false, notes: '₹49,500 annualized' },
  { id: '3', label: 'Quarterly Mode (No Rebate) + 2.25% Renewal GST', amount: '₹12,500 / qtr', isCredit: false, notes: '₹50,000 annualized' },
  { id: '4', label: 'Monthly NACH Mode + 2.25% Renewal GST', amount: '₹4,167 / month', isCredit: false, notes: '₹50,004 annualized' }
];

const relatedTools = [
  {
    title: 'Premium Calculator',
    description: 'Calculate full premiums with policy age and sum assured parameters.',
    url: '/lic-premium-calculator/',
    category: 'Premium'
  },
  {
    title: 'Maturity Calculator',
    description: 'Estimate final maturity payout for your policy.',
    url: '/lic-maturity-calculator/',
    category: 'Maturity'
  }
];
---

<CalculatorShell
  title={seoData.seoTitle}
  description={seoData.metaDescription}
  calculatorTitle={seoData.h1}
  calculatorSubtitle={seoData.subtitle}
  category={seoData.category}
  lastReviewedDate={seoData.lastReviewedDate}
  sources={seoData.sources}
  faqs={seoData.faqs}
  breadcrumbs={breadcrumbs}
>
  <div slot="inputs" class="bg-white rounded-2xl border border-slate-200/90 p-6 sm:p-7 shadow-card">
    <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-6">
      <h2 class="text-base font-bold text-slate-900">Base Premium Input</h2>
      <ResetButton />
    </div>

    <form class="space-y-5" id="frequencyForm">
      <CurrencyInput
        id="annualBasePremium"
        name="annualBasePremium"
        label="Annual Base Premium (Excl. GST)"
        value={50000}
        placeholder="e.g. 50000"
        min={1000}
        required
        helpText="Tabular annual base premium before taxes"
      />
      <div class="pt-2">
        <CalculateButton text="Compare All Payment Modes" />
      </div>
    </form>
  </div>

  <div slot="results">
    <ResultCard
      headline="Annual Savings via Yearly Mode"
      amount="₹1,004 / year"
      subtitle="Yearly (2% Rebate) vs Monthly NACH Mode over 20 Years Saves ₹20,080"
      stats={[
        { label: 'Yearly Installment', value: '₹49,000 / yr' },
        { label: 'Half-Yearly', value: '₹24,750 / 6m' },
        { label: 'Quarterly', value: '₹12,500 / 3m' },
        { label: 'Monthly NACH', value: '₹4,167 / mo' }
      ]}
    />
  </div>

  <div slot="breakdown">
    <ResultBreakdown
      title="Installment & Modal Rebate Comparison"
      items={breakdownItems}
      totalLabel="Optimal Payment Mode"
      totalAmount="Yearly (Save 2%)"
      summaryNotes="Modal rebates reduce long-term policy cost significantly."
    />
  </div>

  <div slot="explanation">
    <CalculationExplanation
      howItWorks={seoData.howItWorks}
      inputsGuide={seoData.inputsGuide}
      resultsGuide={seoData.resultsGuide}
      assumptions={seoData.assumptionsAndLimitations}
    />
  </div>

  <div slot="related">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {relatedTools.map((tool) => (
        <RelatedCalculatorCard {...tool} />
      ))}
    </div>
  </div>
</CalculatorShell>
