---
import CalculatorShell from '@/components/calculator/CalculatorShell.astro';
import PlanSelector from '@/components/calculator/PlanSelector.astro';
import CurrencyInput from '@/components/calculator/CurrencyInput.astro';
import RangeInput from '@/components/calculator/RangeInput.astro';
import CalculateButton from '@/components/calculator/CalculateButton.astro';
import ResetButton from '@/components/calculator/ResetButton.astro';
import ResultCard from '@/components/ui/ResultCard.astro';
import ResultBreakdown from '@/components/calculator/ResultBreakdown.astro';
import CalculationExplanation from '@/components/calculator/CalculationExplanation.astro';
import RelatedCalculatorCard from '@/components/calculator/RelatedCalculatorCard.astro';
import AIExplanationCard from '@/components/ai/AIExplanationCard.astro';
import { CALCULATOR_SEO_DATA } from '@/lib/seo/calculator-content';

const seoData = CALCULATOR_SEO_DATA['lic-maturity-calculator'];

const breadcrumbs = [
  { name: 'Calculators', url: '/calculators/' },
  { name: 'Maturity Calculator', url: '/lic-maturity-calculator/' }
];

const breakdownItems = [
  { id: '1', label: 'Basic Sum Assured (Guaranteed)', amount: '₹5,00,000', notes: 'Guaranteed base life cover payout' },
  { id: '2', label: 'Simple Reversionary Bonus (20 Yrs @ ₹42/th)', amount: '₹4,20,000', isCredit: true, notes: 'Accrued annual bonus' },
  { id: '3', label: 'Final Additional Bonus (FAB @ ₹70/th)', amount: '₹35,000', isCredit: true, notes: 'Terminal loyalty bonus for term >= 15 yrs' }
];

const relatedTools = [
  {
    title: 'Bonus Calculator',
    description: 'Explore yearly bonus rates and accrual mechanics in depth.',
    url: '/lic-bonus-calculator/',
    category: 'Bonus'
  },
  {
    title: 'Premium Calculator',
    description: 'Calculate the annual premium required for this maturity sum.',
    url: '/lic-premium-calculator/',
    category: 'Premium'
  },
  {
    title: 'Surrender Value Calculator',
    description: 'Compare maturity proceeds with early surrender payout.',
    url: '/lic-surrender-value-calculator/',
    category: 'Surrender'
  }
];
---

<CalculatorShell
  title={seoData.seoTitle}
  description={seoData.metaDescription}
  calculatorTitle={seoData.h1}
  calculatorSubtitle={seoData.subtitle}
  category={seoData.category}
  lastReviewedDate={seoData.lastReviewedDate}
  sources={seoData.sources}
  faqs={seoData.faqs}
  breadcrumbs={breadcrumbs}
>
  <!-- Form Inputs Slot -->
  <div slot="inputs" class="bg-white rounded-2xl border border-slate-200/90 p-6 sm:p-7 shadow-card">
    <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-6">
      <h2 class="text-base font-bold text-slate-900">Maturity Parameters</h2>
      <ResetButton />
    </div>

    <div id="calc-error-banner" class="hidden mb-5 p-3.5 rounded-xl bg-rose-50 border border-rose-200/80 text-rose-700 text-xs font-semibold" role="alert"></div>

    <form id="lic-maturity-form" class="space-y-5">
      <PlanSelector
        id="planTableNo"
        name="planTableNo"
        label="Select LIC Plan"
        defaultValue={914}
        required
      />

      <CurrencyInput
        id="sumAssured"
        name="sumAssured"
        label="Sum Assured (Life Cover)"
        min={100000}
        max={100000000}
        step={25000}
        value={500000}
        required
      />

      <RangeInput
        id="policyTerm"
        name="policyTerm"
        label="Policy Term"
        min={12}
        max={35}
        step={1}
        value={20}
        unit="Years"
        required
      />

      <RangeInput
        id="age"
        name="age"
        label="Entry Age"
        min={8}
        max={55}
        step={1}
        value={30}
        unit="Years"
        required
      />

      <div class="pt-2">
        <CalculateButton text="Calculate Maturity Proceeds" />
      </div>
    </form>
  </div>

  <!-- Results Slot -->
  <div slot="results" id="calc-result-container">
    <div class="space-y-4">
      <ResultCard
        headline="Estimated Total Maturity Proceeds"
        amount="₹9,55,000"
        subtitle="Includes Basic Sum Assured + 20 Years Vested Bonus + Final Additional Bonus (FAB)"
        stats={[
          { label: 'Sum Assured', value: '₹5,00,000' },
          { label: 'Vested Bonus', value: '₹4,20,000' },
          { label: 'FAB Addition', value: '₹35,000' },
          { label: 'Policy Term', value: '20 Years' }
        ]}
      />

      <div id="calc-rule-source-badge" class="text-xs text-slate-500 bg-slate-50 border border-slate-200/60 p-2.5 rounded-xl text-center">
        Rule Version: SYNTHETIC_2024.1 (Verified Rule Set Table 914)
      </div>

      <button
        type="button"
        id="explain-ai-btn"
        class="w-full py-2.5 px-4 bg-gradient-to-r from-brand-600 to-indigo-600 hover:from-brand-700 hover:to-indigo-700 text-white font-bold text-xs rounded-xl shadow-sm hover:shadow transition-all flex items-center justify-center gap-2 cursor-pointer"
      >
        <span>✨</span>
        <span>Explain this maturity result with AI</span>
      </button>

      <AIExplanationCard calculatorId="lic-maturity-calculator" />
    </div>
  </div>

  <!-- Bottom Slots -->
  <div slot="breakdown">
    <ResultBreakdown
      title="Estimated Maturity Benefit Breakdown"
      subtitle="Component breakdown for ₹5,00,000 Sum Assured under Table 914"
      items={breakdownItems}
      totalLabel="Total Estimated Lump-Sum Payout"
      totalAmount="₹9,55,000"
    />
  </div>

  <div slot="explanation">
    <CalculationExplanation
      title={seoData.howItWorks.title}
      steps={seoData.howItWorks.steps}
      notes={seoData.assumptionsAndLimitations.notes}
    />
  </div>

  <div slot="related">
    <RelatedCalculatorCard tools={relatedTools} />
  </div>
</CalculatorShell>

<div id="calc-live-announcer" class="sr-only" aria-live="polite"></div>

<script>
  import { initCalculatorForm } from '@/lib/client/calculator-client';

  document.addEventListener('DOMContentLoaded', () => {
    initCalculatorForm({
      formId: 'lic-maturity-form',
      apiEndpoint: '/api/calculators/maturity',
      calculatorId: 'lic-maturity-calculator',
      calculatorName: 'LIC Maturity Calculator'
    });
  });
</script>
