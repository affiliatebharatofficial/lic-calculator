---
import CalculatorShell from '@/components/calculator/CalculatorShell.astro';
import CurrencyInput from '@/components/calculator/CurrencyInput.astro';
import RangeInput from '@/components/calculator/RangeInput.astro';
import CalculateButton from '@/components/calculator/CalculateButton.astro';
import ResetButton from '@/components/calculator/ResetButton.astro';
import ResultCard from '@/components/ui/ResultCard.astro';
import ResultBreakdown from '@/components/calculator/ResultBreakdown.astro';
import CalculationExplanation from '@/components/calculator/CalculationExplanation.astro';
import RelatedCalculatorCard from '@/components/calculator/RelatedCalculatorCard.astro';
import { CALCULATOR_SEO_DATA } from '@/lib/seo/calculator-content';

const seoData = CALCULATOR_SEO_DATA['lic-paid-up-calculator'];

const breadcrumbs = [
  { name: 'Calculators', url: '/calculators/' },
  { name: 'Paid-Up Value Calculator', url: '/lic-paid-up-calculator/' }
];

const breakdownItems = [
  { id: '1', label: 'Original Basic Sum Assured', amount: '₹10,00,000', notes: 'Initial life cover' },
  { id: '2', label: 'Reduced Paid-Up Sum Assured (5/20 PPT Paid)', amount: '₹2,50,000', isCredit: true, notes: 'Proportionate cover' },
  { id: '3', label: 'Vested Simple Reversionary Bonuses (5 Yrs)', amount: '₹2,30,000', isCredit: true, notes: 'Preserved bonus' }
];

const relatedTools = [
  {
    title: 'Surrender Value Calculator',
    description: 'Compare what you would receive if you surrender immediately instead of making it paid-up.',
    url: '/lic-surrender-value-calculator/',
    category: 'Surrender'
  },
  {
    title: '3-Way Surrender Analysis',
    description: 'Side-by-side financial comparison between Surrender, Paid-Up, and Continuing.',
    url: '/lic-surrender-analysis/',
    category: 'Decision'
  }
];
---

<CalculatorShell
  title={seoData.seoTitle}
  description={seoData.metaDescription}
  calculatorTitle={seoData.h1}
  calculatorSubtitle={seoData.subtitle}
  category={seoData.category}
  lastReviewedDate={seoData.lastReviewedDate}
  sources={seoData.sources}
  faqs={seoData.faqs}
  breadcrumbs={breadcrumbs}
>
  <div slot="inputs" class="bg-white rounded-2xl border border-slate-200/90 p-6 sm:p-7 shadow-card">
    <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-6">
      <h2 class="text-base font-bold text-slate-900">Policy & Premium Parameters</h2>
      <ResetButton />
    </div>

    <form class="space-y-5" id="paidUpForm">
      <div class="space-y-1.5">
        <label for="planTableNo" class="block text-xs font-semibold text-slate-700">LIC Plan Table</label>
        <select
          id="planTableNo"
          name="planTableNo"
          class="w-full h-11 px-3.5 text-xs font-medium text-slate-800 bg-white border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-accent-500"
        >
          <option value="914">Table 914 - New Endowment Plan</option>
          <option value="915">Table 915 - New Jeevan Anand</option>
          <option value="936">Table 936 - Jeevan Labh</option>
          <option value="945">Table 945 - Jeevan Umang</option>
        </select>
      </div>
      <CurrencyInput
        id="sumAssured"
        name="sumAssured"
        label="Basic Sum Assured"
        value={1000000}
        placeholder="e.g. 1000000"
        min={50000}
        required
      />
      <RangeInput
        id="policyTerm"
        name="policyTerm"
        label="Policy Term (Years)"
        value={20}
        min={5}
        max={40}
        unit="Years"
        required
      />
      <RangeInput
        id="premiumsPaidCount"
        name="premiumsPaidCount"
        label="Completed Years of Premium Paid"
        value={5}
        min={2}
        max={40}
        unit="Years"
        required
        helpText="Minimum 2 full years of premiums required for paid-up eligibility"
      />
      <div class="pt-2">
        <CalculateButton text="Calculate Paid-Up Value" />
      </div>
    </form>
  </div>

  <div slot="results">
    <ResultCard
      headline="Guaranteed Paid-Up Maturity Payout"
      amount="₹4,80,000"
      subtitle="Reduced Paid-Up Sum Assured: ₹2,50,000 + Vested Bonus: ₹2,30,000"
      stats={[
        { label: 'Original Sum Assured', value: '₹10,00,000' },
        { label: 'Reduced Paid-Up SA', value: '₹2,50,000' },
        { label: 'Vested Bonus', value: '₹2,30,000' },
        { label: 'Paid-Up Death Cover', value: '₹4,80,000' }
      ]}
    />
  </div>

  <div slot="breakdown">
    <ResultBreakdown
      title="Paid-Up Financial Structure"
      items={breakdownItems}
      totalLabel="Total Guaranteed Payout at Maturity"
      totalAmount="₹4,80,000"
      summaryNotes="Paid-up benefits are contractually locked and 100% tax-free under Section 10(10D)."
    />
  </div>

  <div slot="explanation">
    <CalculationExplanation
      howItWorks={seoData.howItWorks}
      inputsGuide={seoData.inputsGuide}
      resultsGuide={seoData.resultsGuide}
      assumptions={seoData.assumptionsAndLimitations}
    />
  </div>

  <div slot="related">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {relatedTools.map((tool) => (
        <RelatedCalculatorCard {...tool} />
      ))}
    </div>
  </div>
</CalculatorShell>
