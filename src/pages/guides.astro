---
import ContentLayout from '@/layouts/ContentLayout.astro';
import Card from '@/components/ui/Card.astro';

const breadcrumbs = [{ name: 'Guides', url: '/guides/' }];
---

<ContentLayout
  title="LIC Policy Guides & Educational Resources"
  description="Comprehensive guides on LIC policy management, surrender calculations, bonus mechanisms, and tax benefits."
  pageTitle="Policy Guides & Articles"
  pageSubtitle="Practical, unbiased explanations of insurance concepts and policy lifecycle management."
  breadcrumbs={breadcrumbs}
>
  <div class="space-y-6">
    <Card title="Guide: What Happens When You Surrender an LIC Policy?">
      <p class="text-sm text-slate-600 mb-3">
        Surrendering an insurance policy terminates life coverage and converts the policy into a cash payout. Learn how Guaranteed Surrender Value (GSV) and Special Surrender Value (SSV) are determined.
      </p>
      <a href="/lic-surrender-value-calculator/" class="text-xs font-semibold text-brand-700 hover:text-brand-800">
        Read Guide & Calculate Surrender &rarr;
      </a>
    </Card>

    <Card title="Guide: Paid-Up Policy vs Surrender — Which is Better?">
      <p class="text-sm text-slate-600 mb-3">
        If you are unable to pay further premiums, making your policy "Paid-Up" allows you to retain proportional death and maturity benefits without losing a massive chunk of your invested premiums.
      </p>
      <a href="/lic-surrender-loss-calculator/" class="text-xs font-semibold text-brand-700 hover:text-brand-800">
        Compare Paid-Up vs Surrender &rarr;
      </a>
    </Card>

    <Card title="Guide: How LIC Bonus Rates Work">
      <p class="text-sm text-slate-600 mb-3">
        Learn how Simple Reversionary Bonuses and Final Additional Bonuses (FAB) are declared annually by LIC and how they compound over a 20+ year term.
      </p>
      <a href="/lic-bonus-calculator/" class="text-xs font-semibold text-brand-700 hover:text-brand-800">
        Bonus Calculation Guide &rarr;
      </a>
    </Card>
  </div>
</ContentLayout>
