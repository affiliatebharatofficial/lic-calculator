---
import ContentLayout from '@/layouts/ContentLayout.astro';
import Card from '@/components/ui/Card.astro';

const breadcrumbs = [{ name: 'About Us', url: '/about' }];
---

<ContentLayout
  title="About Us | LIC Calculator Platform"
  description="Learn about our mission to provide transparent, fast, and accessible financial calculation tools for Indian policyholders."
  pageTitle="About LIC Calculator"
  pageSubtitle="Building transparent and independent financial tools for millions of Indian policyholders."
  breadcrumbs={breadcrumbs}
>
  <div class="space-y-6 text-sm text-slate-700 leading-relaxed">
    <p>
      <strong>lic-calculators.com</strong> was founded with a clear mission: to bring absolute transparency to life insurance calculations in India.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-6">
      <Card title="Our Mission">
        <p class="text-xs text-slate-600">
          To empower policyholders with instant, deterministic, and unbiased calculation tools so they understand the true value of their life insurance policies.
        </p>
      </Card>
      <Card title="Independent by Design">
        <p class="text-xs text-slate-600">
          We operate completely independently from insurance companies, ensuring unbiased calculations and honest surrender comparisons without hidden sales motives.
        </p>
      </Card>
    </div>

    <h2 class="text-lg font-bold text-slate-900">What Sets Us Apart</h2>
    <ul class="list-disc pl-5 space-y-2 text-slate-600">
      <li><strong>Surrender Value Transparency:</strong> We show you the exact financial consequences before you surrender a policy.</li>
      <li><strong>Deterministic Engine:</strong> Calculations are strictly formulaic and verifiable, not generated by speculative AI.</li>
      <li><strong>Multilingual Accessibility:</strong> Tools built to support major Indian languages so everyone can make informed financial decisions.</li>
    </ul>
  </div>
</ContentLayout>
