---
import CalculatorShell from '@/components/calculator/CalculatorShell.astro';
import CurrencyInput from '@/components/calculator/CurrencyInput.astro';
import RangeInput from '@/components/calculator/RangeInput.astro';
import CalculateButton from '@/components/calculator/CalculateButton.astro';
import ResetButton from '@/components/calculator/ResetButton.astro';
import ResultCard from '@/components/ui/ResultCard.astro';
import ResultBreakdown from '@/components/calculator/ResultBreakdown.astro';
import CalculationExplanation from '@/components/calculator/CalculationExplanation.astro';
import RelatedCalculatorCard from '@/components/calculator/RelatedCalculatorCard.astro';
import { CALCULATOR_SEO_DATA } from '@/lib/seo/calculator-content';

const seoData = CALCULATOR_SEO_DATA['lic-hlv-calculator'];

const breadcrumbs = [
  { name: 'Calculators', url: '/calculators/' },
  { name: 'Human Life Value (HLV) Calculator', url: '/lic-hlv-calculator/' }
];

const breakdownItems = [
  { id: '1', label: 'Family Income Replacement Need (25 Yrs to Age 60)', amount: '₹1,75,00,000', notes: 'Future earning power' },
  { id: '2', label: 'Outstanding Liabilities (Home & Auto Loans)', amount: '₹35,00,000', isCredit: false, notes: 'Debt clearance' },
  { id: '3', label: 'Less: Existing Life Cover & Liquid Savings', amount: '₹20,00,000', isCredit: false, notes: 'Current assets' }
];

const relatedTools = [
  {
    title: 'Term Insurance Calculator',
    description: 'Calculate affordable pure term insurance life cover premiums.',
    url: '/lic-term-insurance-calculator/',
    category: 'Protection'
  },
  {
    title: 'Death Benefit Calculator',
    description: 'Estimate nominee death claim proceeds.',
    url: '/lic-death-benefit-calculator/',
    category: 'Claims'
  }
];
---

<CalculatorShell
  title={seoData.seoTitle}
  description={seoData.metaDescription}
  calculatorTitle={seoData.h1}
  calculatorSubtitle={seoData.subtitle}
  category={seoData.category}
  lastReviewedDate={seoData.lastReviewedDate}
  sources={seoData.sources}
  faqs={seoData.faqs}
  breadcrumbs={breadcrumbs}
>
  <div slot="inputs" class="bg-white rounded-2xl border border-slate-200/90 p-6 sm:p-7 shadow-card">
    <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-6">
      <h2 class="text-base font-bold text-slate-900">Income & Liability Profile</h2>
      <ResetButton />
    </div>

    <form class="space-y-5" id="hlvForm">
      <RangeInput
        id="currentAge"
        name="currentAge"
        label="Current Age"
        value={35}
        min={18}
        max={65}
        unit="Years"
        required
      />
      <CurrencyInput
        id="annualIncome"
        name="annualIncome"
        label="Annual Net Take-Home Income"
        value={1000000}
        placeholder="e.g. 1000000"
        min={100000}
        required
        helpText="Net annual income contributed towards family expenses"
      />
      <CurrencyInput
        id="outstandingLiabilities"
        name="outstandingLiabilities"
        label="Outstanding Loans & Liabilities (Home / Car / Personal)"
        value={3500000}
        placeholder="e.g. 3500000"
        min={0}
      />
      <CurrencyInput
        id="existingLifeCover"
        name="existingLifeCover"
        label="Existing Life Insurance Cover & Liquid Savings"
        value={2000000}
        placeholder="e.g. 2000000"
        min={0}
      />
      <div class="pt-2">
        <CalculateButton text="Calculate Ideal Life Insurance Cover" />
      </div>
    </form>
  </div>

  <div slot="results">
    <ResultCard
      headline="Recommended Additional Life Cover (HLV)"
      amount="₹1.90 Crore"
      subtitle="Income Replacement Need: ₹1.75 Cr + Debt: ₹35L - Existing Assets: ₹20L"
      stats={[
        { label: 'Gross HLV Need', value: '₹2.10 Crore' },
        { label: 'Income Need', value: '₹1.75 Crore' },
        { label: 'Debt Clearance', value: '₹35,00,000' },
        { label: 'Existing Assets', value: '₹20,00,000' }
      ]}
    />
  </div>

  <div slot="breakdown">
    <ResultBreakdown
      title="Human Life Value Assessment Breakdown"
      items={breakdownItems}
      totalLabel="Net Insurance Protection Gap"
      totalAmount="₹1,90,00,000"
      summaryNotes="Recommended policy: LIC Tech Term (Table 854/855) for high cost-effective cover."
    />
  </div>

  <div slot="explanation">
    <CalculationExplanation
      howItWorks={seoData.howItWorks}
      inputsGuide={seoData.inputsGuide}
      resultsGuide={seoData.resultsGuide}
      assumptions={seoData.assumptionsAndLimitations}
    />
  </div>

  <div slot="related">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {relatedTools.map((tool) => (
        <RelatedCalculatorCard {...tool} />
      ))}
    </div>
  </div>
</CalculatorShell>
