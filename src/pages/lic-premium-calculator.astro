---
import CalculatorShell from '@/components/calculator/CalculatorShell.astro';
import PlanSelector from '@/components/calculator/PlanSelector.astro';
import SelectInput from '@/components/calculator/SelectInput.astro';
import CurrencyInput from '@/components/calculator/CurrencyInput.astro';
import RangeInput from '@/components/calculator/RangeInput.astro';
import CheckboxInput from '@/components/calculator/CheckboxInput.astro';
import CalculateButton from '@/components/calculator/CalculateButton.astro';
import ResetButton from '@/components/calculator/ResetButton.astro';
import ResultCard from '@/components/ui/ResultCard.astro';
import ResultBreakdown from '@/components/calculator/ResultBreakdown.astro';
import CalculationExplanation from '@/components/calculator/CalculationExplanation.astro';
import RelatedCalculatorCard from '@/components/calculator/RelatedCalculatorCard.astro';
import AIExplanationCard from '@/components/ai/AIExplanationCard.astro';
import { CALCULATOR_SEO_DATA } from '@/lib/seo/calculator-content';

const seoData = CALCULATOR_SEO_DATA['lic-premium-calculator'];

const breadcrumbs = [
  { name: 'Calculators', url: '/calculators/' },
  { name: 'Premium Calculator', url: '/lic-premium-calculator/' }
];

const frequencyOptions = [
  { label: 'Yearly (2% Mode Rebate)', value: 'yearly' },
  { label: 'Half-Yearly (1% Mode Rebate)', value: 'half-yearly' },
  { label: 'Quarterly', value: 'quarterly' },
  { label: 'Monthly (NACH / ECS)', value: 'monthly' }
];

const breakdownItems = [
  { id: '1', label: 'Basic Tabular Premium', amount: '₹24,850', notes: 'Per ₹1,000 Sum Assured for Age 30 & Term 20' },
  { id: '2', label: 'High Sum Assured Rebate (₹5L+)', amount: '₹750', isCredit: false, notes: '₹1.50 per ₹1,000 SA discount' },
  { id: '3', label: 'Payment Mode Rebate (Yearly 2%)', amount: '₹482', isCredit: false, notes: '2% discount on tabular premium' },
  { id: '4', label: 'GST (4.5% 1st Year / 2.25% Renewal)', amount: '₹1,063', isCredit: true, notes: 'Statutory GST' }
];

const relatedTools = [
  {
    title: 'Maturity Calculator',
    description: 'Calculate the total maturity return for this premium schedule.',
    url: '/lic-maturity-calculator/',
    category: 'Returns'
  },
  {
    title: 'Bonus Calculator',
    description: 'Project total bonus accumulation over your chosen term.',
    url: '/lic-bonus-calculator/',
    category: 'Bonus'
  },
  {
    title: 'Surrender Value Calculator',
    description: 'Check how much cash value builds up after 2+ policy years.',
    url: '/lic-surrender-value-calculator/',
    category: 'Surrender'
  }
];
---

<CalculatorShell
  title={seoData.seoTitle}
  description={seoData.metaDescription}
  calculatorTitle={seoData.h1}
  calculatorSubtitle={seoData.subtitle}
  category={seoData.category}
  lastReviewedDate={seoData.lastReviewedDate}
  sources={seoData.sources}
  faqs={seoData.faqs}
  breadcrumbs={breadcrumbs}
>
  <!-- Form Inputs Slot -->
  <div slot="inputs" class="bg-white rounded-2xl border border-slate-200/90 p-6 sm:p-7 shadow-card">
    <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-6">
      <h2 class="text-base font-bold text-slate-900">Policy Parameters</h2>
      <ResetButton />
    </div>

    <!-- Error Banner -->
    <div id="calc-error-banner" class="hidden mb-5 p-3.5 rounded-xl bg-rose-50 border border-rose-200/80 text-rose-700 text-xs font-semibold" role="alert"></div>

    <form id="lic-premium-form" class="space-y-5">
      <PlanSelector
        id="planTableNo"
        name="planTableNo"
        label="Select LIC Plan"
        defaultValue={914}
        required
      />

      <RangeInput
        id="age"
        name="age"
        label="Entry Age"
        min={8}
        max={55}
        step={1}
        value={30}
        unit="Years"
        required
      />

      <RangeInput
        id="policyTerm"
        name="policyTerm"
        label="Policy Term"
        min={12}
        max={35}
        step={1}
        value={20}
        unit="Years"
        required
      />

      <CurrencyInput
        id="sumAssured"
        name="sumAssured"
        label="Sum Assured (Life Cover)"
        min={100000}
        max={100000000}
        step={25000}
        value={500000}
        required
        helpText="Minimum ₹1,00,000 for standard endowment assurance."
      />

      <SelectInput
        id="premiumFrequency"
        name="premiumFrequency"
        label="Premium Payment Mode"
        options={frequencyOptions}
        value="yearly"
        required
      />

      <CheckboxInput
        id="includeAccidentalRider"
        name="includeAccidentalRider"
        label="Include Accidental Death & Disability Benefit Rider (ADDB)"
        description="Provides additional sum assured coverage (~₹1 per ₹1,00,000 SA)."
        checked={false}
      />

      <div class="pt-2">
        <CalculateButton text="Calculate Estimated Premium" />
      </div>
    </form>
  </div>

  <!-- Results Slot -->
  <div slot="results" id="calc-result-container">
    <div class="space-y-4">
      <ResultCard
        headline="Estimated 1st Year Premium"
        amount="₹24,681"
        subtitle="Including 4.5% 1st Year GST (Renewal approx. ₹24,150/yr @ 2.25% GST)"
        stats={[
          { label: 'Sum Assured', value: '₹5,00,000' },
          { label: 'Policy Term', value: '20 Years' },
          { label: 'Mode Rebate', value: '2% (Yearly)' },
          { label: 'High SA Rebate', value: '₹1.50 / th' }
        ]}
      />

      <div id="calc-rule-source-badge" class="text-xs text-slate-500 bg-slate-50 border border-slate-200/60 p-2.5 rounded-xl text-center">
        Rule Version: SYNTHETIC_2024.1 (Verified Rule Set Table 914)
      </div>

      <button
        type="button"
        id="explain-ai-btn"
        class="w-full py-2.5 px-4 bg-gradient-to-r from-brand-600 to-indigo-600 hover:from-brand-700 hover:to-indigo-700 text-white font-bold text-xs rounded-xl shadow-sm hover:shadow transition-all flex items-center justify-center gap-2 cursor-pointer"
      >
        <span>✨</span>
        <span>Explain this premium result with AI</span>
      </button>

      <AIExplanationCard calculatorId="lic-premium-calculator" />
    </div>
  </div>

  <!-- Bottom Slots -->
  <div slot="breakdown">
    <ResultBreakdown
      title="Estimated Premium Component Breakdown"
      subtitle="Itemized breakdown for ₹5,00,000 Sum Assured under Table 914"
      items={breakdownItems}
      totalLabel="Total 1st Year Premium Payable"
      totalAmount="₹24,681"
    />
  </div>

  <div slot="explanation">
    <CalculationExplanation
      title={seoData.howItWorks.title}
      steps={seoData.howItWorks.steps}
      notes={seoData.assumptionsAndLimitations.notes}
    />
  </div>

  <div slot="related">
    <RelatedCalculatorCard tools={relatedTools} />
  </div>
</CalculatorShell>

<div id="calc-live-announcer" class="sr-only" aria-live="polite"></div>

<script>
  import { initCalculatorForm } from '@/lib/client/calculator-client';

  document.addEventListener('DOMContentLoaded', () => {
    initCalculatorForm({
      formId: 'lic-premium-form',
      apiEndpoint: '/api/calculators/premium',
      calculatorId: 'lic-premium-calculator',
      calculatorName: 'LIC Premium Calculator'
    });
  });
</script>
