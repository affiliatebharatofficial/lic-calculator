---
import CalculatorShell from '@/components/calculator/CalculatorShell.astro';
import CurrencyInput from '@/components/calculator/CurrencyInput.astro';
import RangeInput from '@/components/calculator/RangeInput.astro';
import CalculateButton from '@/components/calculator/CalculateButton.astro';
import ResetButton from '@/components/calculator/ResetButton.astro';
import ResultCard from '@/components/ui/ResultCard.astro';
import ResultBreakdown from '@/components/calculator/ResultBreakdown.astro';
import CalculationExplanation from '@/components/calculator/CalculationExplanation.astro';
import RelatedCalculatorCard from '@/components/calculator/RelatedCalculatorCard.astro';
import { CALCULATOR_SEO_DATA } from '@/lib/seo/calculator-content';

const seoData = CALCULATOR_SEO_DATA['lic-late-fee-calculator'];

const breadcrumbs = [
  { name: 'Calculators', url: '/calculators' },
  { name: 'Late Fee & Policy Revival Calculator', url: '/lic-late-fee-calculator' }
];

const breakdownItems = [
  { id: '1', label: 'Unpaid Installment Premium', amount: '₹25,000', notes: 'Principal arrears' },
  { id: '2', label: 'Compounded Late Fee Interest (9.5% p.a. for 180 Days)', amount: '₹1,154', isCredit: false, notes: 'Penalty interest' },
  { id: '3', label: 'Statutory GST on Late Fee Interest (18%)', amount: '₹208', isCredit: false, notes: 'Tax on penalty' }
];

const relatedTools = [
  {
    title: 'Policy Loan Calculator',
    description: 'Check loan eligibility against policy surrender value.',
    url: '/lic-loan-calculator',
    category: 'Loan'
  },
  {
    title: 'Surrender Value Calculator',
    description: 'Check policy surrender cash value.',
    url: '/lic-surrender-value-calculator',
    category: 'Surrender'
  }
];
---

<CalculatorShell
  title={seoData.seoTitle}
  description={seoData.metaDescription}
  calculatorTitle={seoData.h1}
  calculatorSubtitle={seoData.subtitle}
  category={seoData.category}
  lastReviewedDate={seoData.lastReviewedDate}
  sources={seoData.sources}
  faqs={seoData.faqs}
  breadcrumbs={breadcrumbs}
>
  <div slot="inputs" class="bg-white rounded-2xl border border-slate-200/90 p-6 sm:p-7 shadow-card">
    <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-6">
      <h2 class="text-base font-bold text-slate-900">Overdue Premium & Duration</h2>
      <ResetButton />
    </div>

    <form class="space-y-5" id="lateFeeForm">
      <CurrencyInput
        id="unpaidPremiumAmount"
        name="unpaidPremiumAmount"
        label="Unpaid Installment Premium"
        value={25000}
        placeholder="e.g. 25000"
        min={100}
        required
      />
      <RangeInput
        id="overdueDays"
        name="overdueDays"
        label="Days Past Due Date"
        value={180}
        min={1}
        max={1825}
        unit="Days"
        required
        helpText="Policy can be revived within 5 years (1,825 days) from due date"
      />
      <div class="space-y-1.5">
        <label for="premiumFrequency" class="block text-xs font-semibold text-slate-700">Premium Frequency</label>
        <select
          id="premiumFrequency"
          name="premiumFrequency"
          class="w-full h-11 px-3.5 text-xs font-medium text-slate-800 bg-white border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-accent-500"
        >
          <option value="yearly">Yearly / Half-Yearly / Quarterly (30 Days Grace Period)</option>
          <option value="monthly">Monthly NACH (15 Days Grace Period)</option>
        </select>
      </div>
      <div class="pt-2">
        <CalculateButton text="Calculate Total Revival Arrears" />
      </div>
    </form>
  </div>

  <div slot="results">
    <ResultCard
      headline="Total Net Revival Arrears"
      amount="₹26,362"
      subtitle="Unpaid Premium: ₹25,000 + Late Fee (9.5% p.a.): ₹1,154 + GST: ₹208"
      stats={[
        { label: 'Unpaid Premium', value: '₹25,000' },
        { label: 'Late Fee Interest', value: '₹1,154' },
        { label: 'GST on Late Fee', value: '₹208' },
        { label: 'Grace Period', value: '30 Days Allowed' }
      ]}
    />
  </div>

  <div slot="breakdown">
    <ResultBreakdown
      title="Policy Revival Payment Breakdown"
      items={breakdownItems}
      totalLabel="Total Net Payment to Restore Full Cover"
      totalAmount="₹26,362"
      summaryNotes="Pay arrears online via LIC Customer Portal or at any authorized LIC cash counter."
    />
  </div>

  <div slot="explanation">
    <CalculationExplanation
      howItWorks={seoData.howItWorks}
      inputsGuide={seoData.inputsGuide}
      resultsGuide={seoData.resultsGuide}
      assumptions={seoData.assumptionsAndLimitations}
    />
  </div>

  <div slot="related">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {relatedTools.map((tool) => (
        <RelatedCalculatorCard {...tool} />
      ))}
    </div>
  </div>
</CalculatorShell>
