---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import Accordion from '@/components/ui/Accordion.astro';
import AccordionItem from '@/components/ui/AccordionItem.astro';
import CalculatorSearch from '@/components/search/CalculatorSearch.astro';
import CalculatorFinder from '@/components/search/CalculatorFinder.astro';
import AIChatPanel from '@/components/ai/AIChatPanel.astro';
import { t } from '@/lib/i18n';

const locale = 'en';

const popularPlans = [
  { tableNo: 914, name: 'New Endowment Plan', category: 'Endowment', minAge: 8, maxAge: 55, minTerm: 12, maxTerm: 35, slug: 'lic-premium-calculator?plan=914' },
  { tableNo: 915, name: 'New Jeevan Anand', category: 'Endowment + Whole Life', minAge: 18, maxAge: 50, minTerm: 15, maxTerm: 35, slug: 'lic-premium-calculator?plan=915' },
  { tableNo: 936, name: 'Jeevan Labh', category: 'Limited Premium', minAge: 8, maxAge: 59, minTerm: 16, maxTerm: 25, slug: 'lic-premium-calculator?plan=936' },
  { tableNo: 945, name: 'Jeevan Umang', category: 'Whole Life 8% Survival', minAge: 0, maxAge: 55, minTerm: 15, maxTerm: 30, slug: 'lic-premium-calculator?plan=945' },
  { tableNo: 855, name: 'Tech Term', category: 'Pure Term Cover', minAge: 18, maxAge: 65, minTerm: 10, maxTerm: 40, slug: 'lic-term-insurance-calculator' },
  { tableNo: 857, name: 'Saral Pension', category: 'Immediate Annuity', minAge: 40, maxAge: 80, minTerm: 1, maxTerm: 1, slug: 'lic-pension-calculator' }
];

const faqs = [
  {
    q: 'What is an LIC surrender value?',
    a: 'Surrender value is the payable cash amount an insurance policyholder receives if they choose to terminate their policy before the completion of the contractual term. It is calculated as the higher of Guaranteed Surrender Value (GSV) and Special Surrender Value (SSV).'
  },
  {
    q: 'Can I calculate my LIC maturity value online?',
    a: 'Yes. For participating (with-profit) endowment policies, maturity value is estimated as: Basic Sum Assured + Total Accrued Simple Reversionary Bonuses + Final Additional Bonus (FAB if eligible).'
  },
  {
    q: 'Is this an official LIC website or calculator?',
    a: 'No. lic-calculators.com is an independent informational and calculation portal developed for educational financial planning. We have no affiliation, partnership, or authorization from Life Insurance Corporation of India (LIC). For official policy services, visit licindia.in.'
  },
  {
    q: 'Are calculator results exact?',
    a: 'Our tools use publicly declared tabular rates, standard modal rebates, and published bonus rates. However, final official settlement amounts are subject to LIC’s official underwriting records and prevailing government taxes (GST).'
  },
  {
    q: 'What is the minimum period required to surrender an LIC policy?',
    a: 'For most traditional endowment and money-back plans, policyholders must have paid at least 2 full consecutive years of premiums to acquire any cash surrender value.'
  }
];
---

<BaseLayout
  title="LIC Calculators - Independent Premiums, Maturity, Bonus & Surrender Tools"
  description="Independent online calculators to estimate LIC policy premiums, maturity returns, bonus additions, surrender value, and surrender loss comparisons."
  jsonLdType="WebSite"
>
  <!-- ==================================================
       SECTION 1: HERO & INSTANT CALCULATOR SEARCH
       ================================================== -->
  <section class="relative bg-gradient-to-b from-accent-50/40 via-slate-50 to-white py-12 sm:py-16 md:py-20 border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-accent-100 text-amber-950 text-xs font-bold mb-6 border border-accent-300 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-accent-500 animate-pulse"></span>
        Fast • Transparent • 100% Free Financial Utilities
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-navy-800 tracking-tight max-w-4xl mx-auto leading-tight">
        LIC <span class="text-slate-900">Calculators</span><span class="text-accent-500">.</span>
      </h1>

      <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Calculate LIC premiums, maturity values, surrender values, bonuses and understand the true financial impact of your policies.
      </p>

      <!-- Interactive Live Search Bar in Hero -->
      <div class="mt-8 max-w-xl mx-auto">
        <CalculatorSearch variant="inline" placeholder="Search calculators (e.g. Surrender, Premium, Table 914)..." locale="en" />
      </div>

      <!-- Hero Call-to-Action Buttons -->
      <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-3.5">
        <Button variant="primary" size="lg" href="/calculators" class="w-full sm:w-auto shadow-sm">
          {t(locale, 'home.exploreCalculators')}
        </Button>
        <Button
          variant="secondary"
          size="lg"
          href="/lic-surrender-value-calculator"
          class="w-full sm:w-auto border-accent-300 text-navy-800 hover:bg-accent-50 font-bold"
        >
          <span class="w-2 h-2 rounded-full bg-accent-500 mr-2"></span>
          Surrender Value Calculator
        </Button>
      </div>

      <!-- Microcopy Trust / Disclaimer -->
      <div class="mt-8 pt-6 border-t border-slate-200/60 max-w-xl mx-auto flex items-center justify-center gap-2 text-xs text-slate-400">
        <svg class="h-4 w-4 text-slate-400 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd" />
        </svg>
        <span>
          Independent informational website • Not affiliated with Life Insurance Corporation of India (LIC)
        </span>
      </div>
    </div>
  </section>

  <!-- ==================================================
       SECTION 2: POPULAR CALCULATORS WITH VISUAL HIERARCHY
       ================================================== -->
  <section class="py-16 bg-slate-50/60 border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-amber-800">Explore Tools</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-800 tracking-tight mt-1">
            Popular LIC Policy Calculators
          </h2>
          <p class="text-sm text-slate-500 mt-1">
            Instant, transparent, and accurate tools to plan your policy lifecycle.
          </p>
        </div>
        <a href="/calculators" class="text-xs font-bold text-navy-800 hover:text-amber-700 mt-3 sm:mt-0 flex items-center gap-1">
          View All Calculators &rarr;
        </a>
      </div>

      <!-- Asymmetrical Hierarchy Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Highlighted / Primary Tool: Surrender Value & Loss -->
        <div class="lg:col-span-6 flex flex-col">
          <div class="h-full bg-gradient-to-br from-accent-50/50 via-amber-50/20 to-white rounded-2xl border-2 border-accent-300 p-6 sm:p-8 shadow-card flex flex-col justify-between hover:border-accent-400 transition-all group">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <Badge type="warning" class="bg-accent-100 text-amber-950 font-bold border-accent-300">
                  ★ Most Critical Tool
                </Badge>
                <span class="text-xs font-bold text-amber-900">
                  Surrender vs. Paid-Up
                </span>
              </div>

              <h3 class="text-xl sm:text-2xl font-extrabold text-navy-800 group-hover:text-amber-900 transition-colors">
                LIC Surrender Value & Loss Calculator
              </h3>

              <p class="text-sm text-slate-700 leading-relaxed">
                Thinking of closing your policy early? Understand what happens to your hard-earned money. Compare estimated cash surrender proceeds against paid-up benefits before you submit surrender papers.
              </p>

              <div class="grid grid-cols-2 gap-3 pt-2">
                <div class="p-3 bg-white rounded-xl border border-accent-200">
                  <span class="text-[10px] text-slate-500 block uppercase font-medium">Calculates</span>
                  <span class="text-xs font-bold text-navy-800">GSV vs. SSV Cash Value</span>
                </div>
                <div class="p-3 bg-white rounded-xl border border-accent-200">
                  <span class="text-[10px] text-slate-500 block uppercase font-medium">Evaluates</span>
                  <span class="text-xs font-bold text-rose-700">Financial Loss %</span>
                </div>
              </div>
            </div>

            <div class="mt-6 pt-5 border-t border-accent-200 flex items-center justify-between">
              <span class="text-xs font-bold text-amber-950 group-hover:underline">
                Calculate Surrender Proceeds & Loss
              </span>
              <a
                href="/lic-surrender-value-calculator"
                class="inline-flex items-center justify-center px-4 py-2 rounded-xl text-xs font-bold text-navy-800 bg-accent-500 hover:bg-accent-600 active:bg-accent-700 transition-colors shadow-sm border border-accent-600/30"
              >
                Launch Calculator &rarr;
              </a>
            </div>
          </div>
        </div>

        <!-- Secondary Calculators Grid (4 Tools) -->
        <div class="lg:col-span-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- 1. Premium -->
          <a href="/lic-premium-calculator" class="p-5 bg-white rounded-xl border border-slate-200/90 shadow-card hover:border-accent-400 hover:shadow-card-hover transition-all group flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Savings & Protection</span>
                <Badge type="default">Endowment</Badge>
              </div>
              <h4 class="text-sm font-bold text-navy-800 group-hover:text-amber-700 transition-colors">
                Premium Calculator
              </h4>
              <p class="text-xs text-slate-500 mt-1 line-clamp-2">
                Calculate annual, half-yearly & monthly premiums for Table 914, 915, 936, 945.
              </p>
            </div>
            <div class="mt-3 pt-3 border-t border-slate-100 text-xs font-bold text-navy-800 group-hover:text-amber-700 flex justify-between">
              <span>Calculate</span><span>&rarr;</span>
            </div>
          </a>

          <!-- 2. Maturity -->
          <a href="/lic-maturity-calculator" class="p-5 bg-white rounded-xl border border-slate-200/90 shadow-card hover:border-accent-400 hover:shadow-card-hover transition-all group flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Lump Sum Return</span>
                <Badge type="success">Returns</Badge>
              </div>
              <h4 class="text-sm font-bold text-navy-800 group-hover:text-amber-700 transition-colors">
                Maturity Calculator
              </h4>
              <p class="text-xs text-slate-500 mt-1 line-clamp-2">
                Estimate Sum Assured + Vested Bonus + Final Additional Bonus (FAB) at term end.
              </p>
            </div>
            <div class="mt-3 pt-3 border-t border-slate-100 text-xs font-bold text-navy-800 group-hover:text-amber-700 flex justify-between">
              <span>Calculate</span><span>&rarr;</span>
            </div>
          </a>

          <!-- 3. Policy Loan -->
          <a href="/lic-loan-calculator" class="p-5 bg-white rounded-xl border border-slate-200/90 shadow-card hover:border-accent-400 hover:shadow-card-hover transition-all group flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Liquidity Option</span>
                <Badge type="default">Loan</Badge>
              </div>
              <h4 class="text-sm font-bold text-navy-800 group-hover:text-amber-700 transition-colors">
                Policy Loan Calculator
              </h4>
              <p class="text-xs text-slate-500 mt-1 line-clamp-2">
                Borrow up to 90% of surrender value without surrendering life cover.
              </p>
            </div>
            <div class="mt-3 pt-3 border-t border-slate-100 text-xs font-bold text-navy-800 group-hover:text-amber-700 flex justify-between">
              <span>Calculate</span><span>&rarr;</span>
            </div>
          </a>

          <!-- 4. Bonus -->
          <a href="/lic-bonus-calculator" class="p-5 bg-white rounded-xl border border-slate-200/90 shadow-card hover:border-accent-400 hover:shadow-card-hover transition-all group flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Valuation Addition</span>
                <Badge type="default">Bonus</Badge>
              </div>
              <h4 class="text-sm font-bold text-navy-800 group-hover:text-amber-700 transition-colors">
                Bonus Calculator
              </h4>
              <p class="text-xs text-slate-500 mt-1 line-clamp-2">
                Project Simple Reversionary Bonus accumulation over 15–35 years.
              </p>
            </div>
            <div class="mt-3 pt-3 border-t border-slate-100 text-xs font-bold text-navy-800 group-hover:text-amber-700 flex justify-between">
              <span>Calculate</span><span>&rarr;</span>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================================================
       SECTION 3: CALCULATOR FINDER INTERACTIVE UI
       ================================================== -->
  <section class="py-16 bg-white border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <CalculatorFinder locale="en" />
    </div>
  </section>

  <!-- ==================================================
       SECTION 4: SURRENDER FEATURE SPOTLIGHT
       ================================================== -->
  <section class="py-16 bg-gradient-to-br from-accent-50/30 via-slate-50 to-white border-b border-accent-200/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-4">
          <Badge type="warning" class="bg-accent-100 text-amber-950 font-bold border-accent-300">Key Product Differentiator</Badge>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-navy-800 tracking-tight">
            Thinking about surrendering your LIC policy?
          </h2>
          <p class="text-sm sm:text-base text-slate-700 leading-relaxed">
            Many policyholders surrender policies without knowing that early surrender often results in a <strong>30% to 70% loss</strong> of total premiums paid. Our calculator helps you understand your exact numbers before taking action.
          </p>

          <div class="space-y-2.5 pt-2 text-xs sm:text-sm text-slate-800">
            <div class="flex items-start gap-2.5">
              <span class="text-emerald-600 font-bold">✓</span>
              <span><strong>Total Premium Paid:</strong> Itemized cumulative investment minus taxes and rider costs.</span>
            </div>
            <div class="flex items-start gap-2.5">
              <span class="text-emerald-600 font-bold">✓</span>
              <span><strong>GSV vs. SSV:</strong> Compares statutory guaranteed minimum vs. actuarial special surrender value.</span>
            </div>
            <div class="flex items-start gap-2.5">
              <span class="text-emerald-600 font-bold">✓</span>
              <span><strong>Estimated Difference:</strong> Exact monetary loss amount and loss percentage.</span>
            </div>
            <div class="flex items-start gap-2.5">
              <span class="text-emerald-600 font-bold">✓</span>
              <span><strong>Paid-Up vs. Surrender:</strong> Explores how making the policy Paid-Up saves your invested capital.</span>
            </div>
          </div>

          <div class="pt-4 flex flex-wrap items-center gap-3">
            <Button variant="primary" href="/lic-surrender-value-calculator">
              Calculate Surrender Value
            </Button>
            <Button variant="secondary" href="/lic-surrender-loss-calculator" class="border-slate-300 text-navy-800 hover:bg-slate-100">
              Analyze Surrender Loss
            </Button>
          </div>
        </div>

        <!-- Preview UI Box (Illustration Only) -->
        <div class="lg:col-span-5">
          <div class="rounded-2xl bg-navy-950 p-6 sm:p-7 text-white shadow-2xl border border-slate-800 space-y-4 relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1 bg-accent-500"></div>
            <div class="flex items-center justify-between border-b border-slate-800 pb-3">
              <span class="text-xs font-bold uppercase tracking-wider text-accent-400">
                Surrender Breakdown Preview
              </span>
              <span class="text-[10px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded border border-slate-700 font-medium">
                Example Illustration
              </span>
            </div>

            <div class="space-y-3 font-mono text-xs sm:text-sm">
              <div class="flex justify-between py-2 border-b border-slate-800/80">
                <span class="text-slate-400">Total Premiums Paid:</span>
                <span class="font-bold text-white">₹3,00,000</span>
              </div>
              <div class="flex justify-between py-2 border-b border-slate-800/80">
                <span class="text-slate-400">Est. Cash Payout (SSV):</span>
                <span class="font-bold text-emerald-400">₹1,65,000</span>
              </div>
              <div class="flex justify-between py-2 border-b border-slate-800/80">
                <span class="text-slate-400">Net Estimated Loss:</span>
                <span class="font-bold text-rose-400">-₹1,35,000 (45%)</span>
              </div>
              <div class="flex justify-between py-2 border-b border-slate-800/80">
                <span class="text-slate-400">Paid-Up Cover Available:</span>
                <span class="font-bold text-accent-300">₹2,50,000 Cover</span>
              </div>
            </div>

            <p class="text-[11px] text-slate-400 italic leading-snug pt-1">
              * Illustration for a 20-year endowment policy surrendered at Year 6. Real figures depend on verified circulars.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================================================
       SECTION 5: AI ASSISTANT PREVIEW UI
       ================================================== -->
  <section class="py-16 bg-slate-50/60 border-b border-slate-200/80" id="ai-assistant">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-6 space-y-4">
          <Badge type="info">Coming in Future Phase</Badge>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-navy-800 tracking-tight">
            Understand your policy with AI
          </h2>
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
            Get instant, plain-language explanations of your calculation results, understand complex policy circulars, and learn the exact trade-offs before making permanent decisions.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
            <div class="p-3.5 bg-white rounded-xl border border-slate-200 hover:border-accent-300 transition-colors">
              <h4 class="text-xs font-bold text-navy-800 mb-1">Explain Results</h4>
              <p class="text-[11px] text-slate-500">Breaks down why surrender value differs from premiums paid.</p>
            </div>
            <div class="p-3.5 bg-white rounded-xl border border-slate-200 hover:border-accent-300 transition-colors">
              <h4 class="text-xs font-bold text-navy-800 mb-1">Answer Policy Queries</h4>
              <p class="text-[11px] text-slate-500">Clarifies loan interest, grace periods, and bonus vesting rules.</p>
            </div>
            <div class="p-3.5 bg-white rounded-xl border border-slate-200 hover:border-accent-300 transition-colors">
              <h4 class="text-xs font-bold text-navy-800 mb-1">Input Identification</h4>
              <p class="text-[11px] text-slate-500">Guides you on locating Sum Assured and Table numbers on bond papers.</p>
            </div>
            <div class="p-3.5 bg-white rounded-xl border border-slate-200 hover:border-accent-300 transition-colors">
              <h4 class="text-xs font-bold text-navy-800 mb-1">Policy PDF Analysis</h4>
              <p class="text-[11px] text-slate-500">Future capability to parse policy document statements securely.</p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6">
          <AIChatPanel locale="en" />
        </div>
      </div>
    </div>
  </section>

  <!-- ==================================================
       SECTION 6: POPULAR LIC PLANS BROWSABLE CATALOG
       ================================================== -->
  <section class="py-16 bg-white border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-amber-800">Reference Catalog</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-800 tracking-tight mt-1">
            Popular LIC Plans & Table Numbers
          </h2>
          <p class="text-sm text-slate-500 mt-1">
            Browse major endowment, money back, whole life, and pension plans.
          </p>
        </div>
        <a href="/plans" class="text-xs font-bold text-navy-800 hover:text-amber-700 mt-3 sm:mt-0">
          View All Plans &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          popularPlans.map((plan) => (
            <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-card hover:border-accent-400 hover:shadow-card-hover transition-all flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="font-mono text-xs font-bold text-amber-950 bg-accent-50 px-2 py-0.5 rounded border border-accent-200">
                    Table {plan.tableNo}
                  </span>
                  <Badge type="default">{plan.category}</Badge>
                </div>
                <h3 class="text-base font-bold text-navy-800 mt-1">
                  {plan.name}
                </h3>
                <div class="mt-3 pt-3 border-t border-slate-100 space-y-1 text-xs text-slate-600">
                  <div class="flex justify-between">
                    <span class="text-slate-400">Entry Age:</span>
                    <span class="font-semibold text-slate-800">{plan.minAge} to {plan.maxAge} Yrs</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-slate-400">Policy Term:</span>
                    <span class="font-semibold text-slate-800">{plan.minTerm} to {plan.maxTerm} Yrs</span>
                  </div>
                </div>
              </div>

              <div class="mt-4 pt-3 border-t border-slate-100">
                <a
                  href={`/${plan.slug}`}
                  class="text-xs font-bold text-navy-800 hover:text-amber-700 flex items-center justify-between"
                >
                  <span>Open Premium Tool</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ==================================================
       SECTION 7: HOW IT WORKS (4-STEP FLOW)
       ================================================== -->
  <section class="py-16 bg-slate-50/60 border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-xs font-bold uppercase tracking-wider text-amber-800">Simple Process</span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-800 tracking-tight mt-1">
        How LIC Calculator Works
      </h2>
      <p class="text-sm text-slate-500 mt-2 max-w-xl mx-auto">
        Four quick steps to transparent, deterministic policy calculations.
      </p>

