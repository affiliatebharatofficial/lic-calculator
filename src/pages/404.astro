---
import BaseLayout from '@/layouts/BaseLayout.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Page Not Found (404)', url: '/404/' }
];

const topCalculators = [
  { name: 'LIC Premium Calculator', url: '/lic-premium-calculator/', desc: 'Calculate installment quotes with GST rebates' },
  { name: 'LIC Surrender Value Calculator', url: '/lic-surrender-value-calculator/', desc: 'Calculate GSV & SSV cash payout' },
  { name: 'LIC Surrender Analysis', url: '/lic-surrender-analysis/', desc: '3-way decision comparison tool' },
  { name: 'LIC Maturity Calculator', url: '/lic-maturity-calculator/', desc: 'Project maturity proceeds and bonuses' }
];
---

<BaseLayout
  title="Page Not Found (404) - LIC Calculator"
  description="The requested page could not be found. Explore our verified LIC policy calculators and educational guides."
  breadcrumbs={breadcrumbs}
  noIndex={true}
>
  <div class="max-w-3xl mx-auto py-16 px-4 sm:px-6 text-center space-y-8">
    <div class="space-y-3">
      <span class="px-3.5 py-1 rounded-full text-xs font-mono font-bold bg-rose-50 text-rose-700 border border-rose-200">
        HTTP 404 • Resource Missing
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
        Page Not Found
      </h1>
      <p class="text-sm text-slate-600 max-w-lg mx-auto">
        The link you followed may be outdated, mistyped, or moved. Explore our verified policy calculators below.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-left pt-4">
      {topCalculators.map((calc) => (
        <a
          href={calc.url}
          class="group p-5 rounded-2xl border border-slate-200 bg-white hover:bg-brand-50/40 hover:border-brand-300 transition-all shadow-card space-y-1 block"
        >
          <h3 class="font-bold text-slate-900 text-sm group-hover:text-brand-700 transition-colors">
            {calc.name} &rarr;
          </h3>
          <p class="text-xs text-slate-500">{calc.desc}</p>
        </a>
      ))}
    </div>

    <div class="pt-4">
      <a
        href="/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs transition-colors shadow-sm"
      >
        <span>&larr; Return to Homepage</span>
      </a>
    </div>
  </div>
</BaseLayout>
