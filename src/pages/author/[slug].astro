---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { VERIFIED_AUTHORS } from '@/lib/editorial';
import { StructuredDataGenerator } from '@/lib/seo';

export function getStaticPaths() {
  return VERIFIED_AUTHORS.map((author) => ({
    params: { slug: author.slug },
    props: { author }
  }));
}

const { author } = Astro.props;
const personSchema = StructuredDataGenerator.generatePerson(author);

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'About Us', url: '/about/' },
  { name: author.name, url: `/author/${author.slug}/` }
];

const authoredItems = [
  {
    title: 'LIC Surrender Value Calculator',
    url: '/lic-surrender-value-calculator/',
    type: 'Financial Tool',
    desc: 'Deterministic Guaranteed Surrender Value (GSV) and Special Surrender Value (SSV) calculation matrix.'
  },
  {
    title: '3-Way Surrender Analysis Tool',
    url: '/lic-surrender-analysis/',
    type: 'Decision Framework',
    desc: 'Comparative financial trade-offs between Surrendering for Cash, Paid-Up Policy, and Continuing.'
  },
  {
    title: 'LIC Maturity & Bonus Calculator',
    url: '/lic-maturity-calculator/',
    type: 'Financial Tool',
    desc: 'Estimate maturity proceeds based on declared simple reversionary and final additional bonus rates.'
  },
  {
    title: 'LIC Policy Loan Calculator',
    url: '/lic-loan-calculator/',
    type: 'Financial Tool',
    desc: 'Calculate eligible policy loan borrowing limits (up to 90% of surrender value) and interest costs.'
  }
];
---

<BaseLayout
  title={`${author.name} - ${author.title} | LIC Calculator`}
  description={author.biography}
  breadcrumbs={breadcrumbs}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <div class="max-w-4xl mx-auto py-12 px-4 sm:px-6 space-y-10">
    <!-- Profile Header Card -->
    <div class="bg-white rounded-3xl border border-slate-200/90 p-8 sm:p-10 shadow-card flex flex-col sm:flex-row gap-8 items-start">
      <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl bg-gradient-to-br from-navy-800 to-navy-950 border border-navy-700 flex items-center justify-center font-extrabold text-white text-3xl shrink-0 shadow-sm">
        {author.photoUrl ? (
          <img
            src={author.photoUrl}
            alt={`Photo of ${author.name}`}
            width="112"
            height="112"
            class="w-full h-full object-cover rounded-2xl"
            loading="lazy"
            onerror="this.style.display='none'; this.parentElement.innerText=this.getAttribute('data-initials');"
            data-initials={author.name.slice(0, 2).toUpperCase()}
          />
        ) : (
          <span>{author.name.slice(0, 2).toUpperCase()}</span>
        )}
      </div>

      <div class="space-y-3 flex-1">
        <div class="space-y-1">
          <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-navy-50 text-navy-800 border border-navy-200 uppercase tracking-wider">
            {author.role}
          </span>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">{author.name}</h1>
          <p class="text-sm font-semibold text-slate-600">{author.title}</p>
        </div>

        <p class="text-sm text-slate-700 leading-relaxed pt-1">{author.biography}</p>

        <!-- Social Profiles -->
        <div class="pt-3 flex flex-wrap gap-3">
          {author.socialLinks.linkedin && (
            <a
              href={author.socialLinks.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-50 hover:bg-navy-50 text-navy-900 border border-slate-200 hover:border-navy-300 text-xs font-bold transition-all shadow-xs"
            >
              <svg class="w-4 h-4 text-[#0A66C2]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
              <span>LinkedIn Profile ↗</span>
            </a>
          )}
          {author.socialLinks.instagram && (
            <a
              href={author.socialLinks.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-50 hover:bg-pink-50 text-slate-800 hover:text-pink-700 border border-slate-200 hover:border-pink-300 text-xs font-bold transition-all shadow-xs"
            >
              <svg class="w-4 h-4 text-[#E4405F]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              <span>Instagram Profile ↗</span>
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Platform Purpose & Principles -->
    <div class="bg-slate-50 rounded-2xl border border-slate-200/80 p-6 space-y-3">
      <h2 class="text-base font-bold text-slate-900">Platform Purpose & Principles</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-slate-700">
        <div class="p-3 bg-white rounded-xl border border-slate-200">
          <span class="font-bold text-navy-900 block mb-1">Independent & Unaffiliated</span>
          <span>Not affiliated with or endorsed by Life Insurance Corporation of India (LIC).</span>
        </div>
        <div class="p-3 bg-white rounded-xl border border-slate-200">
          <span class="font-bold text-navy-900 block mb-1">Transparent Calculations</span>
          <span>Built on deterministic formulas and publicly available policy circulars.</span>
        </div>
        <div class="p-3 bg-white rounded-xl border border-slate-200">
          <span class="font-bold text-navy-900 block mb-1">Zero Sales Bias</span>
          <span>We do not sell insurance policies, collect commissions, or promote intermediaries.</span>
        </div>
        <div class="p-3 bg-white rounded-xl border border-slate-200">
          <span class="font-bold text-navy-900 block mb-1">Multilingual Access</span>
          <span>Available across 7 major Indian languages for policyholders nationwide.</span>
        </div>
      </div>
    </div>

    <!-- Published Tools & Guides -->
    <div class="space-y-4">
      <div class="border-b border-slate-200 pb-3">
        <h2 class="text-xl font-bold text-slate-900">Published Tools & Calculators</h2>
        <p class="text-xs text-slate-500">Calculator tools developed and maintained on LIC-Calculators.com.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {authoredItems.map((item) => (
          <a
            href={item.url}
            class="group p-5 rounded-2xl border border-slate-200/90 bg-white hover:bg-navy-50/40 hover:border-navy-300 transition-all shadow-card block space-y-2"
          >
            <span class="text-[10px] font-bold uppercase text-navy-700 bg-navy-50 px-2 py-0.5 rounded border border-navy-200">
              {item.type}
            </span>
            <h3 class="text-sm font-bold text-slate-900 group-hover:text-navy-900 transition-colors">
              {item.title}
            </h3>
            <p class="text-xs text-slate-500 leading-relaxed">{item.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
