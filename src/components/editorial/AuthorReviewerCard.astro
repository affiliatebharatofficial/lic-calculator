---
import type { AuthorProfile } from '@/lib/editorial';
import { AuthorManager } from '@/lib/editorial';
import type { Locale } from '@/types/i18n';
import { getLocalizedPath, t } from '@/lib/i18n';

interface Props {
  author?: AuthorProfile;
  reviewer?: AuthorProfile;
  lastReviewedDate?: string;
  sources?: { title: string; publisher: string; reference: string }[];
  locale?: Locale;
  class?: string;
}

const {
  author = AuthorManager.getDefaultAuthor(),
  reviewer = AuthorManager.getDefaultReviewer(),
  lastReviewedDate = 'August 2026',
  sources = [
    {
      title: 'LIC New Endowment Plan 914 Official Policy Document',
      publisher: 'Life Insurance Corporation of India',
      reference: 'CO/ACT/2020/914'
    },
    {
      title: 'IRDAI Master Circular on Life Insurance Products',
      publisher: 'Insurance Regulatory and Development Authority of India',
      reference: 'IRDAI/ACT/CIR/2024'
    }
  ],
  locale = 'en',
  class: className = ''
} = Astro.props;

const authorSocials = AuthorManager.sanitizeSocialLinks(author.socialLinks || {});
const reviewerSocials = reviewer ? AuthorManager.sanitizeSocialLinks(reviewer.socialLinks || {}) : {};
---

<div class={`bg-slate-50 border border-slate-200/90 rounded-2xl p-5 sm:p-7 space-y-6 mt-10 shadow-card ${className}`}>
  <!-- Header / Title -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-200/80 pb-4 gap-2">
    <div class="flex items-center gap-2">
      <h3 class="text-sm font-bold text-slate-900 tracking-tight">
        {locale === 'en' ? 'Editorial Transparency & Author' : t(locale, 'editorial.aboutAuthor')}
      </h3>
      <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-navy-50 text-navy-800 border border-navy-200">
        Verified Publisher
      </span>
    </div>
    <span class="text-xs text-slate-500 font-medium">
      {locale === 'en' ? 'Last reviewed:' : `${t(locale, 'editorial.lastReviewed')}:`} {lastReviewedDate}
    </span>
  </div>

  <!-- Author Profile -->
  <div class="grid grid-cols-1 gap-6">
    <div class="flex flex-col sm:flex-row gap-4 items-start">
      <!-- Avatar with Fallback Initials -->
      <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-navy-800 to-navy-950 border border-navy-700 flex items-center justify-center font-extrabold text-white text-base shrink-0 overflow-hidden shadow-sm">
        {author.photoUrl ? (
          <img
            src={author.photoUrl}
            alt={`Photo of ${author.name}`}
            width="56"
            height="56"
            class="w-full h-full object-cover"
            loading="lazy"
            onerror="this.style.display='none'; this.parentElement.innerText=this.getAttribute('data-initials');"
            data-initials={author.name.slice(0, 2).toUpperCase()}
          />
        ) : (
          <span>{author.name.slice(0, 2).toUpperCase()}</span>
        )}
      </div>

      <div class="space-y-1.5 text-xs flex-1">
        <div class="flex items-center gap-2">
          <span class="text-[10px] font-bold tracking-wider text-amber-800 uppercase block">
            {locale === 'en' ? 'Written by' : t(locale, 'editorial.writtenBy')}
          </span>
        </div>
        
        <div>
          <a href={getLocalizedPath(`/author/${author.slug}/`, locale)} class="font-bold text-navy-900 text-base hover:text-amber-700 transition-colors inline-block">
            {author.name}
          </a>
          <span class="text-slate-600 block text-xs font-semibold">{author.role}</span>
        </div>
        
        <p class="text-slate-600 leading-relaxed text-xs pt-1">
          {author.biography}
        </p>
        
        <!-- Safe Social Links -->
        <div class="flex flex-wrap gap-2.5 pt-2">
          {authorSocials.linkedin && (
            <a
              href={authorSocials.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-xs font-bold text-navy-900 hover:text-amber-700 hover:border-amber-300 transition-all shadow-xs"
              aria-label={`${author.name} LinkedIn Profile`}
            >
              <svg class="w-3.5 h-3.5 text-[#0A66C2]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
              <span>LinkedIn</span>
            </a>
          )}
          {authorSocials.instagram && (
            <a
              href={authorSocials.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-xs font-bold text-slate-800 hover:text-pink-600 hover:border-pink-300 transition-all shadow-xs"
              aria-label={`${author.name} Instagram Profile`}
            >
              <svg class="w-3.5 h-3.5 text-[#E4405F]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              <span>Instagram</span>
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Reviewer Profile (Only rendered if genuine reviewer is provided) -->
    {reviewer && (
      <div class="flex flex-col sm:flex-row gap-4 items-start border-t border-slate-200/80 pt-4">
        <div class="w-12 h-12 rounded-xl bg-indigo-100 border border-indigo-200 flex items-center justify-center font-bold text-indigo-700 text-sm shrink-0 overflow-hidden shadow-xs">
          <span>{reviewer.name.slice(0, 2).toUpperCase()}</span>
        </div>
        <div class="space-y-1 text-xs flex-1">
          <span class="text-[10px] font-bold tracking-wider text-indigo-700 uppercase block">
            {locale === 'en' ? 'Reviewed by' : t(locale, 'editorial.reviewedBy')}
          </span>
          <span class="font-bold text-slate-900 text-sm block">{reviewer.name}</span>
          <span class="text-slate-600 block text-[11px] font-medium">{reviewer.title}</span>
          <p class="text-slate-500 leading-relaxed text-[11px] pt-1">{reviewer.biography}</p>
        </div>
      </div>
    )}
  </div>

  <!-- Sources Box -->
  {sources && sources.length > 0 && (
    <div class="bg-white rounded-xl border border-slate-200/80 p-4 space-y-2 relative overflow-hidden">
      <div class="absolute top-0 left-0 bottom-0 w-1 bg-amber-500"></div>
      <span class="text-[11px] font-bold text-slate-800 uppercase tracking-wider block pl-2">
        {locale === 'en' ? 'Primary Sources & Regulatory References' : t(locale, 'editorial.sourcesAndReferences')}
      </span>
      <ul class="space-y-1.5 text-xs text-slate-600 divide-y divide-slate-100 pl-2">
        {sources.map((src) => (
          <li class="pt-1.5 first:pt-0 flex flex-col sm:flex-row sm:items-center justify-between gap-1">
            <span class="font-medium text-slate-800">{src.title}</span>
            <span class="text-[10px] font-mono text-amber-950 bg-amber-100/70 border border-amber-200 px-2 py-0.5 rounded shrink-0">
              Ref: {src.reference} ({src.publisher})
            </span>
          </li>
        ))}
      </ul>
    </div>
  )}

  <!-- Correction Prompt & Independent Disclaimer -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-[11px] text-slate-500 pt-2 border-t border-slate-200/80">
    <span>
      Found an error or outdated rate? <a href={getLocalizedPath('/contact/correction/', locale)} class="text-navy-700 font-semibold hover:underline">Submit a correction report</a>.
    </span>
    <a href={getLocalizedPath('/editorial-policy/', locale)} class="text-slate-600 hover:text-slate-900 font-semibold underline">
      Read Editorial Policy &rarr;
    </a>
  </div>
</div>
