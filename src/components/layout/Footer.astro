---
import type { Locale } from '@/types/i18n';
import { t, getLocalizedPath } from '@/lib/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
---

<footer class="bg-slate-900 text-slate-400 mt-auto border-t border-slate-800 text-xs sm:text-sm">
  <!-- Independent Platform Notice Disclosure Box in Footer -->
  <div class="border-b border-slate-800/80 bg-slate-950/70 py-6 sm:py-7">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl bg-slate-900/90 border border-slate-800 p-4 sm:p-5 text-xs leading-relaxed space-y-2">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <span class="text-xs font-bold text-slate-200 tracking-wide">
            {locale === 'en' ? 'Independent Platform Notice' : t(locale, 'disclaimer.notice')}
          </span>
          <a
            href={getLocalizedPath('/disclaimer', locale)}
            class="text-xs font-semibold text-brand-400 hover:text-brand-300 transition-colors inline-flex items-center gap-1 group w-fit"
          >
            <span>{locale === 'en' ? 'Read Full Disclaimer' : t(locale, 'disclaimer.readFull')}</span>
            <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
          </a>
        </div>
        <p class="text-slate-400 text-xs sm:text-sm leading-relaxed">
          {locale === 'en' ? 'LIC Calculators is an independent informational and financial calculation platform. It is not affiliated with, authorized by, or endorsed by Life Insurance Corporation of India (LIC).' : t(locale, 'disclaimer.shortText')}
        </p>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      <!-- Col 1: Platform Info -->
      <div class="space-y-3">
        <div class="flex items-center gap-2 text-white font-bold text-base">
          <div class="w-7 h-7 rounded-lg bg-brand-600 text-white flex items-center justify-center font-bold text-sm shadow-sm">
            LC
          </div>
          LIC Calculator
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          {t(locale, 'footer.aboutText')}
        </p>
        <span class="inline-block bg-slate-800 text-slate-300 font-medium px-2.5 py-1 rounded-lg text-[11px] border border-slate-700/60">
          Independent Educational Platform
        </span>
      </div>

      <!-- Col 2: Calculators -->
      <div>
        <h4 class="text-xs font-semibold text-slate-200 uppercase tracking-wider mb-3">
          {t(locale, 'nav.calculators')}
        </h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href={getLocalizedPath('/lic-surrender-value-calculator', locale)} class="hover:text-white transition-colors">
              {t(locale, 'nav.surrenderCalculator')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/lic-premium-calculator', locale)} class="hover:text-white transition-colors">
              {t(locale, 'nav.premiumCalculator')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/lic-maturity-calculator', locale)} class="hover:text-white transition-colors">
              {t(locale, 'nav.maturityCalculator')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/lic-bonus-calculator', locale)} class="hover:text-white transition-colors">
              {t(locale, 'nav.bonusCalculator')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/lic-loan-calculator', locale)} class="hover:text-white transition-colors">
              {t(locale, 'nav.loanCalculator')}
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Resources & Guides -->
      <div>
        <h4 class="text-xs font-semibold text-slate-200 uppercase tracking-wider mb-3">
          {t(locale, 'footer.resources')}
        </h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href={getLocalizedPath('/plans', locale)} class="hover:text-white transition-colors">
              {t(locale, 'nav.plans')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/guides', locale)} class="hover:text-white transition-colors">
              {t(locale, 'nav.guides')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/faq', locale)} class="hover:text-white transition-colors">
              FAQs
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/glossary', locale)} class="hover:text-white transition-colors">
              Glossary of Terms
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Legal & Compliance -->
      <div>
        <h4 class="text-xs font-semibold text-slate-200 uppercase tracking-wider mb-3">
          {t(locale, 'footer.legalTitle')}
        </h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href={getLocalizedPath('/disclaimer', locale)} class="text-amber-400 hover:text-amber-300 font-medium transition-colors">
              {t(locale, 'footer.disclaimerPage')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/privacy-policy', locale)} class="hover:text-white transition-colors">
              {t(locale, 'footer.privacyPolicy')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/terms', locale)} class="hover:text-white transition-colors">
              {t(locale, 'footer.termsOfService')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/about', locale)} class="hover:text-white transition-colors">
              {t(locale, 'footer.aboutUs')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/contact', locale)} class="hover:text-white transition-colors">
              {t(locale, 'footer.contactUs')}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Copyright Sub-footer -->
    <div class="border-t border-slate-800 pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-3">
      <div>
        © {new Date().getFullYear()} lic-calculators.com. {t(locale, 'footer.copyright')}
      </div>
      <div>
        Independent Educational Platform • Not affiliated with LIC of India
      </div>
    </div>
  </div>
</footer>
