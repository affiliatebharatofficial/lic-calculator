---
import type { Locale } from '@/types/i18n';
import { t, getLocalizedPath } from '@/lib/i18n';
import LanguageSelector from './LanguageSelector.astro';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
---

<!-- Mobile Drawer Backdrop & Menu Container (Fixed over entire screen, high z-index) -->
<div
  id="mobile-menu-drawer"
  class="fixed inset-0 z-[100] bg-slate-900/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
  aria-hidden="true"
>
  <div
    id="mobile-drawer-panel"
    class="fixed inset-y-0 right-0 w-full max-w-[340px] sm:max-w-sm h-full max-h-[100dvh] bg-white shadow-2xl flex flex-col justify-between transform translate-x-full transition-transform duration-300 ease-out border-l border-slate-200"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile Navigation"
  >
    <!-- Drawer Header -->
    <div class="px-5 py-4 border-b border-slate-200 flex items-center justify-between bg-slate-50/90 shrink-0">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-xl bg-navy-800 text-white flex items-center justify-center font-bold text-sm shadow-sm border border-navy-700 relative overflow-hidden shrink-0">
          <span class="tracking-tighter font-mono font-extrabold text-accent-400">LC</span>
          <div class="absolute bottom-0 right-0 w-1.5 h-1.5 bg-accent-500 rounded-tl-sm"></div>
        </div>
        <div class="flex flex-col">
          <span class="font-extrabold text-navy-800 text-sm">
            LIC <span class="text-slate-900">Calculators</span>
          </span>
          <span class="text-[9px] text-slate-500 font-medium">
            Independent Tools
          </span>
        </div>
      </div>

      <button
        type="button"
        id="mobile-menu-close-btn"
        class="min-w-[44px] min-h-[44px] p-2 rounded-xl text-slate-500 hover:text-navy-900 hover:bg-slate-200/70 active:bg-slate-300/70 transition-colors flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-accent-500"
        aria-label="Close navigation menu"
      >
        <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Drawer Navigation Content (Scrollable) -->
    <div class="flex-1 overflow-y-auto overscroll-contain px-5 py-4 space-y-6">
      <!-- Search Trigger in Mobile Drawer -->
      <div>
        <button
          type="button"
          data-search-modal-trigger
          class="w-full min-h-[44px] flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-xs font-medium text-slate-600 hover:bg-slate-100 active:bg-slate-200 transition-colors focus:outline-none focus:ring-2 focus:ring-accent-500"
        >
          <svg class="h-4 w-4 text-slate-400 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
          </svg>
          <span>Search calculators & plans...</span>
        </button>
      </div>

      <!-- Core Financial Calculators -->
      <div>
        <h4 class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2.5">
          {t(locale, 'nav.calculators')}
        </h4>
        <nav class="space-y-1 text-sm font-medium">
          <a
            href={getLocalizedPath('/lic-surrender-value-calculator/', locale)}
            class="flex items-center justify-between min-h-[44px] px-3.5 py-2.5 rounded-xl text-amber-950 bg-accent-50 hover:bg-accent-100 font-semibold transition-colors border border-accent-200/80"
          >
            <span>{t(locale, 'nav.surrenderCalculator')}</span>
            <span class="text-[10px] bg-accent-400 text-navy-900 font-bold px-2 py-0.5 rounded-full">Core</span>
          </a>
          <a
            href={getLocalizedPath('/lic-surrender-analysis/', locale)}
            class="flex items-center justify-between min-h-[44px] px-3.5 py-2.5 rounded-xl text-navy-900 bg-slate-100 hover:bg-slate-200 font-semibold transition-colors"
          >
            <span>{t(locale, 'nav.surrenderAnalysis')}</span>
            <span class="text-[10px] bg-slate-200 text-slate-800 font-bold px-2 py-0.5 rounded-full">3-Way</span>
          </a>
          <a
            href={getLocalizedPath('/lic-surrender-loss-calculator/', locale)}
            class="block min-h-[44px] px-3.5 py-2.5 rounded-xl text-slate-700 hover:bg-slate-100 transition-colors"
          >
            {t(locale, 'nav.surrenderLoss')}
          </a>
          <a
            href={getLocalizedPath('/lic-premium-calculator/', locale)}
            class="block min-h-[44px] px-3.5 py-2.5 rounded-xl text-slate-700 hover:bg-slate-100 transition-colors"
          >
            {t(locale, 'nav.premiumCalculator')}
          </a>
          <a
            href={getLocalizedPath('/lic-maturity-calculator/', locale)}
            class="block min-h-[44px] px-3.5 py-2.5 rounded-xl text-slate-700 hover:bg-slate-100 transition-colors"
          >
            {t(locale, 'nav.maturityCalculator')}
          </a>
          <a
            href={getLocalizedPath('/lic-paid-up-calculator/', locale)}
            class="block min-h-[44px] px-3.5 py-2.5 rounded-xl text-slate-700 hover:bg-slate-100 transition-colors"
          >
            {t(locale, 'nav.paidUpCalculator')}
          </a>
          <a
            href={getLocalizedPath('/lic-return-calculator/', locale)}
            class="block min-h-[44px] px-3.5 py-2.5 rounded-xl text-slate-700 hover:bg-slate-100 transition-colors"
          >
            {t(locale, 'nav.returnRoiCalculator')}
          </a>
          <a
            href={getLocalizedPath('/lic-bonus-calculator/', locale)}
            class="block min-h-[44px] px-3.5 py-2.5 rounded-xl text-slate-700 hover:bg-slate-100 transition-colors"
          >
            {t(locale, 'nav.bonusCalculator')}
          </a>
          <a
            href={getLocalizedPath('/lic-loan-calculator/', locale)}
            class="block min-h-[44px] px-3.5 py-2.5 rounded-xl text-slate-700 hover:bg-slate-100 transition-colors"
          >
            {t(locale, 'nav.loanCalculator')}
          </a>
          <a
            href={getLocalizedPath('/lic-late-fee-calculator/', locale)}
            class="block min-h-[44px] px-3.5 py-2.5 rounded-xl text-slate-700 hover:bg-slate-100 transition-colors"
          >
            {t(locale, 'nav.lateFeeCalculator')}
          </a>
          <a
            href={getLocalizedPath('/lic-hlv-calculator/', locale)}
            class="block min-h-[44px] px-3.5 py-2.5 rounded-xl text-slate-700 hover:bg-slate-100 transition-colors"
          >
            {t(locale, 'nav.hlvCalculator')}
          </a>
          <a
            href={getLocalizedPath('/calculators/', locale)}
            class="block min-h-[44px] px-3.5 py-2.5 rounded-xl text-navy-900 font-bold bg-amber-50/60 hover:bg-amber-100/80 transition-colors text-center border border-amber-200"
          >
            {t(locale, 'home.exploreCalculators')} &rarr;
          </a>
        </nav>
      </div>

      <!-- Resources & Plans -->
      <div>
        <h4 class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2.5">
          {t(locale, 'nav.guides')}
        </h4>
        <nav class="space-y-1 text-sm font-medium">
          <a href={getLocalizedPath('/plans/', locale)} class="block min-h-[44px] px-3.5 py-2.5 rounded-xl text-slate-700 hover:bg-slate-100 transition-colors">
            {t(locale, 'nav.plans')}
          </a>
          <a href={getLocalizedPath('/guides/', locale)} class="block min-h-[44px] px-3.5 py-2.5 rounded-xl text-slate-700 hover:bg-slate-100 transition-colors">
            {t(locale, 'nav.guides')}
          </a>
          <a href={getLocalizedPath('/faq/', locale)} class="block min-h-[44px] px-3.5 py-2.5 rounded-xl text-slate-700 hover:bg-slate-100 transition-colors">
            FAQs
          </a>
          <a href={getLocalizedPath('/glossary/', locale)} class="block min-h-[44px] px-3.5 py-2.5 rounded-xl text-slate-700 hover:bg-slate-100 transition-colors">
            Insurance Glossary
          </a>
        </nav>
      </div>

      <!-- Language Selector -->
      <div>
        <h4 class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2.5">
          Language / भाषा
        </h4>
        <LanguageSelector currentLocale={locale} />
      </div>
    </div>

    <!-- Drawer Footer -->
    <div class="p-4 border-t border-slate-200 bg-slate-50 text-xs text-slate-500 space-y-2 shrink-0">
      <div class="flex items-center justify-around text-xs font-medium">
        <a href={getLocalizedPath('/about/', locale)} class="hover:underline p-1.5">{t(locale, 'footer.aboutTitle')}</a>
        <span class="text-slate-300">•</span>
        <a href={getLocalizedPath('/contact/', locale)} class="hover:underline p-1.5">Contact</a>
        <span class="text-slate-300">•</span>
        <a href={getLocalizedPath('/disclaimer/', locale)} class="text-amber-900 font-semibold hover:underline p-1.5">{t(locale, 'footer.disclaimerPage')}</a>
      </div>
      <p class="text-[10px] text-slate-400 text-center leading-tight">
        Independent educational tools • Not affiliated with LIC of India
      </p>
    </div>
  </div>
</div>

<script is:inline>
  function initMobileMenu() {
    const drawer = document.getElementById('mobile-menu-drawer');
    const panel = document.getElementById('mobile-drawer-panel');
    const openBtn = document.getElementById('mobile-menu-open-btn');
    const closeBtn = document.getElementById('mobile-menu-close-btn');

    if (!drawer || !panel || !openBtn) return;

    function openDrawer() {
      drawer.classList.remove('opacity-0', 'pointer-events-none');
      panel.classList.remove('translate-x-full');
      drawer.setAttribute('aria-hidden', 'false');
      openBtn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      drawer.classList.add('opacity-0', 'pointer-events-none');
      panel.classList.add('translate-x-full');
      drawer.setAttribute('aria-hidden', 'true');
      openBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    // Avoid duplicate event listeners
    openBtn.onclick = openDrawer;
    if (closeBtn) closeBtn.onclick = closeDrawer;

    drawer.onclick = (e) => {
      if (e.target === drawer) closeDrawer();
    };

    // Close when clicking any navigation link inside the drawer
    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        closeDrawer();
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer && !drawer.classList.contains('pointer-events-none')) {
        closeDrawer();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileMenu);
  } else {
    initMobileMenu();
  }
  document.addEventListener('astro:page-load', initMobileMenu);
</script>
