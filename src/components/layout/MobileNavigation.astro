---
import type { Locale } from '@/types/i18n';
import { getLocalizedPath } from '@/lib/i18n';
import LanguageSelector from './LanguageSelector.astro';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
---

<!-- Mobile Drawer Backdrop & Menu -->
<div
  id="mobile-menu-drawer"
  class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
  aria-hidden="true"
>
  <div
    id="mobile-drawer-panel"
    class="fixed inset-y-0 right-0 w-full max-w-xs sm:max-w-sm bg-white shadow-2xl flex flex-col justify-between transform translate-x-full transition-transform duration-300 ease-out border-l border-slate-200"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile Navigation"
  >
    <!-- Drawer Header with safe-area padding -->
    <div class="px-5 py-4 border-b border-slate-200 flex items-center justify-between bg-slate-50/50">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-brand-700 text-white flex items-center justify-center font-bold text-sm shadow-sm">
          LC
        </div>
        <span class="font-bold text-slate-900 text-sm">
          LIC <span class="text-brand-600">Calculator</span>
        </span>
      </div>

      <button
        type="button"
        id="mobile-menu-close-btn"
        class="min-w-[44px] min-h-[44px] p-2.5 rounded-xl text-slate-400 hover:text-slate-700 hover:bg-slate-100 active:bg-slate-200 transition-colors flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-brand-500"
        aria-label="Close navigation menu"
      >
        <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Drawer Navigation Content -->
    <div class="flex-1 overflow-y-auto px-5 py-4 space-y-6">
      <!-- Search Trigger in Mobile Drawer -->
      <div>
        <button
          type="button"
          data-search-modal-trigger
          class="w-full min-h-[44px] flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-xs font-medium text-slate-600 hover:bg-slate-100 active:bg-slate-200 transition-colors focus:outline-none focus:ring-2 focus:ring-brand-500"
        >
          <svg class="h-4 w-4 text-slate-400 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
          </svg>
          <span>Search calculators & plans...</span>
        </button>
      </div>

      <!-- Core Calculators -->
      <div>
        <h4 class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">
          Core Calculators
        </h4>
        <nav class="space-y-1 text-sm font-medium">
          <a
            href={getLocalizedPath('/lic-surrender-value-calculator', locale)}
            class="flex items-center justify-between min-h-[44px] px-3.5 py-2.5 rounded-xl text-amber-900 bg-amber-50/90 hover:bg-amber-100 font-semibold transition-colors border border-amber-200/60"
          >
            <span>Surrender Value</span>
            <span class="text-[10px] bg-amber-200 text-amber-950 font-bold px-2 py-0.5 rounded-full">Core</span>
          </a>
          <a
            href={getLocalizedPath('/lic-surrender-analysis', locale)}
            class="flex items-center justify-between min-h-[44px] px-3.5 py-2.5 rounded-xl text-navy-900 bg-slate-100 hover:bg-slate-200 font-semibold transition-colors"
          >
            <span>3-Way Surrender Analysis</span>
            <span class="text-[10px] bg-brand-100 text-brand-800 font-bold px-2 py-0.5 rounded-full">Decision</span>
          </a>
          <a
            href={getLocalizedPath('/lic-surrender-loss-calculator', locale)}
            class="block min-h-[44px] px-3.5 py-2.5 rounded-xl text-slate-700 hover:bg-slate-100 transition-colors"
          >
            Surrender Loss & Difference
          </a>
          <a
            href={getLocalizedPath('/lic-premium-calculator', locale)}
            class="block min-h-[44px] px-3.5 py-2.5 rounded-xl text-slate-700 hover:bg-slate-100 transition-colors"
          >
            Premium Calculator
          </a>
          <a
            href={getLocalizedPath('/lic-maturity-calculator', locale)}
            class="block min-h-[44px] px-3.5 py-2.5 rounded-xl text-slate-700 hover:bg-slate-100 transition-colors"
          >
            Maturity Calculator
          </a>
          <a
            href={getLocalizedPath('/lic-bonus-calculator', locale)}
            class="block min-h-[44px] px-3.5 py-2.5 rounded-xl text-slate-700 hover:bg-slate-100 transition-colors"
          >
            Bonus Calculator
          </a>
          <a
            href={getLocalizedPath('/lic-loan-calculator', locale)}
            class="block min-h-[44px] px-3.5 py-2.5 rounded-xl text-slate-700 hover:bg-slate-100 transition-colors"
          >
            Policy Loan Calculator
          </a>
          <a
            href={getLocalizedPath('/calculators', locale)}
            class="block min-h-[44px] px-3.5 py-2.5 rounded-xl text-brand-700 font-bold hover:bg-brand-50 transition-colors"
          >
            View All Calculators &rarr;
          </a>
        </nav>
      </div>

      <!-- Resources -->
      <div>
        <h4 class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">
          Knowledge & Reference
        </h4>
        <nav class="space-y-1 text-sm font-medium">
          <a href={getLocalizedPath('/plans', locale)} class="block min-h-[44px] px-3.5 py-2.5 rounded-xl text-slate-700 hover:bg-slate-100 transition-colors">
            LIC Plans Catalog
          </a>
          <a href={getLocalizedPath('/guides', locale)} class="block min-h-[44px] px-3.5 py-2.5 rounded-xl text-slate-700 hover:bg-slate-100 transition-colors">
            Policy Guides & Rules
          </a>
          <a href={getLocalizedPath('/faq', locale)} class="block min-h-[44px] px-3.5 py-2.5 rounded-xl text-slate-700 hover:bg-slate-100 transition-colors">
            FAQs
          </a>
          <a href={getLocalizedPath('/glossary', locale)} class="block min-h-[44px] px-3.5 py-2.5 rounded-xl text-slate-700 hover:bg-slate-100 transition-colors">
            Insurance Glossary
          </a>
        </nav>
      </div>

      <!-- Language Selector -->
      <div>
        <h4 class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">
          Select Language
        </h4>
        <LanguageSelector currentLocale={locale} />
      </div>
    </div>

    <!-- Drawer Footer with safe-area spacing -->
    <div class="p-4 border-t border-slate-200 bg-slate-50 text-xs text-slate-500 space-y-2">
      <div class="flex items-center justify-between text-xs font-medium">
        <a href={getLocalizedPath('/about', locale)} class="hover:underline p-1">About</a>
        <a href={getLocalizedPath('/contact', locale)} class="hover:underline p-1">Contact</a>
        <a href={getLocalizedPath('/disclaimer', locale)} class="text-amber-800 font-semibold hover:underline p-1">Disclaimer</a>
      </div>
      <p class="text-[10px] text-slate-400 text-center leading-tight">
        Independent educational tools • Not affiliated with LIC of India
      </p>
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const drawer = document.getElementById('mobile-menu-drawer');
    const panel = document.getElementById('mobile-drawer-panel');
    const openBtn = document.getElementById('mobile-menu-open-btn');
    const closeBtn = document.getElementById('mobile-menu-close-btn');

    function openDrawer() {
      if (!drawer || !panel) return;
      drawer.classList.remove('opacity-0', 'pointer-events-none');
      panel.classList.remove('translate-x-full');
      drawer.setAttribute('aria-hidden', 'false');
      openBtn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      if (!drawer || !panel) return;
      drawer.classList.add('opacity-0', 'pointer-events-none');
      panel.classList.add('translate-x-full');
      drawer.setAttribute('aria-hidden', 'true');
      openBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    openBtn?.addEventListener('click', openDrawer);
    closeBtn?.addEventListener('click', closeDrawer);
    drawer?.addEventListener('click', (e) => {
      if (e.target === drawer) closeDrawer();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer && !drawer.classList.contains('pointer-events-none')) {
        closeDrawer();
      }
    });
  });
</script>
