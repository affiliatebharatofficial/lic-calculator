---
import type { Locale } from '@/types/i18n';
import { t, getLocalizedPath } from '@/lib/i18n';
import LanguageSelector from './LanguageSelector.astro';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const currentPath = Astro.url.pathname;
const isCalculatorsActive = currentPath.includes('/calculators');
const isSurrenderActive = currentPath.includes('/lic-surrender-value-calculator') || currentPath.includes('/lic-surrender-loss-calculator') || currentPath.includes('/lic-surrender-analysis');
const isPlansActive = currentPath.includes('/plans') || currentPath.includes('/lic-plans');
const isGuidesActive = currentPath.includes('/guides') || currentPath.includes('/faq') || currentPath.includes('/glossary');
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-slate-200/90 shadow-xs transition-all">
  <!-- Subtle Top Decorative Brand Accent Strip -->
  <div class="h-1 w-full bg-gradient-to-r from-accent-500 via-amber-400 to-accent-600"></div>

  <div class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14 sm:h-16">
      <!-- Logo / Distinct Brand Identity -->
      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <a
          href={getLocalizedPath('/', locale)}
          class="flex items-center gap-2.5 group focus:outline-none focus:ring-2 focus:ring-accent-500 rounded-xl p-1"
          aria-label="LIC Calculators Home"
        >
          <!-- Original Financial Calculator Brand Icon Tile -->
          <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-navy-800 text-white flex items-center justify-center font-bold text-sm sm:text-base shadow-sm border border-navy-700 group-hover:border-accent-500 transition-all shrink-0 relative overflow-hidden">
            <span class="tracking-tighter font-mono font-extrabold text-accent-400">LC</span>
            <div class="absolute bottom-0 right-0 w-2 h-2 bg-accent-500 rounded-tl-sm"></div>
          </div>

          <div class="flex flex-col">
            <span class="font-extrabold text-navy-800 text-sm sm:text-base leading-tight tracking-tight flex items-center gap-1">
              LIC <span class="text-slate-900 group-hover:text-amber-600 transition-colors">Calculators</span>
              <span class="w-1.5 h-1.5 rounded-full bg-accent-500"></span>
            </span>
            <span class="text-[9px] sm:text-[10px] text-slate-500 font-medium tracking-tight truncate max-w-[130px] sm:max-w-none">
              Independent Financial Tools
            </span>
          </div>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center space-x-5 text-sm font-medium text-slate-700" aria-label="Main Navigation">
        <a
          href={getLocalizedPath('/calculators/', locale)}
          class={`px-3 py-1.5 rounded-lg transition-colors ${
            isCalculatorsActive
              ? 'text-navy-900 font-bold bg-slate-100 border-b-2 border-accent-500'
              : 'hover:text-navy-900 hover:bg-slate-50'
          }`}
        >
          {t(locale, 'nav.calculators')}
        </a>

        <!-- Highlighted Surrender Value Tool Link -->
        <a
          href={getLocalizedPath('/lic-surrender-value-calculator/', locale)}
          class={`px-3 py-1.5 rounded-lg font-semibold transition-colors flex items-center gap-1.5 ${
            isSurrenderActive
              ? 'text-amber-950 bg-amber-100 border border-amber-300 font-bold'
              : 'text-amber-950 bg-accent-50 hover:bg-accent-100/80 border border-accent-200/80'
          }`}
        >
          <span class="w-2 h-2 rounded-full bg-accent-500 shrink-0"></span>
          {t(locale, 'nav.surrenderCalculator')}
        </a>

        <a
          href={getLocalizedPath('/plans/', locale)}
          class={`px-3 py-1.5 rounded-lg transition-colors ${
            isPlansActive
              ? 'text-navy-900 font-bold bg-slate-100 border-b-2 border-accent-500'
              : 'hover:text-navy-900 hover:bg-slate-50'
          }`}
        >
          {t(locale, 'nav.plans')}
        </a>

        <a
          href={getLocalizedPath('/guides/', locale)}
          class={`px-3 py-1.5 rounded-lg transition-colors ${
            isGuidesActive
              ? 'text-navy-900 font-bold bg-slate-100 border-b-2 border-accent-500'
              : 'hover:text-navy-900 hover:bg-slate-50'
          }`}
        >
          {t(locale, 'nav.guides')}
        </a>

        <a
          href="/#ai-assistant"
          class="inline-flex items-center gap-1.5 text-slate-600 hover:text-navy-900 px-2 py-1 rounded-lg hover:bg-slate-50 transition-colors"
        >
          <span>AI Assistant</span>
          <span class="bg-accent-100 text-amber-950 text-[10px] font-bold px-1.5 py-0.5 rounded border border-accent-300">Preview</span>
        </a>
      </nav>

      <!-- Right Desktop Actions & Mobile Menu Toggle -->
      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <!-- Language Selector -->
        <div class="hidden sm:block">
          <LanguageSelector currentLocale={locale} />
        </div>

        <!-- Primary Yellow-Accent CTA Button (High Contrast WCAG AAA compliant text #172033 on #F4C430) -->
        <a
          href={getLocalizedPath('/calculators/', locale)}
          class="hidden md:inline-flex items-center justify-center min-h-[40px] px-4 py-2 rounded-xl text-xs font-bold text-navy-800 bg-accent-500 hover:bg-accent-600 active:bg-accent-700 transition-all shadow-xs border border-accent-600/30 focus:outline-none focus:ring-2 focus:ring-accent-500"
        >
          {t(locale, 'home.exploreCalculators')}
        </a>

        <!-- Mobile Menu Hamburger Button (Accessible 44x44px touch target) -->
        <button
          type="button"
          id="mobile-menu-open-btn"
          class="lg:hidden min-w-[44px] min-h-[44px] p-2.5 rounded-xl text-slate-700 hover:text-navy-900 hover:bg-slate-100 active:bg-slate-200 transition-colors flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-accent-500"
          aria-label="Open mobile navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu-drawer"
        >
          <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>
