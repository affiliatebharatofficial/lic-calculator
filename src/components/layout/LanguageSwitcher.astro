---
import type { Locale } from '@/types/i18n';
import { SUPPORTED_LOCALES, LOCALE_CODES, getLocalizedPath } from '@/lib/i18n';

interface Props {
  currentLocale?: Locale;
  class?: string;
  variant?: 'compact' | 'expanded';
}

const { currentLocale = 'en', class: className = '', variant = 'compact' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<div class={`language-switcher-root ${className}`} data-current-locale={currentLocale}>
  <div class="flex flex-wrap gap-1.5 items-center">
    {
      LOCALE_CODES.map((loc) => {
        const locInfo = SUPPORTED_LOCALES[loc];
        const targetUrl = getLocalizedPath(currentPath, loc);
        const isCurrent = loc === currentLocale;
        return (
          <a
            href={targetUrl}
            hreflang={loc}
            class={`px-2.5 py-1.5 rounded-lg text-xs font-semibold transition-all border ${
              isCurrent
                ? 'bg-accent-500 text-navy-950 font-bold border-accent-600 shadow-xs'
                : 'bg-white text-slate-700 hover:bg-slate-100 hover:text-slate-900 border-slate-200'
            }`}
            aria-current={isCurrent ? 'page' : undefined}
          >
            {locInfo.nativeName}
          </a>
        );
      })
    }
  </div>
</div>

