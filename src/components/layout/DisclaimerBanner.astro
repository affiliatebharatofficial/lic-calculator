---
import type { Locale } from '@/types/i18n';
import { t } from '@/lib/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
---

<div class="bg-amber-500/10 border-b border-amber-500/20 text-amber-950 px-4 py-2 text-xs font-medium">
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-3">
    <div class="flex items-center gap-2">
      <span class="inline-flex shrink-0 items-center justify-center w-4 h-4 rounded-full bg-amber-500/20 text-amber-800 text-[10px] font-bold">i</span>
      <span>
        <strong>{t(locale, 'disclaimer.notice')}:</strong> {t(locale, 'disclaimer.shortText')}
      </span>
    </div>
    <a
      href={locale === 'en' ? '/disclaimer' : `/${locale}/disclaimer`}
      class="underline hover:text-amber-800 shrink-0 hidden sm:inline"
    >
      Read Full Disclaimer
    </a>
  </div>
</div>
