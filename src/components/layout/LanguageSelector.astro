---
import type { Locale } from '@/types/i18n';
import { SUPPORTED_LOCALES, LOCALE_CODES, getLocalizedPath } from '@/lib/i18n';

interface Props {
  currentLocale?: Locale;
}

const { currentLocale = 'en' } = Astro.props;
const currentPath = Astro.url.pathname;
const activeLang = SUPPORTED_LOCALES[currentLocale] || SUPPORTED_LOCALES.en;
---

<div class="relative inline-block text-left group" id="lang-dropdown-wrapper">
  <!-- Trigger Button -->
  <button
    type="button"
    class="flex items-center gap-1.5 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-xl px-3 py-1.5 text-xs font-semibold border border-slate-300/80 shadow-xs transition-colors focus:outline-none focus:ring-2 focus:ring-accent-500"
    id="lang-menu-button"
    aria-expanded="false"
    aria-haspopup="true"
  >
    <svg class="h-3.5 w-3.5 text-slate-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
    </svg>
    <span>{activeLang.nativeName}</span>
    <svg class="h-3 w-3 text-slate-500 group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Dropdown Menu with Crawlable Anchor Links -->
  <div
    class="invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition-all duration-150 absolute right-0 mt-1.5 w-48 rounded-2xl bg-white shadow-xl border border-slate-200 py-1.5 z-50 focus:outline-none"
    role="menu"
    aria-orientation="vertical"
    aria-labelledby="lang-menu-button"
  >
    <div class="px-3 py-1 text-[10px] font-bold text-slate-400 uppercase tracking-wider border-b border-slate-100">
      Select Language / भाषा चुनें
    </div>
    {
      LOCALE_CODES.map((loc) => {
        const locInfo = SUPPORTED_LOCALES[loc];
        const targetUrl = getLocalizedPath(currentPath, loc);
        const isCurrent = loc === currentLocale;
        return (
          <a
            href={targetUrl}
            hreflang={loc}
            class={`flex items-center justify-between px-3 py-2 text-xs transition-colors ${
              isCurrent
                ? 'bg-amber-50 text-amber-950 font-bold'
                : 'text-slate-700 hover:bg-slate-50 hover:text-navy-900 font-medium'
            }`}
            role="menuitem"
          >
            <span>{locInfo.nativeName}</span>
            <span class={`text-[10px] px-1.5 py-0.5 rounded font-mono ${
              isCurrent ? 'bg-amber-200/80 text-amber-950 font-bold' : 'bg-slate-100 text-slate-500'
            }`}>
              {loc.toUpperCase()}
            </span>
          </a>
        );
      })
    }
  </div>
</div>

