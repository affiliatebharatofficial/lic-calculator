---
interface Props {
  text?: string;
  loadingText?: string;
  class?: string;
}

const { text = 'Calculate Estimate', class: className = '' } = Astro.props;
---

<button
  type="submit"
  class={`w-full inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl text-base font-extrabold text-navy-800 bg-accent-500 hover:bg-accent-600 active:bg-accent-700 shadow-sm border border-accent-600/30 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:ring-offset-2 transition-all select-none disabled:opacity-50 disabled:cursor-not-allowed ${className}`}
  data-calculate-button
>
  <svg class="h-5 w-5 text-navy-800 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
    <path fill-rule="evenodd" d="M6 2a2 2 0 00-2 2v12a2 2 0 002 2h8a2 2 0 002-2V4a2 2 0 00-2-2H6zm1 2a1 1 0 000 2h6a1 1 0 100-2H7zm6 7a1 1 0 011 1v3a1 1 0 11-2 0v-3a1 1 0 011-1zm-3 3a1 1 0 100 2h.01a1 1 0 100-2H10zm-4 1a1 1 0 011-1h.01a1 1 0 110 2H7a1 1 0 01-1-1zm1-4a1 1 0 100 2h.01a1 1 0 100-2H7zm2 1a1 1 0 011-1h.01a1 1 0 110 2H10a1 1 0 01-1-1zm4-4a1 1 0 100 2h.01a1 1 0 100-2H13zM9 9a1 1 0 011-1h.01a1 1 0 110 2H10a1 1 0 01-1-1zM7 8a1 1 0 100 2h.01a1 1 0 100-2H7z" clip-rule="evenodd" />
  </svg>
  <span>{text}</span>
</button>
