---
import { t, DEFAULT_LOCALE } from '@/lib/i18n';
import type { Locale } from '@/types/i18n';

interface Step {
  number: number;
  title: string;
  description: string;
  formulaSnippet?: string;
}

interface Props {
  title?: string;
  description?: string;
  steps: Step[];
  notes?: string[];
  notesTitle?: string;
  locale?: Locale;
  class?: string;
}

const {
  locale = DEFAULT_LOCALE,
  title,
  description,
  steps = [],
  notes = [],
  notesTitle,
  class: className = ''
} = Astro.props;

const displayTitle = title || t(locale, 'common.stepByStepTitle');
const displayDesc = description || t(locale, 'common.stepByStepDesc');
const displayNotesTitle = notesTitle || t(locale, 'common.importantNotes');
---

<div class={`bg-white rounded-2xl border border-slate-200/90 p-6 sm:p-7 shadow-card space-y-6 ${className}`}>
  <div>
    <h3 class="text-lg font-bold text-slate-900 tracking-tight">{displayTitle}</h3>
    {displayDesc && <p class="text-xs sm:text-sm text-slate-500 mt-1">{displayDesc}</p>}
  </div>

  <div class="space-y-4">
    {
      steps.map((step) => (
        <div class="flex items-start gap-3.5 p-4 rounded-xl bg-slate-50/70 border border-slate-200/60">
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-brand-700 text-white font-bold text-xs">
            {step.number}
          </span>
          <div class="space-y-1">
            <h4 class="text-xs sm:text-sm font-bold text-slate-900">{step.title}</h4>
            <p class="text-xs text-slate-600 leading-relaxed">{step.description}</p>
            {step.formulaSnippet && (
              <div class="font-mono text-[11px] text-brand-900 bg-brand-50/80 px-2.5 py-1 rounded border border-brand-200/50 mt-1.5 inline-block">
                {step.formulaSnippet}
              </div>
            )}
          </div>
        </div>
      ))
    }
  </div>

  {
    notes.length > 0 && (
      <div class="pt-4 border-t border-slate-100">
        <h5 class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
          {displayNotesTitle}
        </h5>
        <ul class="text-xs text-slate-500 space-y-1.5 list-disc pl-4">
          {notes.map((note) => (
            <li>{note}</li>
          ))}
        </ul>
      </div>
    )
  }
</div>
