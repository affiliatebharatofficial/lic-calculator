---
import CalculatorField from './CalculatorField.astro';

interface Option {
  label: string;
  value: string | number;
}

interface Props {
  id: string;
  name: string;
  label: string;
  options: Option[];
  value?: string | number;
  required?: boolean;
  helpText?: string;
  error?: string;
  class?: string;
}

const {
  id,
  name,
  label,
  options = [],
  value,
  required = false,
  helpText,
  error,
  class: className = ''
} = Astro.props;
---

<CalculatorField
  id={id}
  label={label}
  required={required}
  helpText={helpText}
  error={error}
  class={className}
>
  <div class="relative rounded-xl shadow-sm">
    <select
      id={id}
      name={name}
      required={required}
      class={`block w-full rounded-xl border bg-white py-3 pl-3.5 pr-10 text-sm font-semibold text-slate-900 shadow-sm focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-600 appearance-none transition-colors ${
        error ? 'border-rose-400 bg-rose-50/20' : 'border-slate-300'
      }`}
    >
      {
        options.map((opt) => (
          <option value={opt.value} selected={value !== undefined && String(value) === String(opt.value)}>
            {opt.label}
          </option>
        ))
      }
    </select>
    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3.5 text-slate-400">
      <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
      </svg>
    </div>
  </div>
</CalculatorField>
