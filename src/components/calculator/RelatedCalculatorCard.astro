---
interface RelatedTool {
  title: string;
  description: string;
  url: string;
  category: string;
}

interface Props {
  tools: RelatedTool[];
  class?: string;
}

const { tools = [], class: className = '' } = Astro.props;
---

<div class={`space-y-4 ${className}`}>
  <div class="flex items-center justify-between">
    <h3 class="text-base font-bold text-slate-900">Recommended Next Calculators</h3>
    <a href="/calculators/" class="text-xs font-semibold text-brand-700 hover:text-brand-800">
      All Tools &rarr;
    </a>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {
      tools.map((tool) => (
        <a
          href={tool.url}
          class="block p-5 rounded-xl bg-white border border-slate-200 hover:border-brand-300 hover:shadow-card-hover transition-all group"
        >
          <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">
            {tool.category}
          </span>
          <h4 class="text-sm font-bold text-slate-900 group-hover:text-brand-700 transition-colors mt-1">
            {tool.title}
          </h4>
          <p class="text-xs text-slate-500 mt-1.5 line-clamp-2">
            {tool.description}
          </p>
          <div class="mt-3 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-brand-700">
            <span>Calculate</span>
            <span>&rarr;</span>
          </div>
        </a>
      ))
    }
  </div>
</div>
