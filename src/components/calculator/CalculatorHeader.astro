---
import Badge from '@/components/ui/Badge.astro';

interface Props {
  title: string;
  subtitle: string;
  category?: string;
  lastUpdated?: string;
  class?: string;
}

const {
  title,
  subtitle,
  category = 'Financial Tool',
  lastUpdated = 'August 2026',
  class: className = ''
} = Astro.props;
---

<div class={`mb-8 border-b border-slate-200/80 pb-6 ${className}`}>
  <div class="flex flex-wrap items-center gap-2 mb-3">
    <Badge type="info">{category}</Badge>
    <Badge type="warning">Independent Platform</Badge>
    <span class="text-[11px] text-slate-400 font-medium">
      Updated: {lastUpdated}
    </span>
  </div>

  <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
    {title}
  </h1>

  <p class="text-sm sm:text-base text-slate-600 mt-2 max-w-3xl leading-relaxed">
    {subtitle}
  </p>
</div>
