---
import CalculatorField from './CalculatorField.astro';

interface Props {
  id: string;
  name: string;
  label: string;
  value?: number | string;
  placeholder?: string;
  min?: number;
  max?: number;
  step?: number;
  suffix?: string;
  required?: boolean;
  helpText?: string;
  error?: string;
  class?: string;
}

const {
  id,
  name,
  label,
  value = '',
  placeholder = '',
  min,
  max,
  step = 1,
  suffix,
  required = false,
  helpText,
  error,
  class: className = ''
} = Astro.props;
---

<CalculatorField
  id={id}
  label={label}
  required={required}
  helpText={helpText}
  error={error}
  class={className}
>
  <div class="relative rounded-xl shadow-sm">
    <input
      type="number"
      id={id}
      name={name}
      value={value}
      placeholder={placeholder}
      min={min}
      max={max}
      step={step}
      required={required}
      inputmode="numeric"
      class={`block w-full rounded-xl border bg-white py-3 pl-3.5 ${
        suffix ? 'pr-12' : 'pr-3.5'
      } text-base font-semibold font-mono text-slate-900 shadow-sm placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-600 transition-colors sm:text-sm ${
        error ? 'border-rose-400 bg-rose-50/20' : 'border-slate-300'
      }`}
    />
    {suffix && (
      <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3.5">
        <span class="text-xs font-semibold text-slate-500">{suffix}</span>
      </div>
    )}
  </div>
</CalculatorField>
