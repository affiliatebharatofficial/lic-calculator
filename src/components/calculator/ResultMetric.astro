---
interface Props {
  label: string;
  value: string | number;
  subtext?: string;
  badge?: string;
  badgeType?: 'default' | 'success' | 'warning' | 'danger' | 'info';
  isPositive?: boolean;
  isNegative?: boolean;
  class?: string;
}

const {
  label,
  value,
  subtext,
  badge,
  badgeType = 'default',
  isPositive,
  isNegative,
  class: className = ''
} = Astro.props;

const badgeStyles = {
  default: 'bg-slate-100 text-slate-700 border-slate-200',
  success: 'bg-emerald-50 text-emerald-700 border-emerald-200',
  warning: 'bg-amber-50 text-amber-800 border-amber-200',
  danger: 'bg-rose-50 text-rose-700 border-rose-200',
  info: 'bg-blue-50 text-blue-700 border-blue-200'
};
---

<div class={`p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 ${className}`}>
  <div class="flex items-center justify-between gap-2 mb-1">
    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">{label}</span>
    {badge && (
      <span class={`text-[10px] font-bold px-1.5 py-0.5 rounded border ${badgeStyles[badgeType]}`}>
        {badge}
      </span>
    )}
  </div>
  <div class={`text-base sm:text-xl font-bold font-mono tracking-tight break-words ${
    isPositive ? 'text-emerald-600' : isNegative ? 'text-rose-600' : 'text-slate-900'
  }`} style="overflow-wrap: anywhere;">
    {value}
  </div>
  {subtext && <p class="text-[11px] text-slate-400 mt-0.5 leading-snug">{subtext}</p>}
</div>
