---
import Button from './Button.astro';

interface Props {
  title?: string;
  message?: string;
  retryHref?: string;
  class?: string;
}

const {
  title = 'Something went wrong',
  message = 'An unexpected error occurred while processing your request.',
  retryHref,
  class: className = ''
} = Astro.props;
---

<div class={`rounded-xl border border-rose-200 bg-rose-50/40 p-6 text-center ${className}`}>
  <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-rose-100 text-rose-600 mb-3">
    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
    </svg>
  </div>
  <h3 class="text-base font-semibold text-rose-900">{title}</h3>
  <p class="mt-1 text-sm text-rose-700 max-w-md mx-auto">{message}</p>
  {
    retryHref && (
      <div class="mt-4">
        <Button variant="outline" size="sm" href={retryHref}>
          Try Again
        </Button>
      </div>
    )
  }
</div>
