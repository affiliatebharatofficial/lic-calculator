---
interface Props {
  title: string;
  open?: boolean;
  id?: string;
  class?: string;
}

const { title, open = false, id, class: className = '' } = Astro.props;
---

<details
  id={id}
  class={`group bg-white rounded-xl border border-slate-200/90 shadow-card transition-all overflow-hidden ${className}`}
  open={open}
>
  <summary class="flex items-center justify-between p-4 sm:p-5 text-left text-sm sm:text-base font-bold text-slate-900 cursor-pointer select-none hover:text-brand-700 focus:outline-none focus:bg-slate-50/80 transition-colors">
    <span>{title}</span>
    <span class="ml-4 shrink-0 text-slate-400 group-hover:text-brand-600 transition-transform duration-200 group-open:rotate-180">
      <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
      </svg>
    </span>
  </summary>
  <div class="px-4 pb-5 sm:px-5 sm:pb-5 text-xs sm:text-sm text-slate-600 leading-relaxed border-t border-slate-100 pt-3">
    <slot />
  </div>
</details>
