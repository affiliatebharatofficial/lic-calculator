---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'danger' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  href?: string;
  class?: string;
  disabled?: boolean;
  [key: string]: unknown;
}

const {
  variant = 'primary',
  size = 'md',
  type = 'button',
  href,
  class: className = '',
  disabled = false,
  ...rest
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-medium rounded-xl transition-colors focus-visible:outline focus-visible:outline-2 disabled:opacity-50 disabled:cursor-not-allowed select-none';

const sizeStyles = {
  sm: 'px-3.5 py-2 text-xs min-h-[38px]',
  md: 'px-4 py-2.5 text-sm min-h-[44px]',
  lg: 'px-6 py-3.5 text-base font-semibold min-h-[48px]'
};

const variantStyles = {
  primary: 'bg-brand-700 hover:bg-brand-800 text-white shadow-sm focus-visible:outline-brand-600 active:bg-brand-900',
  secondary: 'bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 shadow-sm focus-visible:outline-slate-400 active:bg-slate-100',
  outline: 'bg-transparent border border-brand-600 text-brand-700 hover:bg-brand-50 focus-visible:outline-brand-600',
  danger: 'bg-rose-600 hover:bg-rose-700 text-white shadow-sm focus-visible:outline-rose-600 active:bg-rose-800',
  ghost: 'bg-transparent hover:bg-slate-100 text-slate-700 focus-visible:outline-slate-400'
};

const classes = `${baseStyles} ${sizeStyles[size]} ${variantStyles[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} disabled={disabled} {...rest}>
      <slot />
    </button>
  )
}
