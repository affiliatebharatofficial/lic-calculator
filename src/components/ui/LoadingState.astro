---
interface Props {
  message?: string;
  class?: string;
}

const { message = 'Calculating...', class: className = '' } = Astro.props;
---

<div class={`flex flex-col items-center justify-center p-8 text-center ${className}`}>
  <div class="inline-block h-8 w-8 animate-spin rounded-full border-4 border-solid border-brand-600 border-r-transparent align-[-0.125em] motion-reduce:animate-[spin_1.5s_linear_infinite]">
    <span class="sr-only">Loading...</span>
  </div>
  <p class="mt-4 text-sm font-medium text-slate-600">{message}</p>
</div>
