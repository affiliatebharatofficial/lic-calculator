---
import Button from './Button.astro';

interface Props {
  title: string;
  description: string;
  actionText?: string;
  actionHref?: string;
  class?: string;
}

const { title, description, actionText, actionHref, class: className = '' } = Astro.props;
---

<div class={`rounded-xl border border-dashed border-slate-300 p-8 text-center bg-white ${className}`}>
  <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-500 mb-4">
    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
    </svg>
  </div>
  <h3 class="text-base font-semibold text-slate-900">{title}</h3>
  <p class="mt-1 text-sm text-slate-500 max-w-md mx-auto">{description}</p>
  {
    actionText && actionHref && (
      <div class="mt-5">
        <Button variant="secondary" size="sm" href={actionHref}>
          {actionText}
        </Button>
      </div>
    )
  }
</div>
