---
interface Props {
  text?: string;
  class?: string;
}

const { text = 'AI is analyzing policy rules...', class: className = '' } = Astro.props;
---

<div class={`flex items-center gap-3 p-3.5 rounded-xl bg-brand-50/60 border border-brand-100 ${className}`}>
  <div class="flex space-x-1">
    <div class="h-2 w-2 bg-brand-600 rounded-full animate-bounce [animation-delay:-0.3s]"></div>
    <div class="h-2 w-2 bg-brand-600 rounded-full animate-bounce [animation-delay:-0.15s]"></div>
    <div class="h-2 w-2 bg-brand-600 rounded-full animate-bounce"></div>
  </div>
  <span class="text-xs font-medium text-brand-800">{text}</span>
</div>
