---
interface Props {
  text?: string;
  context?: string;
  class?: string;
}

const { text = 'Ask AI to Explain This Result', class: className = '' } = Astro.props;
---

<button
  type="button"
  class={`inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold text-brand-900 bg-brand-50 hover:bg-brand-100 border border-brand-200 shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-brand-500 ${className}`}
  data-ask-ai-trigger
>
  <span class="flex h-4 w-4 items-center justify-center rounded bg-brand-700 text-white font-mono text-[9px] font-bold">
    AI
  </span>
  <span>{text}</span>
  <span class="text-[10px] text-brand-600 font-normal ml-1">(Phase 2 Preview)</span>
</button>
