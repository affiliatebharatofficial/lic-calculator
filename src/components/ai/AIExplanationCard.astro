---
interface Props {
  calculatorId: string;
  class?: string;
}

const { calculatorId, class: className = '' } = Astro.props;
---

<div
  id="ai-explanation-container"
  class={`hidden mt-6 bg-white rounded-2xl border border-brand-200/90 shadow-card p-5 sm:p-6 transition-all duration-300 ${className}`}
  data-calculator-id={calculatorId}
  aria-live="polite"
>
  <!-- Card Header -->
  <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-4">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-lg bg-brand-600 text-white flex items-center justify-center font-bold text-sm shadow-sm">
        ✨
      </div>
      <div>
        <h3 class="text-sm font-bold text-slate-900">AI Result Breakdown</h3>
        <p class="text-[11px] text-slate-500">Plain-language interpretation of your calculated values</p>
      </div>
    </div>
    <button
      type="button"
      id="close-ai-explanation"
      class="text-xs text-slate-400 hover:text-slate-600 p-1 rounded-lg hover:bg-slate-100 transition-colors"
      aria-label="Close AI explanation"
    >
      ✕
    </button>
  </div>

  <!-- Loading State Placeholder -->
  <div id="ai-explanation-loading" class="hidden py-8 flex flex-col items-center justify-center text-center space-y-3">
    <div class="w-7 h-7 border-2 border-brand-600 border-t-transparent rounded-full animate-spin"></div>
    <div class="text-xs font-semibold text-slate-700">Analyzing calculation breakdown...</div>
    <div class="text-[11px] text-slate-400 max-w-xs">Connecting to AI explanation engine with your verified numbers</div>
  </div>

  <!-- Error State Placeholder -->
  <div id="ai-explanation-error" class="hidden p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-xs">
    <span class="font-bold">Notice:</span> <span id="ai-error-message">AI explanation is temporarily unavailable.</span>
  </div>

  <!-- Dynamic Content Area -->
  <div id="ai-explanation-content" class="space-y-4"></div>
</div>
